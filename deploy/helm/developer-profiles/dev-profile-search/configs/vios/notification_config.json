{
  "message_broker": {
    "enable_notification": true,
    "enable_notification_consumer": true,
    "use_message_broker_consumer": "__USE_MESSAGE_BROKER_CONSUMER__",
    "message_broker_topic_consumer": "__MESSAGE_BROKER_TOPIC_CONSUMER__",
    "use_message_broker": "redis",
    "message_broker_payload_key": "sensor.id",
    "message_broker_topic": "vst.event",
    "message_broker_metadata_topic": "__MESSAGE_BROKER_METADATA_TOPIC__",
    "redis_server_env_var": "__REDIS_ADDRESS__",
    "kafka_server_address": "__KAFKA_ADDRESS__",
    "mqtt_broker_address": "__MQTT_BROKER_ADDRESS__"
  },
  "webhooks": {
    "enabled": true,
    "items": [
      {
        "enabled": true,
        "id": "rtvi-cv-camera-streaming",
        "camera_status_change": "camera_streaming",
        "request": [
          {
            "url": "http://__RTVI_CV_ADDRESS__/api/v1/stream/add",
            "method": "POST",
            "headers": {
              "Content-Type": "application/json",
              "x-stream-id": "{{event.camera_id}}"
            },
            "camera_type": ["file", "rtsp"],
            "timeout_ms": 60000,
            "retry": {
              "max_attempts": 3,
              "backoff_ms": [1000, 5000, 15000],
              "retry_on_status": [408, 429, 500, 502, 503, 504]
            }
          }
        ]
      },
      {
        "enabled": true,
        "id": "rtvi-embed-camera-streaming",
        "camera_status_change": "camera_streaming",
        "request": [
          {
            "url": "http://__RTVI_EMBED_ADDRESS__/v1/stream/add",
            "method": "POST",
            "headers": {
              "accept": "application/json",
              "Content-Type": "application/json",
              "x-stream-id": "{{event.camera_id}}"
            },
            "camera_type": ["file", "rtsp"],
            "timeout_ms": 600000,
            "retry": {
              "max_attempts": 3,
              "backoff_ms": [1000, 5000, 15000],
              "retry_on_status": [408, 429, 500, 502, 503, 504]
            },
            "user_defined_metadata": {
              "model": "cosmos-embed1-448p-anomaly-detection",
              "chunk_duration": 5
            }
          }
        ]
      },
      {
        "enabled": true,
        "id": "rtvi-vlm-tagging-camera-streaming",
        "camera_status_change": "camera_streaming",
        "request": [
          {
            "url": "http://__RTVI_VLM_ADDRESS__/v1/stream/add",
            "method": "POST",
            "headers": {
              "Content-Type": "application/json",
              "x-stream-id": "{{event.camera_id}}"
            },
            "query_params": {
              "change": "{{event.change}}"
            },
            "camera_type": ["rtsp", "file"],
            "timeout_ms": 5000,
            "retry": {
              "max_attempts": 3,
              "backoff_ms": [1000, 5000, 15000],
              "retry_on_status": [408, 429, 500, 502, 503, 504]
            },
            "user_defined_metadata": {
              "prompt": "Analyze only this video interval. Return JSON only with exactly two fields: \"tags\", an array of concise visible concepts, actions, objects, and events; and \"description\", one concise factual sentence. Do not infer facts that are not visible.",
              "response_format_type": "json_object",
              "temperature": 0,
              "chunk_duration": 5
            }
          }
        ]
      },
      {
        "enabled": true,
        "id": "rtvi-cv-camera-remove",
        "camera_status_change": "camera_remove",
        "request": [
          {
            "url": "http://__RTVI_CV_ADDRESS__/api/v1/stream/remove",
            "method": "POST",
            "headers": {
              "Content-Type": "application/json",
              "x-stream-id": "{{event.camera_id}}"
            },
            "camera_type": ["file", "rtsp"],
            "timeout_ms": 60000,
            "retry": {
              "max_attempts": 3,
              "backoff_ms": [1000, 5000, 15000],
              "retry_on_status": [408, 429, 500, 502, 503, 504]
            }
          }
        ]
      },
      {
        "enabled": true,
        "id": "rtvi-embed-camera-remove",
        "camera_status_change": "camera_remove",
        "request": [
          {
            "url": "http://__RTVI_EMBED_ADDRESS__/v1/stream/remove",
            "method": "POST",
            "headers": {
              "accept": "application/json",
              "Content-Type": "application/json",
              "x-stream-id": "{{event.camera_id}}"
            },
            "camera_type": ["file", "rtsp"],
            "timeout_ms": 600000,
            "retry": {
              "max_attempts": 3,
              "backoff_ms": [1000, 5000, 15000],
              "retry_on_status": [408, 429, 500, 502, 503, 504]
            }
          }
        ]
      },
      {
        "enabled": true,
        "id": "rtvi-vlm-tagging-camera-remove",
        "camera_status_change": "camera_remove",
        "request": [
          {
            "url": "http://__RTVI_VLM_ADDRESS__/v1/stream/remove",
            "method": "POST",
            "headers": {
              "accept": "application/json",
              "Content-Type": "application/json",
              "x-stream-id": "{{event.camera_id}}"
            },
            "camera_type": ["file", "rtsp"],
            "timeout_ms": 600000,
            "retry": {
              "max_attempts": 3,
              "backoff_ms": [1000, 5000, 15000],
              "retry_on_status": [408, 429, 500, 502, 503, 504]
            }
          }
        ]
      },
      {
        "enabled": true,
        "id": "es-raw-camera-remove",
        "camera_status_change": "camera_remove",
        "request": [
          {
            "url": "http://__ELASTICSEARCH_ADDRESS__/mdx-raw-2025-01-01/_delete_by_query",
            "method": "POST",
            "headers": {
              "Content-Type": "application/json"
            },
            "query_params": {
              "conflicts": "proceed",
              "refresh": "true"
            },
            "body": {
              "query": {
                "term": {
                  "sensorId.keyword": "{{event.camera_name}}"
                }
              }
            },
            "timeout_ms": 5000
          }
        ]
      },
      {
        "enabled": true,
        "id": "es-behavior-camera-remove",
        "camera_status_change": "camera_remove",
        "request": [
          {
            "url": "http://__ELASTICSEARCH_ADDRESS__/mdx-behavior-2025-01-01/_delete_by_query",
            "method": "POST",
            "headers": {
              "Content-Type": "application/json"
            },
            "query_params": {
              "conflicts": "proceed",
              "refresh": "true"
            },
            "body": {
              "query": {
                "term": {
                  "sensor.id.keyword": "{{event.camera_name}}"
                }
              }
            },
            "timeout_ms": 5000
          }
        ]
      },
      {
        "enabled": true,
        "id": "es-embed-filtered-camera-remove",
        "camera_status_change": "camera_remove",
        "request": [
          {
            "url": "http://__ELASTICSEARCH_ADDRESS__/mdx-embed-filtered-2025-01-01/_delete_by_query",
            "method": "POST",
            "headers": {
              "Content-Type": "application/json"
            },
            "query_params": {
              "conflicts": "proceed",
              "refresh": "true"
            },
            "body": {
              "query": {
                "term": {
                  "sensor.id.keyword": "{{event.camera_id}}"
                }
              }
            },
            "timeout_ms": 5000
          }
        ]
      }
    ]
  }
}
