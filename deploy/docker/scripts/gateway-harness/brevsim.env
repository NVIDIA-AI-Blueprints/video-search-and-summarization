# A synthetic external-TLS-terminator origin, for reproducing the two-origin
# split (public HTTPS vs internal HTTP) on a box that has no real terminator in
# front of it. Layer it over the gateway alone:
#
#   ./recreate.sh brevsim.env vss-haproxy-ingress
#   ./recreate.sh - vss-haproxy-ingress    # put the real origin back
#
# The hostname is deliberately unresolvable. gateway-brev.sh reaches it with
# `curl --resolve`, so nothing has to be added to DNS or /etc/hosts, and a
# request that only succeeds because the name resolved for some other reason
# cannot be mistaken for a passing check.
#
# This declares an https public origin without providing one, which is the
# harness's `simulated-tls` mode. That mode cannot prove anything about the TLS
# transport itself -- see the README for what it does and does not establish,
# and for why four checks are expected to fail while it is applied.
VSS_PUBLIC_HOST=vss-sim.brev.test
VSS_PUBLIC_PORT=443
VSS_PUBLIC_HTTP_PROTOCOL=https
VSS_PUBLIC_WS_PROTOCOL=wss
VSS_PUBLIC_URL=https://vss-sim.brev.test
