# =============================================================================
# SMARTCITIES ENVIRONMENT OVERRIDES
# =============================================================================
# Smartcities-specific runtime inputs and evaluation settings. Apply this
# overlay after the alerts profile overrides so the smartcities values win.
# =============================================================================

# =============================================================================
# DEPLOYMENT SELECTION
# =============================================================================
# Smartcities is deployed through the alerts verification profile.
MODE=2d_cv

# Smartcities replaces the alerts CV app services after the launchable merges this overlay into dev-profile-alerts/overrides.env.
# Note: no SDRC services (init-dirs/render-config/wdm-env-from-config/wait-for-redis/sdr-controller) —
# the alerts profile this overlay merges into dropped SDRC (see dev-profile-alerts/overrides.env), and
# smartcities ships no SDR_CONTROLLER_CONFIG_PATH/sdrc config dir of its own.
COMPOSE_PROFILES_CV=vss-behavior-analytics-alerts,nvstreamer-alerts,perception-alerts,kibana-init-container-alerts,vss-video-analytics-api,import-calibration-output-container-smartcities,calibration-toolkit-smartcities,vss-video-analytics-ui-smartcities,vss-va-mcp,vss-agent,alert-bridge,phoenix,elasticsearch,elasticsearch-init-container,kafka,kafka-topic-init-container,redis,kibana,logstash,broker-health-check,vss-haproxy-ingress,rtvi-vlm,vss-ui,centralizedb,vst-ingress,sensor-ms,streamprocessing-ms,llm_${LLM_MODE}_${LLM_NAME_SLUG}
# OpenTelemetry tracing for the alert path. Off by default: neither container is
# in the list above and ALERT_ENABLE_OTEL_MONITORING defaults to false, so this
# profile deploys exactly what it deploys today. The alert_agent.tracing block
# in vlm-as-verifier/configs/config.yml is the tuning, not the switch.
#
# To turn it on, set the flag and append the containers to the list definition
# above rather than to COMPOSE_PROFILES:
#
#   ALERT_ENABLE_OTEL_MONITORING=true
#   COMPOSE_PROFILES_CV=<existing list>,otel-collector,jaeger
#
# This profile ships no prometheus, so the collector's OTel metrics on :8889
# have nothing scraping them; traces still reach Jaeger.
COMPOSE_PROFILES=${COMPOSE_PROFILES_CV}

# =============================================================================
# HOST-PUBLISHED PORTS
# =============================================================================
# Change these when their default host ports conflict with another local service.
CALIBRATION_TOOLKIT_HOST_PORT=8003
VIDEO_ANALYTICS_UI_HOST_PORT=3002

# =============================================================================
# EVALUATION CONFIGURATION
# =============================================================================
# Keep aligned with the selected LLM model and endpoint.
EVAL_LLM_JUDGE_NAME=${LLM_NAME}
EVAL_LLM_JUDGE_BASE_URL=${LLM_BASE_URL}

# =============================================================================
# SMARTCITIES RUNTIME INPUTS
# =============================================================================
# Google Maps API key for smartcities map rendering.
GOOGLE_MAPS_API_KEY=${GOOGLE_MAPS_API_KEY:-}

# Video directory for nvstreamer sample input.
NVSTREAMER_VIDEO_DIR='vss-nvstreamer-video-dir'
