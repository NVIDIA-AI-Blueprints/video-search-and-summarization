# =============================================================================
# SMARTCITIES ENVIRONMENT OVERRIDES
# =============================================================================
# Smartcities-specific runtime inputs and evaluation settings. Apply this
# overlay after the alerts profile overrides so the smartcities values win.
# =============================================================================

# =============================================================================
# DEPLOYMENT SELECTION
# =============================================================================
# Smartcities is deployed through the alerts verification profile.
MODE=2d_cv

# Smartcities replaces the alerts CV app services after the launchable merges this overlay into dev-profile-alerts/overrides.env.
COMPOSE_PROFILES_CV=vss-behavior-analytics-alerts,nvstreamer-alerts,perception-alerts,kibana-init-container-alerts,vss-video-analytics-api-alerts,import-calibration-output-container-smartcities,calibration-toolkit-smartcities,vss-video-analytics-ui-smartcities,vss-va-mcp,vss-agent,alert-bridge,phoenix,elasticsearch,elasticsearch-init-container,kafka,kafka-topic-init-container,redis,kibana,logstash,broker-health-check,vss-haproxy-ingress,init-dirs,render-config,wdm-env-from-config,wait-for-redis,wait-for-docker-workloads,sdr-controller,rtvi-vlm,vss-ui,centralizedb,vst-ingress,sensor-ms,streamprocessing-ms,llm_${LLM_MODE}_${LLM_NAME_SLUG}
COMPOSE_PROFILES=${COMPOSE_PROFILES_CV}

# =============================================================================
# HOST-PUBLISHED PORTS
# =============================================================================
# Change these when their default host ports conflict with another local service.
CALIBRATION_TOOLKIT_HOST_PORT=8003
VIDEO_ANALYTICS_UI_HOST_PORT=3002

# =============================================================================
# EVALUATION CONFIGURATION
# =============================================================================
# Keep aligned with the selected LLM model and endpoint.
EVAL_LLM_JUDGE_NAME=${LLM_NAME}
EVAL_LLM_JUDGE_BASE_URL=${LLM_BASE_URL}

# =============================================================================
# SMARTCITIES RUNTIME INPUTS
# =============================================================================
# Google Maps API key for smartcities map rendering.
GOOGLE_MAPS_API_KEY=${GOOGLE_MAPS_API_KEY:-}

# Video directory for nvstreamer sample input.
NVSTREAMER_VIDEO_DIR='vss-nvstreamer-video-dir'

# =============================================================================
# RT-VLM IMAGE COORDINATES
# =============================================================================
# Compose reads VSS_RT_VLM_IMAGE / VSS_RT_VLM_TAG
# (services/rtvi/rtvi-vlm/rtvi-vlm-docker-compose.yml). RTVI_VLM_IMAGE_TAG is
# interpolated by no compose file, so setting it has no effect. Without these
# two the image falls back to the Compose default, which resolves to a private
# ghcr repository and returns HTTP 403 even after a successful docker login.
VSS_RT_VLM_IMAGE=nvcr.io/nvstaging/vss-core/vss-rt-vlm
VSS_RT_VLM_TAG=3.3.0-26.08.2
