# Runtime/profile values modified by the smartcities launchable live in overrides.env.
# The launchable merges this overlay after developer-profiles/dev-profile-alerts/.env.

# =============================================================================
# SMARTCITIES STABLE OVERLAY
# =============================================================================
# This file contains stable keys where the smartcities industry profile differs
# from developer-profiles/dev-profile-alerts/.env or introduces new stable
# variables. Runtime/user-updated values live in overrides.env.
# =============================================================================

# =============================================================================
# PERCEPTION CONFIGURATION
# =============================================================================
# Smartcities uses RTDETR while the base alerts profile defaults to GDINO.
MODEL_NAME_2D="RTDETR"

# Number of sensors/streams to process.
NUM_SENSORS=10

# =============================================================================
# AGENT UI CONFIGURATION
# =============================================================================
NEXT_PUBLIC_APP_SUBTITLE="Smart Cities"
NEXT_PUBLIC_SIDEBAR_CHAT_WORKFLOW="Smart Cities Agent"
NEXT_PUBLIC_SIDEBAR_CHAT_CHAT_UPLOAD_FILE_ENABLE=true
NEXT_PUBLIC_ENABLE_DASHBOARD_TAB=true
NEXT_PUBLIC_ENABLE_MAP_TAB=true
# SCBP is the alerts verification pipeline (MODE=2d_cv). Keep the Real-time
# editor hidden; CV verification configs are what Manage Alerts should expose.
NEXT_PUBLIC_ALERTS_TAB_MANAGE_ALERTS_SUB_TAB_ENABLE_REALTIME_ALERTS=false
NEXT_PUBLIC_ALERTS_TAB_MANAGE_ALERTS_SUB_TAB_ENABLE_CV_ALERTS_VERIFICATION=true

# =============================================================================
# VST PROFILE CONFIGURATION
# =============================================================================
# Smartcities profile uses SDRC; services/vios/vst.env defaults to direct VST mode.
VST_USE_SDRC=true
STREAM_PROCESSOR_MODULE_ENDPOINT=http://sdr-controller:10000
VST_NGINX_MODE=vst-sdrc

# =============================================================================
# SMARTCITIES APP CONFIGURATION
# =============================================================================
# Video Analytics UI app selector (its = Intelligent Transportation System view).
VIDEO_ANALYTICS_UI_APP_NAME=its
VIDEO_ANALYTICS_UI_IMAGE_TAG="3.3-26.08.2"
CALIBRATION_TOOLKIT_IMAGE_TAG="3.2.1"

# Smartcities disables RTVI-VLM Kafka messages.
RTVI_VLM_KAFKA_ENABLED=false
