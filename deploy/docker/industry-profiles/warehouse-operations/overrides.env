COMPOSE_PROFILES_PLAYBACK_KAFKA_3D=kafka,kafka-topic-init-container,broker-health-check,vss-behavior-analytics-3d,vss-behavior-analytics-playback-3d,elasticsearch,elasticsearch-init-container,kibana,logstash,vss-haproxy-ingress,kibana-init-container-3d,vss-video-analytics-api,import-calibration-output-container-3d,dcgm-exporter,prometheus,grafana,node-exporter,cadvisor
COMPOSE_PROFILES_PLAYBACK_REDIS_3D=redis,broker-health-check,vss-behavior-analytics-3d,vss-behavior-analytics-playback-3d,elasticsearch,elasticsearch-init-container,kibana,logstash,vss-haproxy-ingress,kibana-init-container-3d,vss-video-analytics-api,import-calibration-output-container-3d,dcgm-exporter,prometheus,grafana,node-exporter,cadvisor
