COMPOSE_PROFILES_PLAYBACK_REDIS_MV3DT=redis,broker-health-check,vss-behavior-analytics-mv3dt,vss-behavior-analytics-playback-mv3dt,elasticsearch,elasticsearch-init-container,kibana,logstash,vss-haproxy-ingress,kibana-init-container-mv3dt,vss-video-analytics-api,import-calibration-output-container-mv3dt,dcgm-exporter,prometheus,grafana,node-exporter,cadvisor

# Active profile. Set this to one of the accepted warehouse or playback variants:
# - COMPOSE_PROFILES_WH_2D for MODE=2d with BP_PROFILE=bp_wh.
# - COMPOSE_PROFILES_WH_{KAFKA,REDIS}_{2D,3D,MV3DT} for matching BP_PROFILE/MODE pairs.
# - COMPOSE_PROFILES_WH_{KAFKA,REDIS}_{2D,3D,MV3DT}_MINIMAL for minimal Kafka/Redis deployments.
# - COMPOSE_PROFILES_PLAYBACK_{KAFKA,REDIS}_{2D,3D,MV3DT} for playback-only deployments.
# - COMPOSE_PROFILES_WH_AUTO_CALIB for MODE=auto-calibration with BP_PROFILE=bp_wh_auto_calib.

# OpenTelemetry tracing for the alert path. Off by default: neither container is
# in any list above and ALERT_ENABLE_OTEL_MONITORING defaults to false, so this
# profile deploys exactly what it deploys today. The alert_agent.tracing block
# in vlm-as-verifier/configs/config.yml is the tuning, not the switch.
#
# To turn it on, set the flag and append the containers to whichever
# COMPOSE_PROFILES_WH_* list this deployment uses -- to the list definition,
# not to COMPOSE_PROFILES below, which is selected per BP_PROFILE/MODE:
#
#   ALERT_ENABLE_OTEL_MONITORING=true
#   COMPOSE_PROFILES_WH_2D=<existing list>,otel-collector,jaeger
#
# This is the one profile family that ships prometheus, so it is also the one
# where the collector's OTel metrics on :8889 can be scraped -- uncomment the
# otel-collector job in services/monitoring/config/prometheus.yml once the
# collector is actually deployed.

COMPOSE_PROFILES=${COMPOSE_PROFILES_WH_2D}
