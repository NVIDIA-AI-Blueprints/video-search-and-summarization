# Minimal variants (no ELK, Video Analytics API, HAProxy, monitoring, or import helpers)
COMPOSE_PROFILES_WH_KAFKA_2D_MINIMAL=turnserver-init,turnserver,redis,init-dirs,render-config,wdm-env-from-config,wait-for-redis,sdr-controller,centralizedb,vst-ingress,sensor-bp-wait-bp-configurator,kafka,kafka-topic-init-container,broker-health-check,vss-behavior-analytics-2d,nvstreamer-2d,bp-configurator-2d,perception-2d,sensor-ms-2d,streamprocessing-ms-2d
COMPOSE_PROFILES_WH_REDIS_2D_MINIMAL=turnserver-init,turnserver,redis,init-dirs,render-config,wdm-env-from-config,wait-for-redis,sdr-controller,centralizedb,vst-ingress,sensor-bp-wait-bp-configurator,broker-health-check,vss-behavior-analytics-2d,nvstreamer-2d,bp-configurator-2d,perception-2d,sensor-ms-2d,streamprocessing-ms-2d
COMPOSE_PROFILES_WH_KAFKA_3D_MINIMAL=turnserver-init,turnserver,redis,init-dirs,render-config,wdm-env-from-config,wait-for-redis,sdr-controller,centralizedb,vst-ingress,sensor-bp-wait-bp-configurator,kafka,kafka-topic-init-container,broker-health-check,vss-behavior-analytics-3d,nvstreamer-3d,bp-configurator-3d,ds-configurator-3d,perception-3d,sensor-ms-3d,streamprocessing-ms-3d
COMPOSE_PROFILES_WH_REDIS_3D_MINIMAL=turnserver-init,turnserver,redis,init-dirs,render-config,wdm-env-from-config,wait-for-redis,sdr-controller,centralizedb,vst-ingress,sensor-bp-wait-bp-configurator,broker-health-check,vss-behavior-analytics-3d,nvstreamer-3d,bp-configurator-3d,ds-configurator-3d,perception-3d,sensor-ms-3d,streamprocessing-ms-3d
