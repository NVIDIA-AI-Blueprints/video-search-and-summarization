# =============================================================================
# WAREHOUSE ENVIRONMENT OVERRIDES
# =============================================================================
# Mutable deployment-specific values: mode, profile, model placement,
# model endpoints, host paths, public ingress, credentials, and
# host-published port overrides. Docker Compose should read the warehouse
# .env first and this file second so these values win.
# =============================================================================

# =============================================================================
# DOCKER COMPOSE CONFIGURATION
# =============================================================================
# Project name for volume naming. Change this to run multiple profiles on one host.
COMPOSE_PROJECT_NAME=vss

# =============================================================================
# DEPLOYMENT SELECTION
# =============================================================================
# Deployment mode. Valid: 2d, 3d, mv3dt, auto-calibration.
MODE=2d
# Blueprint profile. Valid by mode:
# - 2d: bp_wh, bp_wh_kafka, bp_wh_redis
# - 3d/mv3dt: bp_wh_kafka, bp_wh_redis
# - auto-calibration: bp_wh_auto_calib
BP_PROFILE=bp_wh
# Elasticsearch runtime. Use cpu by default; use gpu when enabling GPU-backed Elasticsearch.
ELASTICSEARCH_MODE=cpu
# Sample video dataset. All three ship calibration for MODE=2d, 3d and mv3dt,
# so dataset and mode can be chosen independently:
# - nv-warehouse-4cams                     (NUM_STREAMS=4)
# - warehouse-loading-dock-3cams-synthetic (NUM_STREAMS=3)
# - warehouse-4cams-20mx20m-synthetic      (NUM_STREAMS=4)
# MODE=auto-calibration, BP_PROFILE=bp_wh_auto_calib produces a calibration
# rather than using a shipped one: pick the dataset you will calibrate, and
# match NUM_STREAMS to it.
SAMPLE_VIDEO_DATASET="nv-warehouse-4cams"
# Match NUM_STREAMS to the selected sample dataset; defaults are shown above.
NUM_STREAMS=4
# Hardware profile for NIM and perception optimization.
# Valid: H100, L40, L40S, L4, RTXA6000, RTXPRO6000BW, RTXPRO6000BW-SE, RTXPRO4500BW, IGX-THOR,
# DGX-SPARK.
HARDWARE_PROFILE=H100
# Message broker. Use redis for bp_wh_redis; use kafka for bp_wh, bp_wh_kafka, and bp_wh_auto_calib.
STREAM_TYPE=kafka

# =============================================================================
# LLM/VLM SELECTION
# =============================================================================
# Local LLM GPU device. Used by MODE=2d and BP_PROFILE=bp_wh when LLM_MODE is local.
LLM_DEVICE_ID='2'
# LLM runtime mode. Use local for MODE=2d + BP_PROFILE=bp_wh with local NIM,
# remote for an external endpoint, and none for 3d/mv3dt or bp_wh_kafka/bp_wh_redis/bp_wh_auto_calib.
LLM_MODE=local
# VLM runtime mode. Warehouse default RT-VLM uses none; use remote when routing VLM traffic to an external endpoint.
VLM_MODE=none

# Local LLM choices:
# - nvidia/nemotron-3.5-lightning-30b-a3b -> nemotron-3.5-lightning-30b-a3b
# - nvidia/NVIDIA-Nemotron-Nano-9B-v2-FP8 -> nvidia-nemotron-nano-9b-v2-fp8 (edge only)
# Select the local LLM model name, or the model id exposed by a remote /v1/models endpoint.
LLM_NAME=nvidia/nemotron-3.5-lightning-30b-a3b
# Enables the local LLM compose profile; set to none for remote LLM or profiles without local NIM.
LLM_NAME_SLUG=nemotron-3.5-lightning-30b-a3b
# Extra env file for local LLM container settings.
LLM_ENV_FILE=''
# LLM endpoint base URL. Local deployments use the Compose service; remote deployments use the external endpoint.
LLM_BASE_URL=http://vss-llm-nim:8000
# Model API type for the selected LLM endpoint.
LLM_MODEL_TYPE=nim

# Warehouse VLM traffic is served through RT-VLM by default.
# Keep VLM_NAME aligned with the model id advertised by the RT-VLM /v1/models endpoint.
# Select the RT-VLM advertised model id, or the model id exposed by a remote /v1/models endpoint.
VLM_NAME=nim_nvidia_cosmos3-nano-reasoner_bf16-final
# Enables the local VLM compose profile; keep none for warehouse RT-VLM or remote VLM.
VLM_NAME_SLUG=none
# Extra env file for local VLM container settings.
VLM_ENV_FILE=''
# VLM endpoint base URL. Local warehouse VLM uses rtvi-vlm; remote deployments use the external endpoint.
VLM_BASE_URL=http://rtvi-vlm:8000
# Model API type for the selected VLM endpoint.
VLM_MODEL_TYPE=rtvi
# Use none for remote VLM; local RT-VLM uses the integrated Cosmos3 Nano BF16 checkpoint.
RTVI_VLM_MODEL_PATH=ngc:nim/nvidia/cosmos3-nano-reasoner:bf16-final
# Local RT-VLM uses cosmos-reason3; remote VLM compatibility can use openai-compat.
RTVI_VLM_MODEL_TO_USE=cosmos-reason3
# Use ${VLM_BASE_URL}/v1 for remote VLM endpoints.
RTVI_VLM_ENDPOINT=http://rtvi-vlm:8000/v1

# =============================================================================
# HOST PATHS AND INGRESS
# =============================================================================
# Absolute path to this repository's deploy/docker directory.
VSS_APPS_DIR="/path/to/deploy/docker"
# Data directory for videos, playback, calibration, runtime logs, and RT-CV model cache (models/ is populated by compose init).
VSS_DATA_DIR="/path/to/vss-warehouse-app-data"
# Hostname or IP clients should use when services are reachable directly.
HOST_IP='<HOST_IP>'
# Public hostname/IP for generated URLs. On local hosts this usually matches HOST_IP; on cloud VMs use the public address.
EXTERNAL_IP="${HOST_IP}"
HAPROXY_PORT=7777
# Host-published HAProxy port. Change this if 7777 conflicts locally.
HAPROXY_HOST_PORT=7777
VSS_PUBLIC_HTTP_PROTOCOL=http
VSS_PUBLIC_WS_PROTOCOL=ws
VSS_PUBLIC_HOST=${EXTERNAL_IP}
VSS_PUBLIC_PORT=${HAPROXY_HOST_PORT}
TURN_PUBLIC_HOST=${VSS_PUBLIC_HOST}
TURN_EXTERNAL_IP=${EXTERNAL_IP}
# Computed from the public ingress values above; keep after them for Compose interpolation.
VST_EXTERNAL_URL=${VSS_PUBLIC_HTTP_PROTOCOL}://${VSS_PUBLIC_HOST}:${VSS_PUBLIC_PORT}
# Keep aligned with VST_EXTERNAL_URL.
VST_BASE_URL=${VST_EXTERNAL_URL}
# Computed from the public ingress values above.
VSS_AGENT_EXTERNAL_URL=${VSS_PUBLIC_HTTP_PROTOCOL}://${VSS_PUBLIC_HOST}:${VSS_PUBLIC_PORT}
# Computed from the public ingress values above.
VSS_AGENT_REPORTS_BASE_URL=${VSS_PUBLIC_HTTP_PROTOCOL}://${VSS_PUBLIC_HOST}:${VSS_PUBLIC_PORT}/static/

# =============================================================================
# BP CONFIGURATOR CONFIGURATION
# Used by: blueprint-configurator
# =============================================================================

# Sensor Info Source: One of nvstreamer, msb or file
SENSOR_INFO_SOURCE=nvstreamer

# ===============================================================================
# Ships uncommented: 2d/3d/mv3dt warehouse profiles use SDRC.
# MODE=auto-calibration has no sdr-controller — comment all three keys below in
# generated.env so services/vios/vst.env direct VST defaults apply.
VST_USE_SDRC=true
STREAM_PROCESSOR_MODULE_ENDPOINT=http://sdr-controller:10000
VST_NGINX_MODE=vst-sdrc

# =============================================================================
# RTVI CONFIGURATION
# =============================================================================
RTVI_VLLM_GPU_MEMORY_UTILIZATION='0.8'
RTVI_VLLM_MM_PROCESSOR_CACHE_GB=0
# Uncomment RTVI_VLM_MAX_MODEL_LEN=18000 when using RTXPRO4500BW (32 GB) for COMPOSE_PROFILES=${COMPOSE_PROFILES_WH_2D} which deploys vss-rtvi-vlm:
# cap RT-VLM context so the KV cache can be allocated.
# RTVI_VLM_MAX_MODEL_LEN=18000

# RTVI VLM input dimensions and frame rate (for DGX-SPARK, IGX-THOR, AGX-THOR only; not set on other platforms)
# RTVI_VLM_INPUT_WIDTH=860
# RTVI_VLM_INPUT_HEIGHT=467
# RTVI_VLM_DEFAULT_NUM_FRAMES_PER_SECOND_OR_FIXED_FRAMES_CHUNK=20

# =============================================================================
# HOST-PUBLISHED PORTS
# =============================================================================
# Change these when a default host port conflicts with another local service.
VSS_UI_HOST_PORT=3000
VSS_AGENT_HOST_PORT=8000
VSS_VA_MCP_HOST_PORT=9901
ALERT_BRIDGE_HOST_PORT=9080
VIDEO_ANALYTICS_API_HOST_PORT=8081
RTVI_CV_HOST_PORT=9000
RTVI_CV_MV3DT_HOST_PORT=9000
RTVI_VLM_PORT=8018
NVSTREAMER_HTTP_HOST_PORT=31000
PHOENIX_HOST_PORT=6006
ELASTICSEARCH_HOST_PORT=9200
KAFKA_HOST_PORT=9092
REDIS_HOST_PORT=6379
KIBANA_HOST_PORT=5601
TURN_HOST_PORT=3478
TURN_MIN_RELAY_HOST_PORT=${TURN_MIN_RELAY_PORT}
TURN_MAX_RELAY_HOST_PORT=${TURN_MAX_RELAY_PORT}
MQTT_HOST_PORT=1883
VST_INGRESS_HOST_PORT=30888
SENSOR_HTTP_HOST_PORT=30000
STREAM_PROCESSOR_HTTP_HOST_PORT=30001
RTSP_SERVER_HOST_PORT=30554
RTSP_SERVER_HOST_PORT_END=30564
SDRC_CONTROLLER_HOST_PORT=5003
SDRC_PROXY_HOST_PORT=10000
SDRC_DIRECT_HOST_PORT=8011
SDRC_ENVOY_ADMIN_HOST_PORT=9902
DCGM_EXPORTER_HOST_PORT=9400
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=35000
NODE_EXPORTER_HOST_PORT=19100
CADVISOR_HOST_PORT=18080
VSS_AUTO_CALIBRATION_HOST_PORT=8010
VSS_AUTO_CALIBRATION_UI_HOST_PORT=5000

# =============================================================================
# AUTO CALIBRATION OVERRIDES
# =============================================================================
# Browser-facing URL used by vss-auto-calibration-ui. Leave empty to use the compose fallback:
# http://${EXTERNAL_IP:-${HOST_IP}}:${VSS_AUTO_CALIBRATION_HOST_PORT}/v1 (HOST_IP is required when EXTERNAL_IP is unset; VSS_AUTO_CALIBRATION_HOST_PORT is required)
VSS_AUTO_CALIBRATION_MS_API_URL=

# =============================================================================
# CREDENTIALS
# =============================================================================
# Required for warehouse RT-CV model downloads and local NIM image/model pulls.
# Obtain from: https://ngc.nvidia.com/
NGC_CLI_API_KEY=${NGC_CLI_API_KEY:-}
# Required for build.nvidia.com remote endpoints.
# Obtain from: https://build.nvidia.com/
NVIDIA_API_KEY=${NVIDIA_API_KEY:-}
# Required for OpenAI remote endpoints.
# Obtain from: https://platform.openai.com/
OPENAI_API_KEY=${OPENAI_API_KEY:-}
# Optional for authenticated Hugging Face model downloads (higher rate limits).
# Obtain from: https://huggingface.co/settings/tokens
HF_TOKEN=${HF_TOKEN:-}

# =============================================================================
# CONFIGURATOR AND PROFILE PATHS
# =============================================================================
# Compose-time env_file list for blueprint-configurator services defaults to
# .env followed by this override layer so deployment-specific values are available.
# Path under VSS_APPS_DIR.
VLM_AS_VERIFIER_CONFIG_FILE=${VSS_APPS_DIR}/industry-profiles/warehouse-operations/vlm-as-verifier/configs/config.yml
# Path under VSS_APPS_DIR.
VLM_AS_VERIFIER_CONFIG_FILE_REALTIME=${VSS_APPS_DIR}/industry-profiles/warehouse-operations/vlm-as-verifier/realtime-config.yml
# Path under VSS_APPS_DIR.
VLM_AS_VERIFIER_ALERT_TYPE_CONFIG_FILE=${VSS_APPS_DIR}/industry-profiles/warehouse-operations/vlm-as-verifier/configs/alert_type_config.json
# Path under VSS_APPS_DIR.
SENSOR_FILE_PATH=${VSS_APPS_DIR}/industry-profiles/warehouse-operations/camera_configs/camera_info.json
# Warehouse SDR controller path under VSS_APPS_DIR selected by MODE.
SDR_CONTROLLER_CONFIG_PATH=${VSS_APPS_DIR}/industry-profiles/warehouse-operations/warehouse-${MODE}-app/sdrc
# Path under VSS_APPS_DIR.
NVSTREAMER_CONFIG_DIR=${VSS_APPS_DIR}/services/nvstreamer/configs
# =============================================================================
# PROFILE-SPECIFIC SCENARIO OVERRIDES
# =============================================================================
# rt-cv is a managed image: it inherits VSS_CONTAINER_REGISTRY/VSS_CONTAINER_TAG
# from containers.env like every other managed image, so no tag is pinned here.
# Pinning an NGC-style tag would combine with the GHCR image default and resolve
# to a coordinate that does not exist.
#
# DGX-SPARK/SBSA: the SBSA image shares this GHCR repository under an -sbsa tag
# suffix, so only the TAG needs overriding -- the image default resolves.
# VSS_RT_CV_TAG="develop-latest-sbsa"
# RT-VLM shares the managed GHCR release channel. DGX-SPARK activates the
# commented SBSA tag with the standard profile environment switch.
# VSS_RT_VLM_TAG="develop-latest-sbsa"

# =============================================================================
# COMPOSE PROFILE SELECTION
# =============================================================================
# Service composition uses the profile inversion model: services carry only their
# own profile name, and each deployment variant selects a flat list of service
# profiles here. These values are kept in overrides.env so users can inspect and
# adjust what each selectable warehouse profile includes.

# 2D agent profile (non-minimal; includes LLM NIM token)
COMPOSE_PROFILES_WH_2D=turnserver-init,turnserver,redis,init-dirs,render-config,wdm-env-from-config,wait-for-redis,sdr-controller,centralizedb,vst-ingress,sensor-bp-wait-bp-configurator,kafka,kafka-topic-init-container,broker-health-check,vss-behavior-analytics-2d,nvstreamer-2d,bp-configurator-2d,perception-2d,sensor-ms-2d,streamprocessing-ms-2d,vss-va-mcp,vss-agent,alert-bridge,rtvi-vlm,vss-ui,phoenix,elasticsearch,elasticsearch-init-container,kibana,logstash,vss-haproxy-ingress,kibana-init-container-2d,vss-video-analytics-api,import-calibration-output-container-2d,dcgm-exporter,prometheus,grafana,node-exporter,cadvisor,llm_${LLM_MODE}_${LLM_NAME_SLUG}

# Kafka/Redis variants
COMPOSE_PROFILES_WH_KAFKA_2D=turnserver-init,turnserver,redis,init-dirs,render-config,wdm-env-from-config,wait-for-redis,sdr-controller,centralizedb,vst-ingress,sensor-bp-wait-bp-configurator,kafka,kafka-topic-init-container,broker-health-check,vss-behavior-analytics-2d,nvstreamer-2d,bp-configurator-2d,perception-2d,sensor-ms-2d,streamprocessing-ms-2d,elasticsearch,elasticsearch-init-container,kibana,logstash,vss-haproxy-ingress,kibana-init-container-2d,vss-video-analytics-api,import-calibration-output-container-2d,dcgm-exporter,prometheus,grafana,node-exporter,cadvisor
COMPOSE_PROFILES_WH_REDIS_2D=turnserver-init,turnserver,redis,init-dirs,render-config,wdm-env-from-config,wait-for-redis,sdr-controller,centralizedb,vst-ingress,sensor-bp-wait-bp-configurator,broker-health-check,vss-behavior-analytics-2d,nvstreamer-2d,bp-configurator-2d,perception-2d,sensor-ms-2d,streamprocessing-ms-2d,elasticsearch,elasticsearch-init-container,kibana,logstash,vss-haproxy-ingress,kibana-init-container-2d,vss-video-analytics-api,import-calibration-output-container-2d,dcgm-exporter,prometheus,grafana,node-exporter,cadvisor
COMPOSE_PROFILES_WH_KAFKA_3D=turnserver-init,turnserver,redis,init-dirs,render-config,wdm-env-from-config,wait-for-redis,sdr-controller,centralizedb,vst-ingress,sensor-bp-wait-bp-configurator,kafka,kafka-topic-init-container,broker-health-check,vss-behavior-analytics-3d,nvstreamer-3d,bp-configurator-3d,ds-configurator-3d,perception-3d,sensor-ms-3d,streamprocessing-ms-3d,elasticsearch,elasticsearch-init-container,kibana,logstash,vss-haproxy-ingress,kibana-init-container-3d,vss-video-analytics-api,import-calibration-output-container-3d,dcgm-exporter,prometheus,grafana,node-exporter,cadvisor
COMPOSE_PROFILES_WH_REDIS_3D=turnserver-init,turnserver,redis,init-dirs,render-config,wdm-env-from-config,wait-for-redis,sdr-controller,centralizedb,vst-ingress,sensor-bp-wait-bp-configurator,broker-health-check,vss-behavior-analytics-3d,nvstreamer-3d,bp-configurator-3d,ds-configurator-3d,perception-3d,sensor-ms-3d,streamprocessing-ms-3d,elasticsearch,elasticsearch-init-container,kibana,logstash,vss-haproxy-ingress,kibana-init-container-3d,vss-video-analytics-api,import-calibration-output-container-3d,dcgm-exporter,prometheus,grafana,node-exporter,cadvisor
COMPOSE_PROFILES_WH_KAFKA_MV3DT=turnserver-init,turnserver,redis,init-dirs,render-config,wdm-env-from-config,wait-for-redis,sdr-controller,centralizedb,vst-ingress,sensor-bp-wait-bp-configurator,kafka,kafka-topic-init-container,broker-health-check,vss-behavior-analytics-mv3dt,nvstreamer-mv3dt,bp-configurator-mv3dt,vss-rtvi-cv-bev-fusion,vss-rtvi-cv-mv3dt,mosquitto,sensor-ms-mv3dt,streamprocessing-ms-mv3dt,elasticsearch,elasticsearch-init-container,kibana,logstash,vss-haproxy-ingress,kibana-init-container-mv3dt,vss-video-analytics-api,import-calibration-output-container-mv3dt,dcgm-exporter,prometheus,grafana,node-exporter,cadvisor
