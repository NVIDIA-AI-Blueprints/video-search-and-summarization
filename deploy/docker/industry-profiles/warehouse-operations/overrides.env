# Auto-calibration
COMPOSE_PROFILES_WH_AUTO_CALIB=turnserver-init,turnserver,redis,centralizedb,vst-ingress,sensor-bp-wait-bp-configurator,vss-auto-calibration,vss-auto-calibration-ui,nvstreamer-amc,vss-configurator-base,sensor-ms,streamprocessing-ms,vss-haproxy-ingress

# Playback variants
COMPOSE_PROFILES_PLAYBACK_KAFKA_2D=kafka,kafka-topic-init-container,broker-health-check,vss-behavior-analytics-2d,vss-behavior-analytics-playback-2d,elasticsearch,elasticsearch-init-container,kibana,logstash,vss-haproxy-ingress,kibana-init-container-2d,vss-video-analytics-api,import-calibration-output-container-2d,dcgm-exporter,prometheus,grafana,node-exporter,cadvisor
