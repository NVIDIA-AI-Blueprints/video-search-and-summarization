# Runtime/profile values modified by blueprint-deploy.sh live in overrides.env.
# blueprint-deploy.sh generates generated.env from overrides.env and passes it after this file.

# =============================================================================
# WAREHOUSE BLUEPRINT ENVIRONMENT CONFIGURATION
# =============================================================================
# This file contains environment variables for the warehouse blueprint.
# Services: Infra, VST, Warehouse 2D/3D/MV3DT apps, RTVI-VLM (optional), Agents (optional)
#
# Profile variants:
# 2d:
#   bp_wh
#   bp_wh_kafka
#   bp_wh_redis
#   bp_wh_auto_calib
# MODE=3d:
#   bp_wh_kafka
#   bp_wh_redis
#   bp_wh_auto_calib
# MODE=mv3dt:
#   bp_wh_kafka
#   bp_wh_redis
#   bp_wh_auto_calib
# =============================================================================

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================
# Values rewritten by blueprint-deploy.sh live in overrides.env.

# Minimal profile applies to bp_wh_kafka and bp_wh_redis.
# Minimal profile is recommended for Thor deployment.
# For minimal profile, set MINIMAL_PROFILE="true" (excludes ELK, Video Analytics API, monitoring and their dependent services).
# For extended profile, set MINIMAL_PROFILE="" or leave it unset.
MINIMAL_PROFILE="true" # Minimal profile
# MINIMAL_PROFILE=""     # extended profile

# GPU IDs reserved for warehouse perception / RT-VLM services.
RT_CV_DEVICE_ID='0'
RT_VLM_DEVICE_ID='1'

# =============================================================================
# CORE INFRASTRUCTURE PATHS
# =============================================================================
# HAProxy ingress

# VST TURN / WebRTC relay (warehouse profiles only)
TURN_PORT=3478
TURN_MIN_RELAY_PORT=49160
TURN_MAX_RELAY_PORT=49200
TURN_REALM=vss.local
# TURN_USERNAME is not secret. The password is generated once in the vss-turn-password Docker volume by turnserver-init.
TURN_USERNAME=vss
TURN_PASSWORD_BYTES=32
# Optional override for external or multiple TURN endpoints. Leave empty for the bundled turnserver.
VST_STATIC_TURNURL_LIST=

# =============================================================================
# ELASTICSEARCH CONFIGURATION
# =============================================================================

# Elasticsearch ILM policy retention period
ELASTICSEARCH_ILM_MIN_AGE=4h

# Elasticsearch dense vector embedding fields (off for warehouse profiles)
ELASTICSEARCH_ENABLE_EMBEDDINGS=false

# =============================================================================
# HARDWARE & PERCEPTION CONFIGURATION
# =============================================================================
# BEV Fusion container used by mv3dt mode
BEV_FUSION_MV3DT_IMAGE="nvcr.io/nvidia/vss-core/vss-rt-cv-mv3dt-bev-fusion"
BEV_FUSION_MV3DT_TAG="3.2.0"

# MQTT broker (used by mv3dt mode for cross-camera messaging)
MQTT_HOST=mosquitto
MQTT_PORT=1883

# =============================================================================
# NVSTREAMER CONFIGURATION
# =============================================================================
# Install additional packages for audio, software encoding, file upload.
NVSTREAMER_INSTALL_ADDITIONAL_PACKAGES=true

# NvStreamer HTTP port inside the Compose network. Host port overrides live in overrides.env.
NVSTREAMER_HTTP_PORT=31000

# Nvstreamer host used by warehouse configurators
NVSTREAMER_IP=vss-vios-nvstreamer # Compose service DNS name; override with a host/IP for an external Nvstreamer

# =============================================================================
# DOCKER COMPOSE CONFIGURATION
# =============================================================================

# Project name for volume naming (DO NOT MODIFY)
COMPOSE_PROJECT_NAME=mdx

# =============================================================================
# COMPOSE PROFILE SELECTION
# =============================================================================
# Service composition uses the profile inversion model: services carry only their
# own profile name, and each deployment variant selects a flat list of service
# profiles here.
_WH_BASE=turnserver-init,turnserver,redis,init-dirs,render-config,wdm-env-from-config,wait-for-redis,wait-for-docker-workloads,sdr-controller,centralizedb,vst-ingress,sensor-bp-wait-bp-configurator
_WH_KAFKA=kafka,kafka-topic-init-container
_WH_BROKER_HEALTH=broker-health-check
_WH_EXTENDED_COMMON=elasticsearch,elasticsearch-init-container,kibana,logstash,vss-haproxy-ingress
_WH_MONITORING=dcgm-exporter,prometheus,grafana,node-exporter,cadvisor
_WH_AGENT_STACK=vss-va-mcp,vss-agent,alert-bridge,rtvi-vlm,vss-ui
_WH_2D_APP=vss-behavior-analytics-2d,nvstreamer-2d,bp-configurator-2d-init,bp-configurator-2d,perception-2d,sensor-ms-2d,streamprocessing-ms-2d
_WH_3D_APP=vss-behavior-analytics-3d,nvstreamer-3d,bp-configurator-3d-init,bp-configurator-3d,ds-configurator-3d,perception-3d,sensor-ms-3d,streamprocessing-ms-3d
_WH_MV3DT_APP=vss-behavior-analytics-mv3dt,nvstreamer-mv3dt,bp-configurator-mv3dt-init,bp-configurator-mv3dt,vss-rtvi-cv-bev-fusion,vss-rtvi-cv-mv3dt,mosquitto,sensor-ms-mv3dt,streamprocessing-ms-mv3dt
_WH_2D_EXTENDED=kibana-init-container-2d,vss-video-analytics-api-2d,import-calibration-output-container-2d
_WH_3D_EXTENDED=kibana-init-container-3d,vss-video-analytics-api-3d,import-calibration-output-container-3d
_WH_MV3DT_EXTENDED=kibana-init-container-mv3dt,vss-video-analytics-api-mv3dt,import-calibration-output-container-mv3dt
_WH_AUTO_CALIB=vss-auto-calibration,vss-auto-calibration-ui
_WH_PLAYBACK_2D=vss-behavior-analytics-2d,vss-behavior-analytics-playback-2d
_WH_PLAYBACK_3D=vss-behavior-analytics-3d,vss-behavior-analytics-playback-3d
_WH_PLAYBACK_MV3DT=vss-behavior-analytics-playback-mv3dt

_WH_2D_NO_LLM=${_WH_BASE},${_WH_KAFKA},${_WH_BROKER_HEALTH},${_WH_2D_APP},${_WH_AGENT_STACK},${_WH_EXTENDED_COMMON},${_WH_2D_EXTENDED},${_WH_MONITORING}

# Kafka/Redis variants
COMPOSE_PROFILES_WH_KAFKA_2D=${_WH_BASE},${_WH_KAFKA},${_WH_BROKER_HEALTH},${_WH_2D_APP},${_WH_EXTENDED_COMMON},${_WH_2D_EXTENDED},${_WH_MONITORING}
COMPOSE_PROFILES_WH_REDIS_2D=${_WH_BASE},${_WH_BROKER_HEALTH},${_WH_2D_APP},${_WH_EXTENDED_COMMON},${_WH_2D_EXTENDED},${_WH_MONITORING}
COMPOSE_PROFILES_WH_KAFKA_3D=${_WH_BASE},${_WH_KAFKA},${_WH_BROKER_HEALTH},${_WH_3D_APP},${_WH_EXTENDED_COMMON},${_WH_3D_EXTENDED},${_WH_MONITORING}
COMPOSE_PROFILES_WH_REDIS_3D=${_WH_BASE},${_WH_BROKER_HEALTH},${_WH_3D_APP},${_WH_EXTENDED_COMMON},${_WH_3D_EXTENDED},${_WH_MONITORING}
COMPOSE_PROFILES_WH_KAFKA_MV3DT=${_WH_BASE},${_WH_KAFKA},${_WH_BROKER_HEALTH},${_WH_MV3DT_APP},${_WH_EXTENDED_COMMON},${_WH_MV3DT_EXTENDED}
COMPOSE_PROFILES_WH_REDIS_MV3DT=${_WH_BASE},${_WH_BROKER_HEALTH},${_WH_MV3DT_APP},${_WH_EXTENDED_COMMON},${_WH_MV3DT_EXTENDED}

# Minimal variants (no ELK, Video Analytics API, HAProxy, monitoring, or import helpers)
COMPOSE_PROFILES_WH_KAFKA_2D_MINIMAL=${_WH_BASE},${_WH_KAFKA},${_WH_BROKER_HEALTH},${_WH_2D_APP}
COMPOSE_PROFILES_WH_REDIS_2D_MINIMAL=${_WH_BASE},${_WH_BROKER_HEALTH},${_WH_2D_APP}
COMPOSE_PROFILES_WH_KAFKA_3D_MINIMAL=${_WH_BASE},${_WH_KAFKA},${_WH_BROKER_HEALTH},${_WH_3D_APP}
COMPOSE_PROFILES_WH_REDIS_3D_MINIMAL=${_WH_BASE},${_WH_BROKER_HEALTH},${_WH_3D_APP}
COMPOSE_PROFILES_WH_KAFKA_MV3DT_MINIMAL=${_WH_BASE},${_WH_KAFKA},${_WH_BROKER_HEALTH},${_WH_MV3DT_APP}
COMPOSE_PROFILES_WH_REDIS_MV3DT_MINIMAL=${_WH_BASE},${_WH_BROKER_HEALTH},${_WH_MV3DT_APP}

# Auto-calibration variants (already minimal by composition)
COMPOSE_PROFILES_WH_AUTO_CALIB_2D=${_WH_BASE},${_WH_AUTO_CALIB},nvstreamer-2d,bp-configurator-2d-init,bp-configurator-2d,sensor-ms-2d,streamprocessing-ms-2d,vss-haproxy-ingress
COMPOSE_PROFILES_WH_AUTO_CALIB_3D=${_WH_BASE},${_WH_AUTO_CALIB},nvstreamer-3d,bp-configurator-3d-init,bp-configurator-3d,sensor-ms-3d,streamprocessing-ms-3d,vss-haproxy-ingress
COMPOSE_PROFILES_WH_AUTO_CALIB_MV3DT=${_WH_BASE},${_WH_AUTO_CALIB},nvstreamer-mv3dt,bp-configurator-mv3dt-init,bp-configurator-mv3dt,sensor-ms-mv3dt,streamprocessing-ms-mv3dt,vss-haproxy-ingress

# Playback variants
COMPOSE_PROFILES_PLAYBACK_KAFKA_2D=${_WH_KAFKA},${_WH_BROKER_HEALTH},${_WH_PLAYBACK_2D},${_WH_EXTENDED_COMMON},${_WH_2D_EXTENDED},${_WH_MONITORING}
COMPOSE_PROFILES_PLAYBACK_REDIS_2D=redis,${_WH_BROKER_HEALTH},${_WH_PLAYBACK_2D},${_WH_EXTENDED_COMMON},${_WH_2D_EXTENDED},${_WH_MONITORING}
COMPOSE_PROFILES_PLAYBACK_KAFKA_3D=${_WH_KAFKA},${_WH_BROKER_HEALTH},${_WH_PLAYBACK_3D},${_WH_EXTENDED_COMMON},${_WH_3D_EXTENDED},${_WH_MONITORING}
COMPOSE_PROFILES_PLAYBACK_REDIS_3D=redis,${_WH_BROKER_HEALTH},${_WH_PLAYBACK_3D},${_WH_EXTENDED_COMMON},${_WH_3D_EXTENDED},${_WH_MONITORING}
COMPOSE_PROFILES_PLAYBACK_KAFKA_MV3DT=${_WH_PLAYBACK_MV3DT}
COMPOSE_PROFILES_PLAYBACK_REDIS_MV3DT=${_WH_PLAYBACK_MV3DT}


# =============================================================================
# VSS AGENT CONFIGURATION
# =============================================================================
# VSS Agent Core
VSS_AGENT_CONFIG_FILE=/vss-agent/deploy/docker/industry-profiles/warehouse-operations/vss-agent/configs/config.yml
# Nemotron Nano Omni: set true so VST clip URLs and ingest keep audio (see vss-agent config enable_audio).
ENABLE_AUDIO=false

# VSS Video Analysis MCP Server
VSS_VA_MCP_CONFIG_FILE=/vss-agent/deploy/docker/industry-profiles/warehouse-operations/vss-agent/configs/va_mcp_server_config.yml

# VSS Agent Templates
VSS_AGENT_TEMPLATE_PATH=./deploy/docker/industry-profiles/warehouse-operations/vss-agent/templates
VSS_AGENT_TEMPLATE_NAME=incident_report_template.md

# Video Analytics API Port
MDX_PORT=8081

# =============================================================================
# VST PROFILE CONFIGURATION
# =============================================================================
# Used by: warehouse apps

# Warehouse profiles use SDRC; services/vios/vst.env defaults to direct VST mode.
VST_USE_SDRC=true
STREAM_PROCESSOR_MODULE_ENDPOINT=http://sdr-controller:10000
VST_NGINX_MODE=vst-sdrc

VST_IP=vst-ingress # Compose service DNS name; override with a host/IP for an external VST

# AGENT STORAGE & REPORT CONFIGURATION
# =============================================================================
# Used by: vss-agent

VSS_ES_PORT=9200

# Object store type: local_object_store (in-memory, not persisted) or s3
VSS_AGENT_OBJECT_STORE_TYPE=local_object_store

# =============================================================================
# RTVI CONFIGURATION
# =============================================================================
# RTVI CONFIGURATION
# =============================================================================
RTVI_VLLM_GPU_MEMORY_UTILIZATION=''

# RTVI VLM input dimensions and frame rate (for DGX-SPARK, IGX-THOR, AGX-THOR only; not set on other platforms)
# RTVI_VLM_INPUT_WIDTH=860
# RTVI_VLM_INPUT_HEIGHT=467
# RTVI_VLM_DEFAULT_NUM_FRAMES_PER_SECOND_OR_FIXED_FRAMES_CHUNK=20

# =============================================================================
# AGENT UI CONFIGURATION
# =============================================================================
NEXT_PUBLIC_APP_SUBTITLE="Warehouse"
NEXT_PUBLIC_SIDEBAR_CHAT_WORKFLOW="Warehouse Agent"
NEXT_PUBLIC_SIDEBAR_CHAT_CHAT_UPLOAD_FILE_ENABLE=false
NEXT_PUBLIC_ENABLE_ALERTS_TAB=true
NEXT_PUBLIC_ENABLE_DASHBOARD_TAB=true
NEXT_PUBLIC_ENABLE_VIDEO_MANAGEMENT_TAB=false
NEXT_PUBLIC_ENABLE_SEARCH_TAB=false
NEXT_PUBLIC_SIDEBAR_CHAT_CHAT_API_CUSTOM_AGENT_PARAMS_JSON={"params":[{"name":"llm_reasoning","label":"LLM Reasoning","type":"boolean","default-value":false,"changeable":true,"tooltip-info":""},{"name":"vlm_reasoning","label":"VLM Reasoning","type":"boolean","default-value":false,"changeable":true,"tooltip-info":""}]}

# =============================================================================
# BP CONFIGURATOR CONFIGURATION
# Used by: blueprint-configurator
# =============================================================================

# Enable/Disable Blueprint Profile Configurator. Set to true to enable, false to disable.
ENABLE_PROFILE_CONFIGURATOR=true

# Blueprint Profile Configurator config file for warehouse
CONFIGURATOR_CONFIG_FILE="blueprint_config.yml"

# Sensor Info Source: One of nvstreamer, msb or file
SENSOR_INFO_SOURCE=nvstreamer

# =============================================================================
# AUTO CALIBRATION CONFIGURATION
# =============================================================================
VSS_AUTO_CALIBRATION_PORT=8010
VGGT_MODEL_PATH=/tmp/vggt_model/vggt_1B_commercial.pt
VSS_AUTO_CALIBRATION_UI_PORT=5000
VSS_AUTO_CALIBRATION_MS_API_URL=http://vss-auto-calibration:${VSS_AUTO_CALIBRATION_PORT}/v1
