# Copy to the ignored user-overrides.env. This sample uses its own project and
# data directory. Shared VSS services still have fixed container names.
COMPOSE_PROJECT_NAME=vss-d1-cosmos
HARDWARE_PROFILE=AGX-THOR
VSS_APPS_DIR=/path/to/video-search-and-summarization/deploy/docker
VSS_DATA_DIR=/path/to/vss-d1-cosmos-data
# Copy the stock VIOS configs into this directory before bring-up.
VST_CONFIG_PATH=${VSS_DATA_DIR}/vios-configs

# Access the deployment locally or through an SSH tunnel. Also pass
# network.compose.yml so Docker binds service ports to loopback.
HOST_IP=127.0.0.1
EXTERNAL_IP=${HOST_IP}
HAPROXY_PORT=7777
HAPROXY_HOST_PORT=7777
VSS_PUBLIC_HOST=${EXTERNAL_IP}
VSS_PUBLIC_PORT=${HAPROXY_HOST_PORT}
VSS_PUBLIC_HTTP_PROTOCOL=http
VSS_PUBLIC_WS_PROTOCOL=ws
VST_EXTERNAL_URL=${VSS_PUBLIC_HTTP_PROTOCOL}://${VSS_PUBLIC_HOST}:${VSS_PUBLIC_PORT}
VST_BASE_URL=${VST_EXTERNAL_URL}
VSS_UI_SERVICE_HOST=d1-ui
RTVI_VLM_PORT=8018

# Inject the credentials from your shell, or set values only in the ignored
# user-overrides.env. HF_TOKEN is optional for the public D1-2B snapshot.
NGC_CLI_API_KEY=${NGC_CLI_API_KEY:-}
HF_TOKEN=${HF_TOKEN:-}

# Supply two reachable H.264 RTSP/TCP inputs. Use live for a camera, or
# recorded for an RTSP publisher replaying a file.
D1_FLOWING_RTSP_URL=
D1_QUEUED_RTSP_URL=
D1_FLOWING_KIND=live
D1_QUEUED_KIND=live

# Optional private Nemotron Bolt endpoint for drafting monitoring prompts.
NEMOTRON_URL=

COMPOSE_PROFILES=d1-cosmos,vss-haproxy-ingress,centralizedb,redis,vst-ingress,sensor-ms,streamprocessing-ms,vios-apt-cache-init,rtvi-vlm,kafka,elasticsearch
