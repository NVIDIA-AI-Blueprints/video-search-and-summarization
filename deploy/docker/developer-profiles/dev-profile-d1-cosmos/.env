# Stable defaults for the D1 + Cosmos developer profile.
BP_PROFILE=bp_developer_d1_cosmos
MODE=2d
STREAM_TYPE=kafka

# Keep this aligned with the model ID reported by RT-VLM /v1/models.
VLM_NAME=nim_nvidia_cosmos3-nano-reasoner_bf16-final
RTVI_VLM_MODEL_TO_USE=cosmos-reason3
RTVI_VLM_MODEL_PATH=ngc:nim/nvidia/cosmos3-nano-reasoner:bf16-final
RTVI_VLLM_GPU_MEMORY_UTILIZATION=0.35
RTVI_VLLM_MAX_NUM_SEQS=1
RTVI_VLM_BATCH_SIZE=1
RTVI_VLM_MAX_MODEL_LEN=8192
# The D1 workers publish their own decision/event/review messages.
RTVI_VLM_MESSAGE_BUS=
RTVI_VLM_ERROR_BUS=
