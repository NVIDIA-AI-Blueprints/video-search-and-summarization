# =============================================================================
# DEV-PROFILE-MC-TRACKING ENVIRONMENT OVERRIDES
# =============================================================================
# Mutable deployment-specific values: hardware, host paths, public ingress,
# credentials, and host-published port overrides. Docker Compose should read
# the profile .env first and this file second so these values win.
# =============================================================================

# =============================================================================
# DOCKER COMPOSE CONFIGURATION
# =============================================================================
# Project name for volume naming. Change this to run multiple profiles on one host.
COMPOSE_PROJECT_NAME=vss

# =============================================================================
# DEPLOYMENT SELECTION
# =============================================================================
# Elasticsearch runtime. Use cpu by default; use gpu when enabling GPU-backed Elasticsearch.
ELASTICSEARCH_MODE=cpu
# Sample dataset for this profile (4 synthetic cameras, 20m x 20m warehouse floor).
SAMPLE_VIDEO_DATASET="warehouse-4cams-20mx20m-synthetic"
# Match NUM_STREAMS (set in .env) to the selected sample dataset.

# Hardware profile for perception/BEV-fusion optimization.
# Valid: H100, L4, L40S, RTXA6000, RTXA6000ADA, RTXPRO6000BW, RTXPRO4500BW, IGX-THOR, DGX-SPARK.
# (RTXPRO4500BW has no mc-tracking entry in blueprint_config.yml today.)
HARDWARE_PROFILE=H100
# Message broker type: kafka or redis. Keep matching COMPOSE_PROFILES_MC_TRACKING_{KAFKA,REDIS} below.
STREAM_TYPE=kafka

# =============================================================================
# HOST PATHS AND INGRESS
# =============================================================================
# Absolute path to this repository's deploy/docker directory.
VSS_APPS_DIR="/path/to/deploy/docker"
# Data directory for videos, playback, calibration, runtime logs, and RT-CV model cache.
VSS_DATA_DIR="/path/to/vss-mc-tracking-data"
# Hostname or IP clients should use when services are reachable directly.
HOST_IP='<HOST_IP>'
# Public hostname/IP for generated URLs. On local hosts this usually matches HOST_IP; on cloud VMs use the public address.
EXTERNAL_IP="${HOST_IP}"
HAPROXY_PORT=7777
# Host-published HAProxy port. Change this if 7777 conflicts locally.
HAPROXY_HOST_PORT=7777
VSS_PUBLIC_HTTP_PROTOCOL=http
VSS_PUBLIC_WS_PROTOCOL=ws
VSS_PUBLIC_HOST=${EXTERNAL_IP}
VSS_PUBLIC_PORT=${HAPROXY_HOST_PORT}
TURN_PUBLIC_HOST=${VSS_PUBLIC_HOST}
TURN_EXTERNAL_IP=${EXTERNAL_IP}
# Computed from the public ingress values above; keep after them for Compose interpolation.
VST_EXTERNAL_URL=${VSS_PUBLIC_HTTP_PROTOCOL}://${VSS_PUBLIC_HOST}:${VSS_PUBLIC_PORT}
# Keep aligned with VST_EXTERNAL_URL.
VST_BASE_URL=${VST_EXTERNAL_URL}

# =============================================================================
# BP CONFIGURATOR CONFIGURATION
# Used by: bp-configurator-mc-tracking
# =============================================================================
# Sensor Info Source: One of nvstreamer, msb or file.
SENSOR_INFO_SOURCE=nvstreamer

# =============================================================================
# HOST-PUBLISHED PORTS
# =============================================================================
# Change these when a default host port conflicts with another local service.
VIDEO_ANALYTICS_API_HOST_PORT=8081
# RTVI_CV_MV3DT_HOST_PORT/RTVI_CV_MV3DT_PORT are the shared services/rtvi/rtvi-cv/
# rtvi-cv-mv3dt/compose.yaml base's own variable names; this profile's
# vss-rtvi-cv-mc-tracking service still reads them because it extends that same
# shared base.
RTVI_CV_MV3DT_HOST_PORT=9000
RTVI_CV_MV3DT_PORT=9000
NVSTREAMER_HTTP_HOST_PORT=31000
ELASTICSEARCH_HOST_PORT=9200
KAFKA_HOST_PORT=9092
REDIS_HOST_PORT=6379
KIBANA_HOST_PORT=5601
TURN_HOST_PORT=3478
TURN_MIN_RELAY_HOST_PORT=${TURN_MIN_RELAY_PORT}
TURN_MAX_RELAY_HOST_PORT=${TURN_MAX_RELAY_PORT}
MQTT_HOST_PORT=1883
VST_INGRESS_HOST_PORT=30888
SENSOR_HTTP_HOST_PORT=30000
STREAM_PROCESSOR_HTTP_HOST_PORT=30001
RTSP_SERVER_HOST_PORT=30554
RTSP_SERVER_HOST_PORT_END=30564
SDRC_CONTROLLER_HOST_PORT=5003
SDRC_PROXY_HOST_PORT=10000
SDRC_DIRECT_HOST_PORT=8011
SDRC_ENVOY_ADMIN_HOST_PORT=9902
DCGM_EXPORTER_HOST_PORT=9400
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=35000
NODE_EXPORTER_HOST_PORT=19100
CADVISOR_HOST_PORT=18080

# =============================================================================
# CREDENTIALS
# =============================================================================
# Required for RT-CV model downloads and local NIM image/model pulls.
# Obtain from: https://ngc.nvidia.com/
NGC_CLI_API_KEY=${NGC_CLI_API_KEY:-}

# =============================================================================
# CONFIGURATOR AND PROFILE PATHS
# =============================================================================
# Compose-time env_file list for bp-configurator-mc-tracking defaults to .env
# followed by this override layer so deployment-specific values are available.
# Path under VSS_APPS_DIR — this profile's own camera list, no link to
# industry-profiles/warehouse-operations (MCT-FND-002).
SENSOR_FILE_PATH=${VSS_APPS_DIR}/developer-profiles/dev-profile-mc-tracking/camera_configs/camera_info.json
# Blueprint-owned NVStreamer configuration directory, read by base.yml's
# default vst-config.json mount (services/nvstreamer/compose.yml).
NVSTREAMER_CONFIG_DIR=${VSS_APPS_DIR}/developer-profiles/dev-profile-mc-tracking/nvstreamer/configs
# This profile's own sdrc/ path, hardcoded (no MODE-based selection needed —
# this profile only has one mode).
SDR_CONTROLLER_CONFIG_PATH=${VSS_APPS_DIR}/developer-profiles/dev-profile-mc-tracking/sdrc

# =============================================================================
# COMPOSE PROFILE SELECTION
# =============================================================================
# Service composition uses the profile inversion model: services carry only
# their own profile name, and each deployment variant selects a flat list of
# service profiles here. Auto-calibration is a separate profile, not part of
# this one.

# Kafka/Redis variants
COMPOSE_PROFILES_MC_TRACKING_KAFKA=turnserver-init,turnserver,redis,init-dirs,render-config,wdm-env-from-config,wait-for-redis,wait-for-docker-workloads,sdr-controller,centralizedb,vst-ingress,sensor-bp-wait-bp-configurator,kafka,kafka-topic-init-container,broker-health-check,vss-behavior-analytics-mc-tracking,nvstreamer-mc-tracking,bp-configurator-mc-tracking-init,bp-configurator-mc-tracking,reid-embed-init-mc-tracking,reid-etcd-mc-tracking,reid-minio-mc-tracking,reid-milvus-mc-tracking,reid-embed-mc-tracking,vss-rtvi-cv-bev-fusion-mc-tracking,vss-rtvi-cv-mc-tracking,mosquitto,sensor-ms-mc-tracking,streamprocessing-ms-mc-tracking,elasticsearch,elasticsearch-init-container,kibana,logstash,vss-haproxy-ingress,kibana-init-container-mc-tracking,vss-video-analytics-api-mc-tracking,import-calibration-output-container-mc-tracking,dcgm-exporter,prometheus,grafana,node-exporter,cadvisor
COMPOSE_PROFILES_MC_TRACKING_REDIS=turnserver-init,turnserver,redis,init-dirs,render-config,wdm-env-from-config,wait-for-redis,wait-for-docker-workloads,sdr-controller,centralizedb,vst-ingress,sensor-bp-wait-bp-configurator,broker-health-check,vss-behavior-analytics-mc-tracking,nvstreamer-mc-tracking,bp-configurator-mc-tracking-init,bp-configurator-mc-tracking,reid-embed-init-mc-tracking,reid-etcd-mc-tracking,reid-minio-mc-tracking,reid-milvus-mc-tracking,reid-embed-mc-tracking,vss-rtvi-cv-bev-fusion-mc-tracking,vss-rtvi-cv-mc-tracking,mosquitto,sensor-ms-mc-tracking,streamprocessing-ms-mc-tracking,elasticsearch,elasticsearch-init-container,kibana,logstash,vss-haproxy-ingress,kibana-init-container-mc-tracking,vss-video-analytics-api-mc-tracking,import-calibration-output-container-mc-tracking,dcgm-exporter,prometheus,grafana,node-exporter,cadvisor

# Minimal variants (no ELK, Video Analytics API, HAProxy, monitoring, or import helpers)
COMPOSE_PROFILES_MC_TRACKING_KAFKA_MINIMAL=turnserver-init,turnserver,redis,init-dirs,render-config,wdm-env-from-config,wait-for-redis,wait-for-docker-workloads,sdr-controller,centralizedb,vst-ingress,sensor-bp-wait-bp-configurator,kafka,kafka-topic-init-container,broker-health-check,vss-behavior-analytics-mc-tracking,nvstreamer-mc-tracking,bp-configurator-mc-tracking-init,bp-configurator-mc-tracking,reid-embed-init-mc-tracking,reid-etcd-mc-tracking,reid-minio-mc-tracking,reid-milvus-mc-tracking,reid-embed-mc-tracking,vss-rtvi-cv-bev-fusion-mc-tracking,vss-rtvi-cv-mc-tracking,mosquitto,sensor-ms-mc-tracking,streamprocessing-ms-mc-tracking
COMPOSE_PROFILES_MC_TRACKING_REDIS_MINIMAL=turnserver-init,turnserver,redis,init-dirs,render-config,wdm-env-from-config,wait-for-redis,wait-for-docker-workloads,sdr-controller,centralizedb,vst-ingress,sensor-bp-wait-bp-configurator,broker-health-check,vss-behavior-analytics-mc-tracking,nvstreamer-mc-tracking,bp-configurator-mc-tracking-init,bp-configurator-mc-tracking,reid-embed-init-mc-tracking,reid-etcd-mc-tracking,reid-minio-mc-tracking,reid-milvus-mc-tracking,reid-embed-mc-tracking,vss-rtvi-cv-bev-fusion-mc-tracking,vss-rtvi-cv-mc-tracking,mosquitto,sensor-ms-mc-tracking,streamprocessing-ms-mc-tracking

# Playback variants
COMPOSE_PROFILES_MC_TRACKING_PLAYBACK_KAFKA=kafka,kafka-topic-init-container,broker-health-check,vss-behavior-analytics-mc-tracking,vss-behavior-analytics-playback-mc-tracking,elasticsearch,elasticsearch-init-container,kibana,logstash,vss-haproxy-ingress,kibana-init-container-mc-tracking,vss-video-analytics-api-mc-tracking,import-calibration-output-container-mc-tracking,dcgm-exporter,prometheus,grafana,node-exporter,cadvisor
COMPOSE_PROFILES_MC_TRACKING_PLAYBACK_REDIS=redis,broker-health-check,vss-behavior-analytics-mc-tracking,vss-behavior-analytics-playback-mc-tracking,elasticsearch,elasticsearch-init-container,kibana,logstash,vss-haproxy-ingress,kibana-init-container-mc-tracking,vss-video-analytics-api-mc-tracking,import-calibration-output-container-mc-tracking,dcgm-exporter,prometheus,grafana,node-exporter,cadvisor

# Active profile. Set this to one of the variants above; keep it matching STREAM_TYPE in .env.
# - COMPOSE_PROFILES_MC_TRACKING_{KAFKA,REDIS} for the full stack (matches STREAM_TYPE=kafka/redis).
# - COMPOSE_PROFILES_MC_TRACKING_{KAFKA,REDIS}_MINIMAL for minimal deployments.
# - COMPOSE_PROFILES_MC_TRACKING_PLAYBACK_{KAFKA,REDIS} for playback-only deployments.
COMPOSE_PROFILES=${COMPOSE_PROFILES_MC_TRACKING_KAFKA}
