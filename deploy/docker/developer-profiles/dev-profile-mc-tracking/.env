# Runtime/profile values modified by dev-profile.sh live in overrides.env.
# dev-profile.sh generates generated.env from overrides.env and passes it after this file.

# =============================================================================
# PROFILE STATIC DEFAULTS
# =============================================================================
# Values in this section are not rewritten by dev-profile.sh for this profile.
MODE=mc-tracking
PERCEPTION_TAG="3.3.0-26.07.2"
# PERCEPTION_TAG="3.3.0-sbsa-26.07.2"

# =============================================================================
# DEV-PROFILE-MC-TRACKING ENVIRONMENT CONFIGURATION
# =============================================================================
# This file contains environment variables for the developer multi-camera
# tracking (mc-tracking) profile: multi-camera 3D person/forklift tracking
# with BEV fusion, calibration import, and behavior analytics — no VSS
# Agent, agent UI, LLM NIM, or VLM NIM services (per MCT-FND-006).
#
# Profile variants:
#   mc-tracking: bp_developer_mc-tracking
# =============================================================================

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================
# Blueprint profile for the developer mc-tracking compose services.
BP_PROFILE=bp_developer_mc-tracking

# =============================================================================
# HARDWARE CONFIGURATION
# =============================================================================
# GPU IDs used by perception / BEV fusion / nvstreamer services. This profile
# is not expected to run concurrently with another profile on the same host,
# so these defaults are unscoped.
RT_CV_DEVICE_ID='0'

# =============================================================================
# ELASTICSEARCH CONFIGURATION
# =============================================================================
# Elasticsearch ILM policy retention period.
ELASTICSEARCH_ILM_MIN_AGE=4h
# Dense vector embeddings are not used by this profile.
ELASTICSEARCH_ENABLE_EMBEDDINGS=false

# =============================================================================
# MESSAGE BROKER CONFIGURATION
# =============================================================================
# Message broker type: kafka or redis. See overrides.env COMPOSE_PROFILES for
# the matching service set.
STREAM_TYPE=kafka

# Number of concurrent camera streams to process.
NUM_STREAMS=4

# MQTT broker used for cross-camera messaging.
MQTT_HOST=mosquitto
MQTT_PORT=1883

# =============================================================================
# NVSTREAMER CONFIGURATION
# =============================================================================
# Install additional packages for audio, software encoding, file upload.
NVSTREAMER_INSTALL_ADDITIONAL_PACKAGES=true

# NvStreamer HTTP port inside the Compose network. Host port overrides live in overrides.env.
NVSTREAMER_HTTP_PORT=31000

# Nvstreamer host used by bp-configurator-mc-tracking.
NVSTREAMER_IP=vss-vios-nvstreamer-mc-tracking # Compose service DNS name; override with a host/IP for an external Nvstreamer

# =============================================================================
# VST TURN / WEBRTC RELAY
# =============================================================================
TURN_PORT=3478
TURN_MIN_RELAY_PORT=49160
TURN_MAX_RELAY_PORT=49200
TURN_REALM=vss.local
# TURN_USERNAME is not secret. The password is generated once in the vss-turn-password Docker volume by turnserver-init.
TURN_USERNAME=vss
TURN_PASSWORD_BYTES=32
# Optional override for external or multiple TURN endpoints. Leave empty for the bundled turnserver.
VST_STATIC_TURNURL_LIST=

# =============================================================================
# VST PROFILE CONFIGURATION
# =============================================================================
# This profile uses SDRC; services/vios/vst.env defaults to direct VST mode.
VST_USE_SDRC=true
STREAM_PROCESSOR_MODULE_ENDPOINT=http://sdr-controller:10000
VST_NGINX_MODE=vst-sdrc
VST_IP=vst-ingress # Compose service DNS name; override with a host/IP for an external VST

# =============================================================================
# BP CONFIGURATOR CONFIGURATION
# =============================================================================
# Enable/disable the profile configurator. Set to true to enable, false to disable.
ENABLE_PROFILE_CONFIGURATOR=true
# Blueprint profile configurator config file for this profile (relative to blueprint-configurator/).
CONFIGURATOR_CONFIG_FILE="blueprint_config.yml"

# =============================================================================
# VIDEO ANALYTICS SERVICES CONFIGURATION
# =============================================================================
VIDEO_ANALYTICS_UI_APP_NAME=mc-tracking
