    "export:prompts": "node --experimental-strip-types scripts/export-prompts.mjs",
    "clean": "rm -rf .next"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
