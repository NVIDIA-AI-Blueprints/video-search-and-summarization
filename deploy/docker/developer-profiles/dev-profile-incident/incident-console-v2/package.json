{
  "name": "incident-console-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 --port 3200",
    "build": "next build",
    "start": "next start -H 127.0.0.1 --port 3200",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && tsc --noEmit",
    "format": "biome format --write .",
