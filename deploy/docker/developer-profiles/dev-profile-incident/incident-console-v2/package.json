    "@shadcn/react": "^0.3.1",
    "ajv": "^8.20.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "ffmpeg-static": "5.3.0",
    "lucide-react": "^1.63.0",
    "next": "15.5.18",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.15.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "18.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "8.5.10",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3"
  }
