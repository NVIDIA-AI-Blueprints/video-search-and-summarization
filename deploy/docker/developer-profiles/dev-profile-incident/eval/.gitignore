# Local Python environment and caches
.venv/
__pycache__/
*.pyc

# Untracked local secrets (symlink to ../../.env.local)
.env.local

# P1/RP1 evaluation working data: real (not demo) ground-truth Excel, split
# manifests, cached R2 video downloads, and result JSON/CSV. Never committed -
# see prompts.py and scripts/eval_*.py. The small split manifests themselves
# are tracked separately under eval_reproducibility/.
eval_data/

# Ground-truth review workbooks (PR 3/4): real annotations and annotator names, so
# deliberately not committed. Their hashes and the generator are tracked; see
# ground_truth/review/README.md (Storage) for where they live and how to rebuild them.
ground_truth/review/*.xlsx
ground_truth/review/~$*
ground_truth/review/backups/
# AI video-review proposals (PR 4): they quote and rewrite annotation text, so they stay local
# like the workbooks. Their SHA-256 and counts are in candidate-<version>-manifest.json.
ground_truth/review/ai-proposals-*.jsonl
# Review-package overrides (suggested pronoun fixes, case notes) quote annotation text too.
ground_truth/review/review-overrides-*.json
# AI-assisted adjudication records (gt-adjudication-v1.0) quote and rewrite annotation text: local only.
ground_truth/review/ai-adjudication-*.jsonl

# The repository root ignores "*checkpoint.*" (model checkpoints). Evaluation V2's checkpoint module is source code.
!evalv2/core/checkpoint.py
