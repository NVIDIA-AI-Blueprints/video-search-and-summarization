      "max_attempts": 2600,
      "max_tokens": 1750000
    },
    {
      "ledger": "caption",
      "subject": "super-pipeline",
      "task": "pipeline",
      "max_attempts": 750,
      "max_tokens": 1000000
    },
    {
      "ledger": "inference",
