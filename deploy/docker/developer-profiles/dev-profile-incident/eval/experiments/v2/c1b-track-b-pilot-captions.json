{
  "config_version": "evalv2-config-v1",
  "experiment": "v2-c1b-track-b-pilot-captions",
  "split": {
    "version": "split-v2",
    "half": "dev"
  },
  "datasets": {
    "incident_gt": "ground-truth-v1.0"
  },
  "subjects": [
    {
      "id": "nano-pipeline",
      "adapter": "vss",
      "endpoint": "experiment-agent",
      "model": "nvidia/cosmos-3-nano-reasoner",
      "profile": "production-v4-captions"
    },
    {
      "id": "super-pipeline",
      "adapter": "vss",
      "endpoint": "experiment-agent",
      "model": "nvidia/cosmos-3-super-reasoner",
      "profile": "production-v4-captions"
    }
  ],
  "tasks": {
    "pipeline": {
      "subjects": "all",
      "scorers": [
        "pipeline.score_stage@1",
        "pipeline.paired_effect@1",
        "pipeline.crops@1",
        "pipeline.caption_effect@1"
      ],
      "options": {
        "judges": {
          "primary": "catalog-gpt-oss-20b-v1",
          "sensitivity": "catalog-mistral-large-4-v1"
        }
      }
    }
  },
  "repeats": 1,
  "seed": 20261101,
  "retry_policy": "retry-v2",
  "caps": [
    {
      "ledger": "inference",
      "subject": "nano-pipeline",
      "task": "pipeline",
      "max_attempts": 65,
      "max_tokens": 750000
    },
    {
      "ledger": "grounding",
      "subject": "nano-pipeline",
      "task": "pipeline",
      "max_attempts": 1300,
      "max_tokens": 1000000
    },
    {
      "ledger": "zoom",
      "subject": "nano-pipeline",
      "task": "pipeline",
      "max_attempts": 2600,
      "max_tokens": 1750000
    },
    {
      "ledger": "caption",
      "subject": "nano-pipeline",
      "task": "pipeline",
      "max_attempts": 750,
      "max_tokens": 1000000
    },
    {
      "ledger": "inference",
      "subject": "super-pipeline",
      "task": "pipeline",
      "max_attempts": 65,
      "max_tokens": 750000
    },
    {
      "ledger": "grounding",
      "subject": "super-pipeline",
      "task": "pipeline",
      "max_attempts": 1300,
      "max_tokens": 1000000
    },
    {
      "ledger": "zoom",
