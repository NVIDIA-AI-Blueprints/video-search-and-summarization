{
  "config_version": "evalv2-config-v1",
  "experiment": "v2-c1a-track-a-pilot",
  "split": {
    "version": "split-v2",
    "half": "dev"
  },
  "datasets": {
    "incident_gt": "ground-truth-v1.0"
  },
  "subjects": [
    {
      "id": "nano-direct",
      "adapter": "openai_compat",
      "endpoint": "switchyard",
      "model": "nvidia/cosmos-3-nano-reasoner"
    },
    {
      "id": "super-direct",
      "adapter": "openai_compat",
      "endpoint": "switchyard",
      "model": "nvidia/cosmos-3-super-reasoner"
    },
    {
      "id": "omni-direct",
      "adapter": "openai_compat",
      "endpoint": "switchyard",
      "model": "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning"
    }
  ],
  "tasks": {
    "incident_objects": {
      "subjects": "all",
      "scorers": [
        "incident_objects.score_video@1",
        "incident_objects.aggregate@1"
      ],
      "options": {
        "judges": {
          "primary": "catalog-gpt-oss-20b-v1",
          "sensitivity": "catalog-mistral-large-4-v1"
        }
      }
    }
  },
  "repeats": 2,
  "seed": 20261101,
  "retry_policy": "retry-v2",
  "caps": [
    {
      "ledger": "inference",
      "subject": "nano-direct",
      "task": "incident_objects",
      "max_attempts": 65,
      "max_tokens": 2000000
    },
    {
      "ledger": "inference",
      "subject": "super-direct",
      "task": "incident_objects",
      "max_attempts": 65,
      "max_tokens": 2000000
    },
    {
      "ledger": "inference",
      "subject": "omni-direct",
      "task": "incident_objects",
      "max_attempts": 65,
      "max_tokens": 2000000
    },
    {
      "ledger": "inference",
      "subject": "*",
      "task": "*",
      "max_attempts": 195,
      "max_tokens": 6000000
    },
    {
      "ledger": "judge",
      "subject": "*",
      "task": "*",
      "max_attempts": 1100,
      "max_tokens": 1650000
    }
  ],
  "notes": "C1a Track A pilot (methodology v2.0 section 2): the production v4 P1 request, alone, to three video models on Switchyard; 25 dev clips x 2 repeats = 50 P1 calls per subject, 150 in all. Dev only (purpose pilot). budget_mode hard_stop: the caps are the owner-approved budget (6 M inference tokens for the run, a third per subject; 195 attempts leaves 30% for retries), below the pessimistic worst case (every attempt at 35,000 tokens, every retry taken), so the ledger refuses any attempt that would pass a cap before sending it. Typical use is about 1.9 M tokens. The judge cap is this run's share of the approved judge budget (2,000 calls, 3 M tokens over every scoring stage). Launch, marker and scoring: methodology/v2-run-readiness.md.",
  "purpose": "pilot",
  "budget_mode": "hard_stop"
}
