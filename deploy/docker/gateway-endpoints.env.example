# Optional native Docker Compose overlay for routing agent-facing downstream
# service URLs through the canonical VSS gateway.
#
# Pass this file after the profile .env and overrides.env files. For same-bridge
# validation, HAProxy publishes VSS_GATEWAY_HOST as a Docker network alias.
#
# VSS_GATEWAY_ORIGIN and VSS_GATEWAY_ORIGIN_FALLBACK are profile-level values.
# When VSS_GATEWAY_ORIGIN is blank, the endpoints below use the profile fallback.

# Agent-to-downstream service endpoints derive from the same gateway origin so
# agent egress stays tied to one placement-neutral contract.
PHOENIX_ENDPOINT=${VSS_GATEWAY_ORIGIN:-${VSS_GATEWAY_ORIGIN_FALLBACK}}/phoenix
VIDEO_ANALYSIS_MCP_URL=${VSS_GATEWAY_ORIGIN:-${VSS_GATEWAY_ORIGIN_FALLBACK}}/va-mcp
ALERT_BRIDGE_URL=${VSS_GATEWAY_ORIGIN:-${VSS_GATEWAY_ORIGIN_FALLBACK}}/alert-bridge
VST_INTERNAL_URL=${VSS_GATEWAY_ORIGIN:-${VSS_GATEWAY_ORIGIN_FALLBACK}}/vst
RTVI_VLM_BASE_URL=${VSS_GATEWAY_ORIGIN:-${VSS_GATEWAY_ORIGIN_FALLBACK}}/rtvi-vlm
RTVI_CV_ENDPOINT=${VSS_GATEWAY_ORIGIN:-${VSS_GATEWAY_ORIGIN_FALLBACK}}/rtvi-cv
COSMOS_EMBED_ENDPOINT=${VSS_GATEWAY_ORIGIN:-${VSS_GATEWAY_ORIGIN_FALLBACK}}/rtvi-embed
ELASTIC_SEARCH_ENDPOINT=${VSS_GATEWAY_ORIGIN:-${VSS_GATEWAY_ORIGIN_FALLBACK}}/elasticsearch
LVS_BACKEND_URL=${VSS_GATEWAY_ORIGIN:-${VSS_GATEWAY_ORIGIN_FALLBACK}}/lvs

# Agent-generated VST links also use the gateway origin when the agent is no
# longer on the VST bridge network.
VST_EXTERNAL_URL=${VSS_GATEWAY_ORIGIN:-${VSS_GATEWAY_ORIGIN_FALLBACK}}/vst
VST_BASE_URL=${VSS_GATEWAY_ORIGIN:-${VSS_GATEWAY_ORIGIN_FALLBACK}}/vst
