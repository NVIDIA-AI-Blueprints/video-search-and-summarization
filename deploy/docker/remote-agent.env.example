# Copy this file outside the checkout, replace every <...> value, and pass it
# after the selected profile's .env and overrides.env files.
#
# This origin must be reachable from the remote agent host. vss.local is a
# bridge-only alias and must never be used here. A directly reachable VSS host
# normally uses http://<HOST_IP>:7777; a deployment behind external ingress may
# use its public origin instead.
VSS_GATEWAY_HOST=<VSS_HOST_IP_OR_DNS>
VSS_GATEWAY_PORT=7777
VSS_GATEWAY_ORIGIN=http://${VSS_GATEWAY_HOST}:${VSS_GATEWAY_PORT}
VSS_PUBLIC_URL=${VSS_GATEWAY_ORIGIN}

# The path contract is identical to a colocated deployment:
#   ${VSS_GATEWAY_ORIGIN}/va-mcp
#   ${VSS_GATEWAY_ORIGIN}/vst
#   ${VSS_GATEWAY_ORIGIN}/elasticsearch
#   ${VSS_GATEWAY_ORIGIN}/alert-bridge
#   ${VSS_GATEWAY_ORIGIN}/lvs
# The agent compose definition derives its service URLs from the origin above.
HOST_IP=${VSS_GATEWAY_HOST}
EXTERNAL_IP=${VSS_GATEWAY_HOST}
INTERNAL_IP=${VSS_GATEWAY_HOST}:${VSS_GATEWAY_PORT}
VST_BASE_URL=${VSS_PUBLIC_URL}
VST_EXTERNAL_URL=${VSS_PUBLIC_URL}
VSS_AGENT_EXTERNAL_URL=${VSS_PUBLIC_URL}
VSS_AGENT_REPORTS_BASE_URL=${VSS_PUBLIC_URL}/static/

# Paths on the remote agent host, not on the VSS deployment host.
VSS_APPS_DIR=/absolute/path/to/video-search-and-summarization/deploy/docker
VSS_DATA_DIR=/absolute/path/to/remote-agent-data

# Model APIs are not gateway mounts. Override profile-local Docker DNS defaults
# with endpoints reachable from this host when the chosen workflow uses them.
LLM_MODE=remote
LLM_NAME_SLUG=none
LLM_BASE_URL=<REMOTE_LLM_OR_NIM_ORIGIN>
EVAL_LLM_JUDGE_BASE_URL=${LLM_BASE_URL}
VLM_MODE=remote
VLM_NAME_SLUG=none
VLM_BASE_URL=<REMOTE_VLM_OR_NIM_ORIGIN>
RAG_SERVER_URL=<REMOTE_RAG_ORIGIN>

# Brev is the intentional two-origin exception. Containers in the deployment
# still use http://vss.local:7777. A remote agent and host-side CLI use the
# externally reachable VSS_PUBLIC_URL (normally the Brev HTTPS secure link).
# Set both values below to that secure-link origin; do not point either at
# vss.local and do not change the colocated deployment's gateway origin.
# VSS_GATEWAY_ORIGIN=https://7777-<BREV_ENV_ID>.brevlab.com
# VSS_PUBLIC_URL=${VSS_GATEWAY_ORIGIN}
