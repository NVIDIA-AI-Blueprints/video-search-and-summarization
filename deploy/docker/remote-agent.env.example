# Copy this file outside the checkout, replace every <...> value, and pass it
# after the selected profile's .env and overrides.env files.
#
# Compose resolves the lines below in order, so a variable only picks up values
# defined above it. Everything here is derived from one origin, set once, for
# that reason: reassigning the origin further down would leave the lines above
# it on the old value.
#
# This origin must be reachable from the remote agent host. vss.local is a
# bridge-only alias and must never be used here. A directly reachable VSS host
# normally uses http://<HOST_IP>:7777.
#
# Behind external ingress, use that public origin instead -- on Brev, the HTTPS
# secure link, e.g. https://7777-<BREV_ENV_ID>.brevlab.com. Brev is the
# intentional two-origin exception: containers inside the deployment keep using
# http://vss.local:7777, and only an off-bridge caller such as this agent or the
# host-side CLI uses the secure link. Replace the whole line; do not add a
# second assignment below, and do not change the colocated deployment's gateway
# origin.
#
# Whatever origin you put here, the deployment has to recognise it: its Host
# ACLs are an allowlist and a hostname it was never told about returns 404 on
# every path. An IP already covered by HOST_IP needs nothing; a DNS name or a
# secure link has to be set as VSS_PUBLIC_HOST on the deployment side.
VSS_GATEWAY_ORIGIN=http://<VSS_HOST_IP_OR_DNS>:7777

# Host and port are read back out of the origin by the validation snippet in
# deploy/docker/README.md and by the Host ACLs, so they must agree with it.
VSS_GATEWAY_HOST=<VSS_HOST_IP_OR_DNS>
VSS_GATEWAY_PORT=7777
VSS_PUBLIC_URL=${VSS_GATEWAY_ORIGIN}

# The path contract is identical to a colocated deployment:
#   ${VSS_GATEWAY_ORIGIN}/va-mcp
#   ${VSS_GATEWAY_ORIGIN}/vst
#   ${VSS_GATEWAY_ORIGIN}/elasticsearch
#   ${VSS_GATEWAY_ORIGIN}/alert-bridge
#   ${VSS_GATEWAY_ORIGIN}/lvs
# The agent compose definition derives its service URLs from the origin above.
HOST_IP=${VSS_GATEWAY_HOST}
EXTERNAL_IP=${VSS_GATEWAY_HOST}
INTERNAL_IP=${VSS_GATEWAY_HOST}:${VSS_GATEWAY_PORT}
VST_BASE_URL=${VSS_PUBLIC_URL}
VST_EXTERNAL_URL=${VSS_PUBLIC_URL}
VSS_AGENT_EXTERNAL_URL=${VSS_PUBLIC_URL}
VSS_AGENT_REPORTS_BASE_URL=${VSS_PUBLIC_URL}/static/

# A remote agent is not behind the deployment's gateway, so the peers that
# reach its HTTP port are whatever the remote host exposes it to -- not HAProxy.
# The colocated default trusts the private ranges a Docker bridge is drawn from,
# which on this host means something other than the gateway. Name the reverse
# proxy in front of this agent, or keep the line as it is to honour no
# forwarded scheme at all. See "The scheme the caller used" in
# deploy/docker/README.md.
VSS_AGENT_FORWARDED_ALLOW_IPS=127.0.0.1

# Paths on the remote agent host, not on the VSS deployment host.
VSS_APPS_DIR=/absolute/path/to/video-search-and-summarization/deploy/docker
VSS_DATA_DIR=/absolute/path/to/remote-agent-data

# Model APIs are not gateway mounts. Override profile-local Docker DNS defaults
# with endpoints reachable from this host when the chosen workflow uses them.
LLM_MODE=remote
LLM_NAME_SLUG=none
LLM_BASE_URL=<REMOTE_LLM_OR_NIM_ORIGIN>
EVAL_LLM_JUDGE_BASE_URL=${LLM_BASE_URL}
VLM_MODE=remote
VLM_NAME_SLUG=none
VLM_BASE_URL=<REMOTE_VLM_OR_NIM_ORIGIN>
RAG_SERVER_URL=<REMOTE_RAG_ORIGIN>
