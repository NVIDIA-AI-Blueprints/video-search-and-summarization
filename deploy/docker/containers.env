# =============================================================================
# CONTAINERS.ENV — single source of truth for first-party container coordinates
# =============================================================================
# Every first-party (vss-core/*) image referenced from deploy/docker consumes
# the variables defined here. Change a registry or tag in ONE place instead of
# editing ~30 compose files and dozens of .env files.
#
# HOW IT WORKS
#   * Each variable is `${VAR:-default}` so it can be overridden from the
#     environment without editing this file:
#       VSS_AGENT_UI_IMAGE=ghcr.io/... docker compose up
#   * Compose `image:` lines carry the SAME literal default inline, so behavior
#     is identical whether or not this file is sourced. This file is the knob;
#     the inline defaults are the safety net. A golden test
#     (.github/scripts/compose_image_golden.py) pins the resolved refs so the
#     two can never drift apart silently.
#   * Third-party / NIM images (nvcr.io/nim/*, vllm, postgres, redis, cadvisor,
#     etc.) are NOT first-party and are intentionally left pinned as-is.
#
# This file is a NO-BEHAVIOR-CHANGE foundation: every default below reproduces
# the coordinates committed on `develop` exactly, so `docker compose config`
# output is unchanged. Moving `develop` onto a GHCR release set is a separate,
# gated step; no workflow edits this file automatically.
#
# The machine-readable companion of this file is
# deploy/docker/container-inventory.json (logical name, source path, build
# strategy, platforms); .github/scripts/release_set.py validates that every
# first-party compose reference stays covered by the inventory.
# =============================================================================

# -----------------------------------------------------------------------------
# Registry roots
# -----------------------------------------------------------------------------
# Shared coordinates for the GitHub-managed image set: agent, UI, alert-ms, and
# video-summarization. Other first-party services retain their explicit
# per-image pins until they migrate to GitHub builds.
#   ghcr.io/nvidia-ai-blueprints/vss
#   nvcr.io/nv-metropolis-dev/met-moe-agents
#   nvcr.io/nvstaging/vss-core
VSS_CONTAINER_REGISTRY="${VSS_CONTAINER_REGISTRY:-ghcr.io/nvidia-ai-blueprints/vss}"
# Shared immutable/moving tag for the same managed set. QA overrides this pair
# to the promoted NGC staging prefix/tag.
VSS_CONTAINER_TAG="${VSS_CONTAINER_TAG:-develop-latest}"

# Default roots used only when the one-knob override is unset.
VSS_CONTAINER_RELEASE_REGISTRY="${VSS_CONTAINER_RELEASE_REGISTRY:-nvcr.io/nvidia/vss-core}"

# Staging root: images whose current develop pin is a source-stamped staging
# build (agent, UI, alert) rather than a released tag.
VSS_CONTAINER_STAGING_REGISTRY="${VSS_CONTAINER_STAGING_REGISTRY:-nvcr.io/nvstaging/vss-core}"

# -----------------------------------------------------------------------------
# Source-gated images (check-*-container-source verifies these against the
# current source tree; their tags are source-stamped `X.Y.Z-YY.MM.N-<treesha>`)
# -----------------------------------------------------------------------------
# Agent retains VSS_AGENT_VERSION for compatibility, but VSS_CONTAINER_TAG takes
# precedence for the managed release set.
VSS_AGENT_IMAGE="${VSS_AGENT_IMAGE:-${VSS_CONTAINER_REGISTRY:-${VSS_CONTAINER_STAGING_REGISTRY}}/vss-agent}"

VSS_AGENT_UI_IMAGE="${VSS_AGENT_UI_IMAGE:-${VSS_CONTAINER_REGISTRY:-${VSS_CONTAINER_STAGING_REGISTRY}}/vss-agent-ui}"
VSS_AGENT_UI_TAG="${VSS_AGENT_UI_TAG:-${VSS_CONTAINER_TAG:-3.2.1-26.07.1-dd945777eef9}}"

VSS_ALERT_IMAGE="${VSS_ALERT_IMAGE:-${VSS_CONTAINER_REGISTRY:-${VSS_CONTAINER_STAGING_REGISTRY}}/vss-alert-ms}"
VSS_ALERT_TAG="${VSS_ALERT_TAG:-${VSS_CONTAINER_TAG:-3.3.0-26.07.10-e4c886ba00e5}}"

# Analytics images joined the managed set when #1356 gave them GitHub-native
# GHCR builds. They follow VSS_CONTAINER_REGISTRY/VSS_CONTAINER_TAG exactly like
# the agent/UI/alert set; the inner fallback preserves the previous NGC
# coordinate for anyone who unsets the shared pair.
VSS_VIDEO_ANALYTICS_API_IMAGE="${VSS_VIDEO_ANALYTICS_API_IMAGE:-${VSS_CONTAINER_REGISTRY:-${VSS_CONTAINER_RELEASE_REGISTRY}}/vss-video-analytics-api}"
VSS_VIDEO_ANALYTICS_API_TAG="${VSS_VIDEO_ANALYTICS_API_TAG:-${VSS_CONTAINER_TAG:-3.2.0}}"

VSS_BEHAVIOR_ANALYTICS_IMAGE="${VSS_BEHAVIOR_ANALYTICS_IMAGE:-${VSS_CONTAINER_REGISTRY:-${VSS_CONTAINER_STAGING_REGISTRY}}/vss-behavior-analytics}"
VSS_BEHAVIOR_ANALYTICS_TAG="${VSS_BEHAVIOR_ANALYTICS_TAG:-${VSS_CONTAINER_TAG:-3.3.0-26.07.4}}"

VSS_RT_CV_MV3DT_BEV_FUSION_IMAGE="${VSS_RT_CV_MV3DT_BEV_FUSION_IMAGE:-${BEV_FUSION_MV3DT_IMAGE:-${VSS_CONTAINER_REGISTRY:-${VSS_CONTAINER_STAGING_REGISTRY}}/vss-rt-cv-mv3dt-bev-fusion}}"
VSS_RT_CV_MV3DT_BEV_FUSION_TAG="${VSS_RT_CV_MV3DT_BEV_FUSION_TAG:-${BEV_FUSION_MV3DT_TAG:-${VSS_CONTAINER_TAG:-develop-latest}}}"

# LVS keeps the combined CONTAINER_IMAGE knob (name and tag in one value) that
# its compose file and profile .env files already use.
CONTAINER_IMAGE="${CONTAINER_IMAGE:-${VSS_CONTAINER_REGISTRY}/vss-video-summarization:${VSS_CONTAINER_TAG}}"

# -----------------------------------------------------------------------------
# Released first-party images (fixed release tags today)
# -----------------------------------------------------------------------------

VSS_AUTO_CALIBRATION_IMAGE="${VSS_AUTO_CALIBRATION_IMAGE:-${VSS_CONTAINER_STAGING_REGISTRY}/vss-auto-calibration}"
VSS_AUTO_CALIBRATION_TAG="${VSS_AUTO_CALIBRATION_TAG:-3.3.0-1}"

VSS_AUTO_CALIBRATION_UI_IMAGE="${VSS_AUTO_CALIBRATION_UI_IMAGE:-${VSS_CONTAINER_STAGING_REGISTRY}/vss-auto-calibration-ui}"
VSS_AUTO_CALIBRATION_UI_TAG="${VSS_AUTO_CALIBRATION_UI_TAG:-3.3.0-1}"

VSS_CONFIGURATOR_IMAGE="${VSS_CONFIGURATOR_IMAGE:-${VSS_CONTAINER_STAGING_REGISTRY}/vss-configurator}"
VSS_CONFIGURATOR_TAG="${VSS_CONFIGURATOR_TAG:-3.3.0-2026.08.2-1}"

VSS_RT_CONFIG_ADAPTOR_IMAGE="${VSS_RT_CONFIG_ADAPTOR_IMAGE:-${VSS_CONTAINER_RELEASE_REGISTRY}/vss-rt-config-adaptor}"
VSS_RT_CONFIG_ADAPTOR_TAG="${VSS_RT_CONFIG_ADAPTOR_TAG:-3.2.0}"

# -----------------------------------------------------------------------------
# First-party images whose TAG variable already exists in profile .env files.
# Only the registry+name is centralized; the existing tag variables
# (NVSTREAMER_IMAGE_TAG, RTVI_VLM_IMAGE_TAG, CALIBRATION_TOOLKIT_IMAGE_TAG,
# VIDEO_ANALYTICS_UI_IMAGE_TAG) keep working unchanged.
# -----------------------------------------------------------------------------
VSS_NVSTREAMER_IMAGE="${VSS_NVSTREAMER_IMAGE:-${VSS_CONTAINER_STAGING_REGISTRY}/vss-vios-nvstreamer}"
VSS_RT_VLM_IMAGE="${VSS_RT_VLM_IMAGE:-${VSS_CONTAINER_STAGING_REGISTRY}/vss-rt-vlm}"
VSS_CALIBRATION_TOOLKIT_IMAGE="${VSS_CALIBRATION_TOOLKIT_IMAGE:-${VSS_CONTAINER_RELEASE_REGISTRY}/calibration}"
VSS_VIDEO_ANALYTICS_UI_IMAGE="${VSS_VIDEO_ANALYTICS_UI_IMAGE:-${VSS_CONTAINER_STAGING_REGISTRY}/vss-video-analytics-ui}"
RTVI_EMBED_IMAGE="${RTVI_EMBED_IMAGE:-${VSS_CONTAINER_STAGING_REGISTRY}/vss-rt-embed}"

# NOTE: external-pin images (rtvi-cv and sdr-mw-l) remain independently
# controlled because they are outside the VSS release set.
