# =============================================================================
# CONTAINERS.ENV — single source of truth for first-party container coordinates
# =============================================================================
# Every first-party (vss-core/*) image referenced from deploy/docker consumes
# the variables defined here. Change a registry or tag in ONE place instead of
# editing ~30 compose files and dozens of .env files.
#
# HOW IT WORKS
#   * Each variable is `${VAR:-default}` so it can be overridden from the
#     environment without editing this file:
#       VSS_AGENT_UI_IMAGE=ghcr.io/... docker compose up
#   * Load this file before the profile env files to select the release
#     registry. Compose inline defaults remain a safety net for standalone use.
#   * Third-party / NIM images (nvcr.io/nim/*, vllm, postgres, redis, cadvisor,
#     etc.) are NOT first-party and are intentionally left pinned as-is.
#
# All first-party images default to VSS_CONTAINER_REGISTRY. Individual
# image overrides take precedence. No workflow edits this file automatically;
# updates are reviewed as source changes.
#
# The machine-readable companion of this file is
# deploy/docker/container-inventory.json (logical name, source path, build
# strategy, platforms); .github/scripts/release_set.py validates that every
# first-party compose reference stays covered by the inventory.
# =============================================================================

# -----------------------------------------------------------------------------
# Shared registry
# -----------------------------------------------------------------------------
# Default registry for every first-party image below. Individual *_IMAGE
# overrides take precedence over this shared registry.
VSS_CONTAINER_REGISTRY="${VSS_CONTAINER_REGISTRY:-nvcr.io/nvidia/vss-core}"
# Shared tag for the managed image set.
VSS_CONTAINER_TAG="${VSS_CONTAINER_TAG:-3.3.0}"

# The version this deployment reports at GET /api/v1/version, served by the
# HAProxy edge for every profile. Written by .github/scripts/stamp_versions.py
# from the nearest v* git tag -- the same source the agent, the CLI and the
# skills are versioned from -- in a reviewed PR, never typed; CI's --check
# fails a PR that edits it by hand. Deliberately
# not `${VSS_VERSION:-...}`: a shell variable must not override it.
# See .github/version-convention.md.
VSS_VERSION="3.3.0"

# Image tag suffix for VSS_RT_EMBED_TAG, VSS_RT_CV_TAG, VSS_RT_VLM_TAG and VSS_VIDEO_SUMMARIZATION_TAG on sbsa platforms
# Set to -sbsa on SPARK, GB300 etc
VSS_CONTAINER_TAG_SUFFIX="${VSS_CONTAINER_TAG_SUFFIX:-}"

# Nothing here sets the version `GET /api/v1/version` reports: it is the
# installed nvidia-vss-core's, stamped into the image by build-dev-images.yml
# from the nearest v* git tag, and no deploy-time variable overrides it.

# -----------------------------------------------------------------------------
# Source-gated images (check-*-container-source verifies these against the
# current source content; migrated defaults use the shared managed tag)
# -----------------------------------------------------------------------------
# Agent retains VSS_AGENT_VERSION for compatibility, but VSS_CONTAINER_TAG takes
# precedence for the managed release set.
VSS_AGENT_IMAGE="${VSS_AGENT_IMAGE:-${VSS_CONTAINER_REGISTRY}/vss-agent}"

VSS_AGENT_UI_IMAGE="${VSS_AGENT_UI_IMAGE:-${VSS_CONTAINER_REGISTRY}/vss-agent-ui}"
VSS_AGENT_UI_TAG="${VSS_AGENT_UI_TAG:-${VSS_CONTAINER_TAG:-3.3.0}}"

VSS_ALERT_IMAGE="${VSS_ALERT_IMAGE:-${VSS_CONTAINER_REGISTRY}/vss-alert-ms}"
VSS_ALERT_TAG="${VSS_ALERT_TAG:-${VSS_CONTAINER_TAG:-3.3.0}}"

# Analytics images share the release registry and managed tag.
VSS_VIDEO_ANALYTICS_API_IMAGE="${VSS_VIDEO_ANALYTICS_API_IMAGE:-${VSS_CONTAINER_REGISTRY}/vss-video-analytics-api}"
VSS_VIDEO_ANALYTICS_API_TAG="${VSS_VIDEO_ANALYTICS_API_TAG:-${VSS_CONTAINER_TAG:-3.3.0}}"

VSS_BEHAVIOR_ANALYTICS_IMAGE="${VSS_BEHAVIOR_ANALYTICS_IMAGE:-${VSS_CONTAINER_REGISTRY}/vss-behavior-analytics}"
VSS_BEHAVIOR_ANALYTICS_TAG="${VSS_BEHAVIOR_ANALYTICS_TAG:-${VSS_CONTAINER_TAG:-3.3.0}}"

VSS_RT_CV_IMAGE="${VSS_RT_CV_IMAGE:-${VSS_CONTAINER_REGISTRY}/vss-rt-cv}"
VSS_RT_CV_TAG="${VSS_RT_CV_TAG:-${VSS_CONTAINER_TAG:-3.3.0}${VSS_CONTAINER_TAG_SUFFIX:-}}"

VSS_CONFIGURATOR_IMAGE="${VSS_CONFIGURATOR_IMAGE:-${VSS_CONTAINER_REGISTRY}/vss-configurator}"
VSS_CONFIGURATOR_TAG="${VSS_CONFIGURATOR_TAG:-${VSS_CONTAINER_TAG:-3.3.0}}"

VSS_RT_CONFIG_ADAPTOR_IMAGE="${VSS_RT_CONFIG_ADAPTOR_IMAGE:-${VSS_CONTAINER_REGISTRY}/vss-rt-config-adaptor}"
VSS_RT_CONFIG_ADAPTOR_TAG="${VSS_RT_CONFIG_ADAPTOR_TAG:-${VSS_CONTAINER_TAG:-3.3.0}}"

VSS_RT_CV_MV3DT_BEV_FUSION_IMAGE="${VSS_RT_CV_MV3DT_BEV_FUSION_IMAGE:-${VSS_CONTAINER_REGISTRY}/vss-rt-cv-mv3dt-bev-fusion}"
VSS_RT_CV_MV3DT_BEV_FUSION_TAG="${VSS_RT_CV_MV3DT_BEV_FUSION_TAG:-${VSS_CONTAINER_TAG:-3.3.0}}"

# MV3DT config-init runs once at pod/stack start to generate camInfo and the
# pub/sub topology from calibration, then exits. Compose keeps it behind the
# `dynamic-config` profile; Helm behind standaloneWarehouse.mv3dt.dynamicCameraConfig.
VSS_RT_CV_MV3DT_CONFIG_INIT_IMAGE="${VSS_RT_CV_MV3DT_CONFIG_INIT_IMAGE:-${VSS_CONTAINER_REGISTRY}/vss-rt-cv-mv3dt-config-init}"
VSS_RT_CV_MV3DT_CONFIG_INIT_TAG="${VSS_RT_CV_MV3DT_CONFIG_INIT_TAG:-${VSS_CONTAINER_TAG:-3.3.0}}"

VSS_RT_EMBED_IMAGE="${VSS_RT_EMBED_IMAGE:-${VSS_CONTAINER_REGISTRY}/vss-rt-embed}"
VSS_RT_EMBED_TAG="${VSS_RT_EMBED_TAG:-${VSS_CONTAINER_TAG:-3.3.0}${VSS_CONTAINER_TAG_SUFFIX:-}}"

# SDRC keeps the full image override for compatibility with existing profile
# env files and scripts that set SDR_MW_L_IMAGE directly.
SDR_MW_L_IMAGE="${SDR_MW_L_IMAGE:-${VSS_CONTAINER_REGISTRY}/sdr-mw-l:${VSS_CONTAINER_TAG:-3.3.0}}"

# -----------------------------------------------------------------------------
# Released first-party images
# -----------------------------------------------------------------------------

# Auto-calibration is Docker-only by design: there is no chart at
# deploy/helm/services/auto-calibration/ and no file under deploy/helm/
# references vss-auto-calibration or vss-auto-calibration-ui. The similarly
# named calibration-import and calibration-toolkit charts are unrelated
# services on different images. These tags therefore have no helm counterpart
# to keep in sync, and helm parity is not expected for this service.
VSS_AUTO_CALIBRATION_IMAGE="${VSS_AUTO_CALIBRATION_IMAGE:-${VSS_CONTAINER_REGISTRY}/vss-auto-calibration}"
VSS_AUTO_CALIBRATION_TAG="${VSS_AUTO_CALIBRATION_TAG:-${VSS_CONTAINER_TAG:-3.3.0}}"

VSS_AUTO_CALIBRATION_UI_IMAGE="${VSS_AUTO_CALIBRATION_UI_IMAGE:-${VSS_CONTAINER_REGISTRY}/vss-auto-calibration-ui}"
VSS_AUTO_CALIBRATION_UI_TAG="${VSS_AUTO_CALIBRATION_UI_TAG:-${VSS_CONTAINER_TAG:-3.3.0}}"

# -----------------------------------------------------------------------------
# First-party images with centralized registry/name variables. Per-image
# overrides take precedence over the release registry and shared tag.
# -----------------------------------------------------------------------------
# VIOS images share the release registry and managed tag.
VSS_VIOS_SENSOR_IMAGE="${VSS_VIOS_SENSOR_IMAGE:-${VSS_CONTAINER_REGISTRY}/vss-vios-sensor}"
VSS_VIOS_SENSOR_TAG="${VSS_VIOS_SENSOR_TAG:-${VSS_CONTAINER_TAG:-3.3.0}}"

VSS_VIOS_STREAMPROCESSING_IMAGE="${VSS_VIOS_STREAMPROCESSING_IMAGE:-${VSS_CONTAINER_REGISTRY}/vss-vios-streamprocessing}"
VSS_VIOS_STREAMPROCESSING_TAG="${VSS_VIOS_STREAMPROCESSING_TAG:-${VSS_CONTAINER_TAG:-3.3.0}}"

# NVStreamer uses the same release registry and managed tag as other VIOS images.
VSS_NVSTREAMER_IMAGE="${VSS_NVSTREAMER_IMAGE:-${VSS_CONTAINER_REGISTRY}/vss-vios-nvstreamer}"
VSS_NVSTREAMER_TAG="${VSS_NVSTREAMER_TAG:-${VSS_CONTAINER_TAG:-3.3.0}}"

VSS_VIOS_INGRESS_IMAGE="${VSS_VIOS_INGRESS_IMAGE:-${VSS_CONTAINER_REGISTRY}/vss-vios-ingress}"
VSS_VIOS_INGRESS_TAG="${VSS_VIOS_INGRESS_TAG:-${VSS_CONTAINER_TAG:-3.3.0}}"
# RT-VLM uses the release registry and managed tag.
VSS_RT_VLM_IMAGE="${VSS_RT_VLM_IMAGE:-${VSS_CONTAINER_REGISTRY}/vss-rt-vlm}"
VSS_RT_VLM_TAG="${VSS_RT_VLM_TAG:-${VSS_CONTAINER_TAG:-3.3.0}${VSS_CONTAINER_TAG_SUFFIX:-}}"
# Video Summarization uses the release registry and managed tag.
VSS_VIDEO_SUMMARIZATION_IMAGE="${VSS_VIDEO_SUMMARIZATION_IMAGE:-${VSS_CONTAINER_REGISTRY}/vss-video-summarization}"
VSS_VIDEO_SUMMARIZATION_TAG="${VSS_VIDEO_SUMMARIZATION_TAG:-${VSS_CONTAINER_TAG:-3.3.0}${VSS_CONTAINER_TAG_SUFFIX:-}}"

VSS_CALIBRATION_TOOLKIT_IMAGE="${VSS_CALIBRATION_TOOLKIT_IMAGE:-${VSS_CONTAINER_REGISTRY}/calibration}"
CALIBRATION_TOOLKIT_IMAGE_TAG="${CALIBRATION_TOOLKIT_IMAGE_TAG:-${VSS_CONTAINER_TAG:-3.3.0}}"
VSS_VIDEO_ANALYTICS_UI_IMAGE="${VSS_VIDEO_ANALYTICS_UI_IMAGE:-${VSS_CONTAINER_REGISTRY}/vss-video-analytics-ui}"
VIDEO_ANALYTICS_UI_IMAGE_TAG="${VIDEO_ANALYTICS_UI_IMAGE_TAG:-${VSS_CONTAINER_TAG:-3.3.0}}"

# ReID embed is Docker-only today (warehouse MV3DT profile). Source is not in
# this repo; Compose inline defaults match these pins. Override either variable
# from generated.env without editing the profile compose file.
VSS_REID_EMBED_IMAGE="${VSS_REID_EMBED_IMAGE:-${VSS_CONTAINER_REGISTRY}/reid-embed}"
VSS_REID_EMBED_TAG="${VSS_REID_EMBED_TAG:-${VSS_CONTAINER_TAG:-3.3.0}}"

# NOTE: the external-pin image rtvi-cv remains independently controlled because
# it is outside the VSS release set. MV3DT BEV Fusion joined the managed set
# above when it gained a GitHub-native GHCR build.
