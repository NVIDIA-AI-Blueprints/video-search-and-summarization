# =============================================================================
# CONTAINERS.ENV — single source of truth for first-party container coordinates
# =============================================================================
# Every first-party (vss-core/*) image referenced from deploy/docker consumes
# the variables defined here. Change a registry or tag in ONE place instead of
# editing ~30 compose files and dozens of .env files.
#
# HOW IT WORKS
#   * Each variable is `${VAR:-default}` so it can be overridden from the
#     environment without editing this file:
#       VSS_AGENT_UI_IMAGE=ghcr.io/... docker compose up
#   * Compose `image:` lines carry the SAME literal default inline, so behavior
#     is identical whether or not this file is sourced. This file is the knob;
#     the inline defaults are the safety net. A golden test
#     (.github/scripts/compose_image_golden.py) pins the resolved refs so the
#     two can never drift apart silently.
#   * Third-party / NIM images (nvcr.io/nim/*, vllm, postgres, redis, cadvisor,
#     etc.) are NOT first-party and are intentionally left pinned as-is.
#
# This file is a NO-BEHAVIOR-CHANGE foundation: every default below reproduces
# the coordinates committed on `develop` exactly, so `docker compose config`
# output is unchanged. Moving `develop` onto a GHCR release set is a separate,
# gated step (see docs/proposals/container-dev-and-release-workflow.md); no
# workflow edits this file automatically.
#
# The machine-readable companion of this file is
# deploy/docker/container-inventory.json (logical name, source path, build
# strategy, platforms); .github/scripts/release_set.py validates that every
# first-party compose reference stays covered by the inventory.
# =============================================================================

# -----------------------------------------------------------------------------
# Registry roots
# -----------------------------------------------------------------------------
# Released first-party images.
VSS_CONTAINER_REGISTRY="${VSS_CONTAINER_REGISTRY:-nvcr.io/nvidia/vss-core}"

# Staging root: images whose current develop pin is a source-stamped staging
# build (agent, UI, alert) rather than a released tag.
VSS_CONTAINER_STAGING_REGISTRY="${VSS_CONTAINER_STAGING_REGISTRY:-nvcr.io/nvstaging/vss-core}"

# -----------------------------------------------------------------------------
# Source-gated images (check-*-container-source verifies these against the
# current source tree; their tags are source-stamped `X.Y.Z-YY.MM.N-<treesha>`)
# -----------------------------------------------------------------------------
# Agent keeps its own tag variable (VSS_AGENT_VERSION, set per profile .env).
# Migration to a normalized VSS_AGENT_TAG is tracked in the proposal doc; only
# the registry+name is centralized here. The current pin is promoted to the
# staging registry.
VSS_AGENT_IMAGE="${VSS_AGENT_IMAGE:-${VSS_CONTAINER_STAGING_REGISTRY}/vss-agent}"

VSS_AGENT_UI_IMAGE="${VSS_AGENT_UI_IMAGE:-${VSS_CONTAINER_STAGING_REGISTRY}/vss-agent-ui}"
VSS_AGENT_UI_TAG="${VSS_AGENT_UI_TAG:-3.2.1-26.07.1-dd945777eef9}"

VSS_ALERT_IMAGE="${VSS_ALERT_IMAGE:-${VSS_CONTAINER_STAGING_REGISTRY}/vss-alert-ms}"
VSS_ALERT_TAG="${VSS_ALERT_TAG:-3.3.0-26.07.10-e4c886ba00e5}"

# -----------------------------------------------------------------------------
# Released first-party images (fixed release tags today)
# -----------------------------------------------------------------------------
VSS_VIDEO_ANALYTICS_API_IMAGE="${VSS_VIDEO_ANALYTICS_API_IMAGE:-${VSS_CONTAINER_REGISTRY}/vss-video-analytics-api}"
VSS_VIDEO_ANALYTICS_API_TAG="${VSS_VIDEO_ANALYTICS_API_TAG:-3.2.0}"

VSS_BEHAVIOR_ANALYTICS_IMAGE="${VSS_BEHAVIOR_ANALYTICS_IMAGE:-${VSS_CONTAINER_STAGING_REGISTRY}/vss-behavior-analytics}"
VSS_BEHAVIOR_ANALYTICS_TAG="${VSS_BEHAVIOR_ANALYTICS_TAG:-3.2.1-26.07.2}"

VSS_AUTO_CALIBRATION_IMAGE="${VSS_AUTO_CALIBRATION_IMAGE:-${VSS_CONTAINER_REGISTRY}/vss-auto-calibration}"
VSS_AUTO_CALIBRATION_TAG="${VSS_AUTO_CALIBRATION_TAG:-3.2.1}"

VSS_AUTO_CALIBRATION_UI_IMAGE="${VSS_AUTO_CALIBRATION_UI_IMAGE:-${VSS_CONTAINER_REGISTRY}/vss-auto-calibration-ui}"
VSS_AUTO_CALIBRATION_UI_TAG="${VSS_AUTO_CALIBRATION_UI_TAG:-3.2.1}"

VSS_CONFIGURATOR_IMAGE="${VSS_CONFIGURATOR_IMAGE:-${VSS_CONTAINER_REGISTRY}/vss-configurator}"
VSS_CONFIGURATOR_TAG="${VSS_CONFIGURATOR_TAG:-3.2.1}"

VSS_RT_CONFIG_ADAPTOR_IMAGE="${VSS_RT_CONFIG_ADAPTOR_IMAGE:-${VSS_CONTAINER_REGISTRY}/vss-rt-config-adaptor}"
VSS_RT_CONFIG_ADAPTOR_TAG="${VSS_RT_CONFIG_ADAPTOR_TAG:-3.2.0}"

# -----------------------------------------------------------------------------
# First-party images whose TAG variable already exists in profile .env files.
# Only the registry+name is centralized; the existing tag variables
# (NVSTREAMER_IMAGE_TAG, RTVI_VLM_IMAGE_TAG, CALIBRATION_TOOLKIT_IMAGE_TAG,
# VIDEO_ANALYTICS_UI_IMAGE_TAG) keep working unchanged.
# -----------------------------------------------------------------------------
VSS_NVSTREAMER_IMAGE="${VSS_NVSTREAMER_IMAGE:-${VSS_CONTAINER_REGISTRY}/vss-vios-nvstreamer}"
VSS_RT_VLM_IMAGE="${VSS_RT_VLM_IMAGE:-${VSS_CONTAINER_REGISTRY}/vss-rt-vlm}"
VSS_CALIBRATION_TOOLKIT_IMAGE="${VSS_CALIBRATION_TOOLKIT_IMAGE:-${VSS_CONTAINER_REGISTRY}/calibration}"
VSS_VIDEO_ANALYTICS_UI_IMAGE="${VSS_VIDEO_ANALYTICS_UI_IMAGE:-${VSS_CONTAINER_REGISTRY}/vss-video-analytics-ui}"

# NOTE: video-summarization (CONTAINER_IMAGE), rtvi-cv (PERCEPTION_IMAGE),
# rtvi-embed (RTVI_EMBED_IMAGE), mv3dt bev-fusion (BEV_FUSION_MV3DT_IMAGE), and
# sdr-mw-l (SDR_MW_L_IMAGE) already expose per-image override variables inline
# in their compose files and are left as-is; they are classified in
# container-inventory.json rather than silently omitted.
