{
	"message_broker":
	{
		"enable_notification": false,
		"enable_notification_consumer": true,
		"use_message_broker" : "redis",
		"use_message_broker_consumer" : "kafka",
		"message_broker_topic": "vst_events",
		"message_broker_topic_consumer": "",
		"message_broker_payload_key": "sensor.id",
		"message_broker_metadata_topic": "test",
		"redis_server_env_var": "REDIS_SVC_SERVICE_HOST:6379",
		"kafka_server_address": "",
		"mqtt_broker_address": "tcp://172.17.0.1:1883"
	},
	"webhooks":
	[
		{
			"enabled": true,
			"camera_status_change": "camera_add",
			"request": [
				{
					"url": "http://127.0.0.1:9000/api/v1/stream/add",
					"method": "POST",
					"headers": {
						"Content-Type": "application/json",
						"x-stream-id": "{{event.camera_id}}",
						"created_at": "{{event.timestamp}}"
					},
					"body": {
						"key": "sensor",
						"value": {
							"camera_id": "{{event.camera_id}}",
							"camera_name": "{{event.camera_name}}",
							"camera_url": "{{event.camera_url}}",
							"creation_time": "{{event.timestamp}}",
							"change": "camera_add",
							"metadata": {
								"resolution": "1920x1080",
								"codec": "h264",
								"framerate": 30
							}
						},
						"headers": {
							"source": "vst",
							"created_at": "{{event.timestamp}}"
						}
					},
					"query_params": {},
					"timeout_ms": 5000,
					"retry": {"max_attempts": 3, "backoff_ms": [1000, 5000, 15000], "retry_on_status": [408, 429, 500, 502, 503, 504]}
				},
				{
					"url": "http://127.0.0.1:8017/v1/generate_video_embeddings",
					"method": "POST",
					"headers": {
						"Content-Type": "application/json",
						"accept": "application/json",
						"x-stream-id": "{{event.camera_id}}"
					},
					"body": {
						"url": "{{event.camera_url}}",
						"id": "{{event.camera_id}}",
						"model": "cosmos-embed1-448p",
						"creation_time": "{{event.timestamp}}",
						"chunk_duration": 5
					},
					"query_params": {},
					"timeout_ms": 5000,
					"retry": {"max_attempts": 3, "backoff_ms": [1000, 5000, 15000], "retry_on_status": [408, 429, 500, 502, 503, 504]}
				}
			]
		}
	]
}
