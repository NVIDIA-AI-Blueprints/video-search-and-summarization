# =============================================================================
# VST shared environment — used by foundational, initiator, and sdr includes
# =============================================================================

VST_VOLUME=${VSS_DATA_DIR}/data_log/vst
VST_CONFIG_PATH=${VSS_APPS_DIR}/services/vios/configs
VST_NOTIFICATION_CONFIG_PATH=${VST_CONFIG_PATH}/notification_config.json
VST_DATA_PATH=${VST_VOLUME}/vst_data
VST_VIDEO_STORAGE_PATH=${VST_VOLUME}/vst_video
VST_TEMP_FILES_PATH=${VST_VOLUME}/temp_files
VST_LOGS=${VST_DATA_PATH}/logs
CLIP_STORAGE_PATH=${VST_VOLUME}/clip_storage
VST_INSTALL_ADDITIONAL_PACKAGES=true

# VST deployment mode, default direct (no SDR/Envoy in the data path; baseline default).
# To switch to SDRC mode, use VST_NGINX_MODE=vst-sdrc
VST_USE_SDRC=false
VST_NGINX_MODE=vst

# VST Adaptor type. Valid values: vst_rtsp, milestone_onvif
VST_ADAPTOR=vst_rtsp

# VST db details
CENTRALIZE_DB_NAME=nvcentralizedb
CENTRALIZE_DB_USERNAME=vst

# VST storage size settings in MB
VST_VIDEO_STORAGE_SIZE_MB=100000

# Service HTTP ports
SENSOR_HTTP_PORT=30000
SENSOR_HTTP_HOST_PORT=30000
STREAM_PROCESSOR_HTTP_PORT=30001
STREAM_PROCESSOR_HTTP_HOST_PORT=30001

# Readiness URL for the blueprint/profile configurator when it is not defined in the same compose project; sensor-bp-wait-bp-configurator polls it so VST services avoid depends_on on external configurator workloads.
BP_CONFIGURATOR_READYZ_URL=http://vss-configurator:5001/readyz
SENSOR_BP_WAIT_BP_CONFIGURATOR_MAX_SEC=300

# sensor-bp-wait-storage polls STORAGE_HTTP_PORT until it accepts connections so VST services avoid depends_on on storage HTTP workloads defined outside this directory.
SENSOR_BP_WAIT_STORAGE_MAX_SEC=300

# RTSP port
RTSP_SERVER_PORT=30554
RTSP_SERVER_HOST_PORT=30554
RTSP_SERVER_HOST_PORT_END=30564
RTSP_SERVER_PORT_END=30564

# Module endpoints
# Direct-mode default. SDRC profiles override to http://sdr-controller:10000
# (the Envoy listener embedded in sdr-controller).
SENSOR_MODULE_ENDPOINT=http://vss-vios-sensor:30000
STREAM_PROCESSOR_MODULE_ENDPOINT=http://vss-vios-streamprocessing:30001

# VST ingress
VST_PORT=30888
VST_INGRESS_HTTP_PORT=${VST_PORT}
VST_INGRESS_HOST_PORT=30888
VST_INTERNAL_IP=vst-ingress:${VST_PORT}
VST_INGRESS_ENDPOINT=${VST_INTERNAL_IP}/vst
VST_INTERNAL_URL=http://vst-ingress:${VST_PORT}

# TURN / WebRTC relay.
# Leave empty for profiles using the bundled turnserver; VST derives the URL from
# TURN_USERNAME, TURN_PASSWORD_FILE, TURN_PUBLIC_HOST, and TURN_HOST_PORT at startup.
# If neither this override nor all derived TURN settings are present, VST startup fails before editing config.
# Override only for external or multiple TURN endpoints.
VST_STATIC_TURNURL_LIST=${VST_STATIC_TURNURL_LIST:-}

# Redis / Kafka
REDIS_HOSTADDR=redis
REDIS_PORT=6379
REDIS_MSG_KEY=vst.event
KAFKA_BOOTSTRAP_URL=kafka:29092
KAFKA_MSG_KEY=sensor.id

###################### VST Images ########################
VST_STREAM_PROCESSOR_IMAGE_TAG="1.4.0-26.08.1"
VST_SENSOR_IMAGE_TAG="1.4.0-26.08.1"
VST_INGRESS_IMAGE_TAG="1.4.0-26.08.1"
# VST_SENSOR_IMAGE / VST_STREAM_PROCESSOR_IMAGE / NGINX_IMAGE moved to
# deploy/docker/containers.env as VSS_VIOS_{SENSOR,STREAMPROCESSING,INGRESS}_IMAGE
# (namespaced, tag split out, on the shared VSS_CONTAINER_REGISTRY/VSS_CONTAINER_TAG
# pair). The *_IMAGE_TAG vars above stay for backward compat / test-dev-profile.sh.

POSTGRES_IMAGE=postgres:17.10-alpine
