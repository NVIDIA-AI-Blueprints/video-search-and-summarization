# Shared defaults for the VSS share service and the read-only view UI.

SHARE_HOST_PORT=9095
SHARE_PORT=9095

# Retention for a published view. Views hold surveillance thumbnails, so treat
# this as a retention control rather than a cache knob.
SHARE_TTL_SECONDS=604800

# Hosts the thumbnail proxy may fetch from. Comma separated prefixes; anything
# else is refused, which keeps this service from becoming an open proxy.
SHARE_THUMB_ALLOWED_PREFIXES=http://vst-ingress:30888/,http://vst-ingress:81/

SHARE_MAX_RESULTS=500
SHARE_MAX_PAYLOAD_BYTES=4194304

# Externally reachable https origin serving /view/<id> and /api/view/*.
# Leave blank until a public origin exists: the service then returns a relative
# path instead of inventing a hostname that will not resolve for a recipient.
SHARE_PUBLIC_BASE_URL=

# Read-only UI container port (host side).
VSS_UI_VIEW_HOST_PORT=3001
