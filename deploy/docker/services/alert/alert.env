# Shared alert bridge defaults.
ALERT_BRIDGE_PORT=9080
ALERT_BRIDGE_URL=http://alert-bridge:${ALERT_BRIDGE_PORT}

# OpenTelemetry, off by default. Declared here so the host-side names are
# discoverable: compose.yml reads ALERT_* and renders the unprefixed OTEL_*
# into the container, so an operator grepping for the variable meters.py tells
# them to set would otherwise find nothing.
ALERT_ENABLE_OTEL_MONITORING=false
# Silences metrics too, since ALERT_OTEL_METRICS_EXPORTER falls back to it.
# This is the lever for a collector that is not there: without it the OTLP
# exporter retries three times with backoff and blocks roughly seven seconds at
# process exit, against docker stop's ten-second grace for the whole fleet.
ALERT_OTEL_TRACES_EXPORTER=otlp
