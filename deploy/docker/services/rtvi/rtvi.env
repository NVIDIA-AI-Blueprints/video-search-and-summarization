# Shared RTVI defaults.
RTVI_VLM_BASE_URL=http://rtvi-vlm:8000
RTVI_VLM_KAFKA_BOOTSTRAP_SERVERS=kafka:29092
RTVI_VLM_KAFKA_INCIDENT_TOPIC=mdx-vlm-incidents
RTVI_VLM_KAFKA_ENABLED=true
RTVI_EMBED_IMAGE=nvcr.io/nvstaging/vss-core/vss-rt-embed
RTVI_EMBED_TAG=3.3.0-26.08.1
RTVI_EMBED_PORT=8017
PERCEPTION_IMAGE="nvcr.io/nvstaging/vss-core/vss-rt-cv"
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_METRICS_EXPORTER=otlp
