# Shared RTVI defaults.
# /rtvi-vlm fronts this same container, so the gateway origin is the one
# spelling that works for every caller: the agent (which may be off-host and
# cannot resolve `rtvi-vlm`), alert-bridge and lvs-server, which reach
# vss.local through the bridge alias HAProxy publishes unconditionally.
RTVI_VLM_BASE_URL=${VSS_GATEWAY_ORIGIN:-http://${VSS_GATEWAY_HOST:-vss.local}:${HAPROXY_PORT:-7777}}/rtvi-vlm
RTVI_VLM_KAFKA_BOOTSTRAP_SERVERS=kafka:29092
RTVI_VLM_KAFKA_INCIDENT_TOPIC=mdx-vlm-incidents
RTVI_VLM_KAFKA_ENABLED=true
RTVI_EMBED_PORT=8017
# NOTE: the rt-cv image coordinate now lives in deploy/docker/containers.env as
# VSS_RT_CV_IMAGE / VSS_RT_CV_TAG. Re-declaring it here would shadow the shared
# value and silently break `VSS_CONTAINER_REGISTRY` / `VSS_CONTAINER_TAG`.
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_METRICS_EXPORTER=otlp
