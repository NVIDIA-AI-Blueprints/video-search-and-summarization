# Port for RTVI Embed microservice
RTVI_EMBED_PORT=8017

# Enable OTEL Monitoring
RTVI_EMBED_ENABLE_OTEL_MONITORING=false
RTVI_EMBED_OTEL_EXPORTER_OTLP_ENDPOINT=

# Enable generated-message output over Kafka
MESSAGE_BUS=kafka
MESSAGE_BUS_TOPIC=mdx-embed
# Released RT-Embed images still consume these legacy publication flags.
KAFKA_ENABLED=true
KAFKA_TOPIC=mdx-embed
ERROR_BUS=kafka
RTVI_EMBED_ERROR_MESSAGE_TOPIC=vision-embed-errors
RTVI_EMBED_KAFKA_BOOTSTRAP_SERVERS=

# Set the Huggingface token
#HF_TOKEN=

# Optional CE1 NIM remote backend. Leave REMOTE_EMBED_ENDPOINT empty to use the local model.
REMOTE_EMBED_ENDPOINT=
REMOTE_EMBED_ENDPOINT_MODEL_NAME=nvidia/cosmos-embed1
REMOTE_EMBED_ENDPOINT_API_KEY=
REMOTE_EMBED_ENDPOINT_TIMEOUT_SEC=300
REMOTE_EMBED_ENDPOINT_BATCH_SIZE=64
ASSET_DOWNLOAD_CONNECT_TIMEOUT=10
ASSET_DOWNLOAD_TOTAL_TIMEOUT=300
ASSET_DOWNLOAD_MAX_FILE_SIZE_GB=8
ASSET_DOWNLOAD_SSL_SKIP_VERIFY_DOMAINS=
ASSET_DOWNLOAD_MAX_REDIRECTS=0
ASSET_DOWNLOAD_AUTH_TOKENS=
FILE_URL_ALLOWED_DIRS=
MAX_ASSET_STORAGE_SIZE_GB=
ASSET_MAX_AGE_HOURS=0
