OPENSHELL_TAG=0.1.6
OPENSHELL_GATEWAY_ENDPOINT=http://127.0.0.1:8080
HERMES_REF=v2026.9.14

# Provider profile in services/openshell/providers/<HARNESS_PROVIDER>-profile.yaml.
# Place HARNESS_API_KEY and any HARNESS_* or VSS_PUBLIC_URL overrides in gitignored
# harness.env at the repo root (sourced after this file so shell/local overrides win).
HARNESS_PROVIDER=agent-inference
HARNESS_BASE_URL=https://inference-api.nvidia.com/v1
HARNESS_MODEL=aws/anthropic/bedrock-claude-opus-5

VSS_PUBLIC_URL=http://host.openshell.internal:7777
