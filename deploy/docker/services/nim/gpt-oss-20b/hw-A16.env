# 20B weights do not fit a 16 GB A16; keep a compose identity with fail-closed
# low-memory knobs rather than copying an RTX 96 GB dedicated profile.
NIM_KVCACHE_PERCENT=0.45
NIM_GPU_MEM_FRACTION=0.45
NIM_MAX_NUM_SEQS=1
NIM_MAX_MODEL_LEN=4096
NIM_LOW_MEMORY_MODE=1
