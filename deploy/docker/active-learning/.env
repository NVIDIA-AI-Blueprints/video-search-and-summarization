# Environment variables for docker-compose.yml
# This file contains all environment variables defined in the blueprint.
#
# .env file format: Simple KEY=value pairs (NO ${VAR} syntax allowed)
# - Set values directly: NGC_API_KEY=your_key_here
# - Or set via shell: export NGC_API_KEY=mykey && docker compose up
#
# Variables with defaults are pre-filled.
# Variables requiring paths: Use absolute paths (e.g., /home/username/.cache/nim)
# Note: Do NOT use ~ or ${HOME} - they behave unexpectedly with 'sudo docker compose'
#
# Grouped by published ports, image overrides, volume paths, shared variables, then service-specific variables.

# ==============================================================================
# Shared Variables (used by multiple services)
# ==============================================================================

# Required by included Compose project: includes/deft-aoi-data-flywheel
# REQUIRED: set this before building the deployment.
AOI_SELECTION_TAG=aoi1-train

# Required by included Compose project: includes/deft-aoi-active-learning
# REQUIRED: set this before building the deployment.
DEFT_AOI_ACTIVE_LEARNING_DIR=/home/horde/video-search-and-summarization/services/object-store

# Required by included Compose project: includes/deft-aoi-deft-service
# REQUIRED: set this before building the deployment.
DEFT_RUNTIME_DIR=/home/horde/deft-aoi-workspace-2

# Required by included Compose project: includes/deft-aoi-deft-service
# REQUIRED: set this before building the deployment.
DEFT_SERVICE_DIR=/home/horde/video-search-and-summarization/services/deft-service
DFW_SERVICE_DIR=/home/horde/video-search-and-summarization/services/data-flywheel

DFW_IMAGE=nvcr.io/0691049440816435/mdx/foundational-flywheel-server-deft:v0.0.1
DFW_MODEL_MANAGER_IMAGE=nvcr.io/0691049440816435/mdx/dfw-model-manager:v0.0.1
AOI_INFERENCE_IMAGE=nvcr.io/0691049440816435/mdx/deft-aoi-inference:v0.0.1
AOI_BACKEND_IMAGE=nvcr.io/0691049440816435/mdx/deft-aoi-active-learning-backend:v0.0.1
AOI_CLIENT_IMAGE=nvcr.io/0691049440816435/mdx/aoi-client:v0.0.1
AOI_ARCHIVER_IMAGE=nvcr.io/0691049440816435/mdx/al-archiver:v0.0.1
AOI_SNAPSHOT_WORKER_IMAGE=nvcr.io/0691049440816435/mdx/snapshot-worker:v0.0.1
AOI_EVAL_SET_WORKER_IMAGE=nvcr.io/0691049440816435/mdx/eval-set-worker:v0.0.1
AOI_KPI_WORKER_IMAGE=nvcr.io/0691049440816435/mdx/kpi-worker:v0.0.1
DEFT_SERVICE_IMAGE=nvcr.io/0691049440816435/mdx/deft-service:v0.0.1
DFW_HITL_CANARY=false
DFW_HITL_FULL=false
MODEL_MANAGER_REQUEST_TIMEOUT=900
MAX_REQUEST_BYTES=25165824 
