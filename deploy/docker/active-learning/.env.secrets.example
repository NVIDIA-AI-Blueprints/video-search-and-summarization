# Deployment inputs for the AOI active-learning stack. From
# deploy/docker/active-learning/:
#
#   install -m 600 .env.secrets.example .env.secrets
#   # set every value under "Required"
#   docker compose --env-file .env.secrets up -d
#
# Values here reach all four bundles and override the bundle defaults in
# includes/*/.env.deft-aoi-*. Compose stops with "... must be set" while a
# required value is missing or empty. .env.secrets is in .gitignore; do not
# commit it.

# ==============================================================================
# Required: deployment inputs
# ==============================================================================

# Inspection tag of the records the flywheel trains on. Records without it (for
# example the KPI set) are left out of training. Used by data-flywheel-*.
AOI_SELECTION_TAG=

# Absolute host directory for DEFT runtime data: workspaces, materialised
# snapshots, TAO stage output and caches. deft-service bind-mounts it at the
# same path and the TAO containers it launches mount it too, so it must be a
# real host path. Do not use ~ or ${HOME}.
DEFT_RUNTIME_DIR=

# ==============================================================================
# Required: secrets
# ==============================================================================

# SeaweedFS S3 key pair. seaweedfs-s3 accepts it, and backend-api, the
# snapshot, eval and KPI workers, and seaweedfs-bucket-bootstrap sign with it.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# API key deft-service accepts from data-flywheel (DEFT_AUTH_MODE=static). Pick
# a random value; both services read it from here.
DEFT_API_KEY=

# Credential data-flywheel presents to the AOI storage backend (backend-api).
STORAGE_BACKEND_API_KEY=

# ==============================================================================
# Optional
# ==============================================================================

# Hugging Face token that deft-service forwards to TAO stage containers when a
# stage needs gated model assets.
# HF_TOKEN=
