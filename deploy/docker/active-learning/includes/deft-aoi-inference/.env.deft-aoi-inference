# Default values for this bundle's compose.yml.
# ../../compose.yml loads this file through `include: env_file:`. Values in
# ../../.env.secrets (passed with --env-file) or in the shell take precedence.
#
# .env file format: Simple KEY=value pairs (NO ${VAR} syntax allowed)
# - Set values directly: NGC_API_KEY=your_key_here
# - Or set via shell: export NGC_API_KEY=mykey && docker compose up
#
# Variables with defaults are pre-filled.
# Variables requiring paths: Use absolute paths (e.g., /home/username/.cache/nim)
# Note: Do NOT use ~ or ${HOME} - they behave unexpectedly with 'sudo docker compose'
#
# Grouped by published ports, image overrides, volume paths, shared variables, then service-specific variables.

# ==============================================================================
# Host Port Variables (Docker Compose published ports)
# ==============================================================================

# Docker Compose host port for service 'aoi-inference' port 'http' (5000/tcp).
AOI_INFERENCE_PORT=5010

# ==============================================================================
# Container Image Overrides (Docker Compose only)
# ==============================================================================

# Complete AOI Inference runtime image reference. Override this to select a runtime line compatible with the deployed Model Manager API. Used by service: aoi-inference-triton-seed-aoi-model-repository.
# Complete AOI Inference runtime image reference. Override this to select a runtime line compatible with the deployed Model Manager API. Used by service: aoi-inference-triton.
# Complete AOI Inference runtime image reference. Override this to select a runtime line compatible with the deployed Model Manager API. Used by service: aoi-inference-api.
AOI_INFERENCE_IMAGE=nvcr.io/0691049440816435/mdx/deft-aoi-inference:v0.0.1

# ==============================================================================
# Host Bind Address Variables (Docker Compose published ports)
# ==============================================================================

# Docker Compose bind address for service 'aoi-inference' port 'http' (5000/tcp).
# 127.0.0.1 = local only. Set 0.0.0.0 or a host IP to accept remote clients.
AOI_INFERENCE_BIND_ADDRESS=127.0.0.1

# ==============================================================================
# Shared Variables (used by multiple services)
# ==============================================================================

# Shared by services: aoi-inference-api, aoi-inference-triton
BUILD_QUEUE_TIMEOUT_MULTIPLIER=6

# Shared by services: aoi-inference-api, aoi-inference-triton
BUILD_STATE_MAX_AGE=3600

# Shared by services: aoi-inference-api, aoi-inference-triton
BUILD_STATE_PATH=/app/microservice/triton_model_repo/.engine-build.json

# Shared by services: aoi-inference-api, aoi-inference-triton
BUILD_UNLOAD_DURING_BUILD=false

# Shared by services: aoi-inference-api, aoi-inference-triton
DEPLOYMENT_STATE_MAX_AGE=0

# Shared by services: aoi-inference-api, aoi-inference-triton
DEPLOYMENT_STATE_PATH=/app/microservice/triton_model_repo/.deployment-state.json

# Shared by services: aoi-inference-api, aoi-inference-triton
DEPLOYMENT_STATE_TTL=1.0

# Shared by services: aoi-inference-api, aoi-inference-triton
MAX_BATCH=16

# Shared by services: aoi-inference-api, aoi-inference-triton
STATE_DB_PATH=/app/state/service-state.sqlite3

# ==============================================================================
# Service: aoi-inference-api
# ==============================================================================

# From service: aoi-inference-api - Maximum concurrent API requests per replica.
API_MAX_INFLIGHT=64

# From service: aoi-inference-api - Mounted filesystem root allowed for bulk jobs.
JOB_ALLOWED_ROOTS=/app/data

# From service: aoi-inference-api - Maximum image pairs retained for a bulk job.
MAX_JOB_PAIRS=1024

# From service: aoi-inference-api - Maximum queued bulk jobs per worker.
MAX_QUEUED_JOBS=32

# From service: aoi-inference-api - Maximum uploaded request batch size.
MAX_REQUEST_BATCH=64

# From service: aoi-inference-api - Maximum individual upload size in bytes.
MAX_UPLOAD_BYTES=20971520

# From service: aoi-inference-api - Maximum concurrent preprocessing operations.
PREPROCESS_MAX_INFLIGHT=16

# From service: aoi-inference-api - Image preprocessing worker count.
PREPROCESS_WORKERS=8

# From service: aoi-inference-api - Per-request queue deadline in seconds.
QUEUE_TIMEOUT=5.0

# From service: aoi-inference-api - Shared golden-reference image store.
REFERENCE_DIR=/app/references

# From service: aoi-inference-api - Maximum server-side inference batch size.
SERVER_MAX_BATCH=16

# From service: aoi-inference-api - Triton priority assigned to bulk jobs.
TRITON_BULK_PRIORITY=2

# From service: aoi-inference-api - Triton priority assigned to online requests.
TRITON_ONLINE_PRIORITY=1

# From service: aoi-inference-api - Protocol used to call Triton.
TRITON_PROTOCOL=grpc

# ==============================================================================
# Service: aoi-inference-triton
# ==============================================================================

# From service: aoi-inference-triton - Shared lock serializing runtime engine builds.
BUILD_LOCK_PATH=/app/microservice/triton_model_repo/.engine-build.lock

# From service: aoi-inference-triton - Global Triton GPU execution concurrency slots.
GPU_EXEC_SLOTS=3

# From service: aoi-inference-triton - ChangeNet inference image size.
IMG_SIZE=224

# From service: aoi-inference-triton - Minimum TensorRT optimization batch size.
MIN_BATCH=1

# From service: aoi-inference-triton - Preferred TensorRT optimization batch size.
OPT_BATCH=8

# From service: aoi-inference-triton - TensorRT engine precision.
PRECISION=fp16

# From service: aoi-inference-triton - Build a TensorRT engine when required.
SKIP_BUILD=false

# From service: aoi-inference-triton - TensorRT build workspace in MiB.
WORKSPACE_MB=8192
