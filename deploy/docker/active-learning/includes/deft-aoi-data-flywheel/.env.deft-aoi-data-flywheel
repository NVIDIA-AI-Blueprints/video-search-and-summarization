# Shared by services: data-flywheel-api, data-flywheel-beat, data-flywheel-parent-worker, data-flywheel-worker
DFW_CONFIG_PATH=/tmp/data-flywheel/config.deft.yaml

# Shared by services: data-flywheel-api, data-flywheel-beat, data-flywheel-parent-worker, data-flywheel-worker
DFW_DEFT_BASE_URL=http://deft-service:8000

# Shared by services: data-flywheel-api, data-flywheel-beat, data-flywheel-parent-worker, data-flywheel-worker
# Allowed values: false, true
DFW_HITL_CANARY=true

# Shared by services: data-flywheel-api, data-flywheel-beat, data-flywheel-parent-worker, data-flywheel-worker
# Allowed values: false, true
DFW_HITL_FULL=true

# Shared by services: data-flywheel-api, data-flywheel-beat, data-flywheel-parent-worker, data-flywheel-worker
DFW_KPI_SET_URI=null

# Shared by services: data-flywheel-api, data-flywheel-beat, data-flywheel-parent-worker, data-flywheel-worker
DFW_MLFLOW_URL=http://mlflow:5000

# Shared by services: data-flywheel-api, data-flywheel-beat, data-flywheel-parent-worker, data-flywheel-worker
DFW_MODEL_MANAGER_URL=http://data-flywheel-model-manager:8090

# Shared by services: data-flywheel-api, data-flywheel-beat, data-flywheel-parent-worker, data-flywheel-worker
DFW_OBJECT_STORE_URI=s3://aoi-samples

# Shared by services: data-flywheel-api, data-flywheel-beat, data-flywheel-parent-worker, data-flywheel-worker
# Allowed values: false, true
DFW_STAGE_CANARY=true

# Shared by services: data-flywheel-api, data-flywheel-beat, data-flywheel-parent-worker, data-flywheel-worker
# Allowed values: false, true
DFW_STAGE_SHADOW=true

# Shared by services: data-flywheel-api, data-flywheel-beat, data-flywheel-parent-worker, data-flywheel-worker
DFW_STORAGE_BACKEND_URL=http://backend-api:8000

# Shared by services: data-flywheel-api, data-flywheel-beat, data-flywheel-parent-worker, data-flywheel-worker
MONGODB_DB=flywheel

# Shared by services: data-flywheel-api, data-flywheel-beat, data-flywheel-parent-worker, data-flywheel-worker
MONGODB_URL=mongodb://mongodb:27017

# Shared by services: data-flywheel-api, data-flywheel-beat, data-flywheel-parent-worker, data-flywheel-worker
REDIS_URL=redis://redis:6379/0

# ==============================================================================
# Service: data-flywheel-model-manager
# ==============================================================================

# From service: data-flywheel-model-manager - Invoke AOI model load and routing APIs explicitly. The source poll mode is currently unimplemented.
# Allowed values: explicit
MODEL_MANAGER_ACTIVATION_MODE=explicit

# From service: data-flywheel-model-manager - connection: aoi-inference - AOI routing API base URL. Despite the legacy setting name, this API is served by AOI Inference.
MODEL_MANAGER_AOI_CLIENT_URL=http://aoi-inference:5000

# From service: data-flywheel-model-manager - connection: aoi-inference - AOI inference model-control API base URL.
MODEL_MANAGER_AOI_INFERENCE_URL=http://aoi-inference:5000

# From service: data-flywheel-model-manager - Serving adapter. 'aoi' is the legacy AOI control plane; 'unified' speaks the Unified Model Control API and works against any backend implementing it, whichever use case it serves. The unified client reads MODEL_MANAGER_UNIFIED_URL, not the MODEL_MANAGER_AOI_* addresses.
# Allowed values: aoi, unified
MODEL_MANAGER_CLIENT=unified

# From service: data-flywheel-model-manager - Default AOI serving model name.
MODEL_MANAGER_MODEL_NAME=aoi-secondary-inspection

# From service: data-flywheel-model-manager - Shared Triton model repository.
MODEL_MANAGER_MODEL_REPO_PATH=/models

# From service: data-flywheel-model-manager - Readiness checks after model activation.
MODEL_MANAGER_READINESS_MAX_CHECKS=5

# From service: data-flywheel-model-manager - Seconds between activation readiness checks.
MODEL_MANAGER_READINESS_POLL_INTERVAL=2.0

# From service: data-flywheel-model-manager - Base exponential retry delay in seconds.
MODEL_MANAGER_REQUEST_BACKOFF_BASE=0.5

# From service: data-flywheel-model-manager - Transient downstream retry count.
MODEL_MANAGER_REQUEST_MAX_RETRIES=2

# From service: data-flywheel-model-manager - Downstream HTTP timeout in seconds.
MODEL_MANAGER_REQUEST_TIMEOUT=30.0

# From service: data-flywheel-model-manager - Allow the unified clients to issue an unload. Keep false unless the target implements PER-VERSION unload: the shipped backend unloads at model granularity, so a cleanup of a retired version also evicts the one serving traffic. While false, cleanup declines to reclaim disk and the promotion still completes.
# Allowed values: true, false
MODEL_MANAGER_UNIFIED_ALLOW_UNLOAD=false

# From service: data-flywheel-model-manager - connection: aoi-inference - Unified Model Control API base URL, used by the 'unified' client. The unified contract serves load, unload, routing and status from ONE address, which is why this is a single setting rather than the legacy pair above. Ignored by the 'aoi' client.
MODEL_MANAGER_UNIFIED_URL=http://aoi-inference:5000

# ==============================================================================
# Service: mlflow
# ==============================================================================

# From service: mlflow - Host headers accepted by MLflow. Add the external host when publishing MLflow beyond loopback.
MLFLOW_ALLOWED_HOSTS=mlflow:5000,mlflow-*:5000,localhost:*,127.0.0.1:*

# ==============================================================================
# Service: mongodb
# ==============================================================================

# From service: mongodb - MongoDB container log level for developer deployments.
MONGO_LOG_LEVEL=error
