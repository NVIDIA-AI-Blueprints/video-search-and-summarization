# Environment variables for docker-compose.yml
# This file contains all environment variables defined in the blueprint.
#
# .env file format: Simple KEY=value pairs (NO ${VAR} syntax allowed)
# - Set values directly: NGC_API_KEY=your_key_here
# - Or set via shell: export NGC_API_KEY=mykey && docker compose up
#
# Variables with defaults are pre-filled.
# Variables requiring paths: Use absolute paths (e.g., /home/username/.cache/nim)
# Note: Do NOT use ~ or ${HOME} - they behave unexpectedly with 'sudo docker compose'
#
# Grouped by published ports, image overrides, volume paths, shared variables, then service-specific variables.

# ==============================================================================
# Host Port Variables (Docker Compose published ports)
# ==============================================================================

# Docker Compose host port for service 'data-flywheel-api' port 'http' (8000/tcp).
DFW_API_PORT=8000

# Docker Compose host port for service 'data-flywheel-model-manager' port 'http' (8090/tcp).
DFW_MODEL_MANAGER_PORT=8090

# Docker Compose host port for service 'mlflow' port 'http' (5000/tcp).
MLFLOW_HOST_PORT=5500

# ==============================================================================
# Container Image Overrides (Docker Compose only)
# ==============================================================================

# Complete image reference shared by the Data Flywheel API, workers, and scheduler. Used by service: data-flywheel-api.
# Complete image reference shared by the Data Flywheel API, workers, and scheduler. Used by service: data-flywheel-worker.
# Complete image reference shared by the Data Flywheel API, workers, and scheduler. Used by service: data-flywheel-parent-worker.
# Complete image reference shared by the Data Flywheel API, workers, and scheduler. Used by service: data-flywheel-beat.
DFW_IMAGE=nvcr.io/nvstaging/blueprint/foundational-flywheel-server-deft:26.08.rc1

# Complete Data Flywheel Model Manager image reference. Used by service: data-flywheel-model-manager.
DFW_MODEL_MANAGER_IMAGE=nvcr.io/nvstaging/blueprint/dfw-model-manager:26.08.rc1

# ==============================================================================
# Host Bind Address Variables (Docker Compose published ports)
# ==============================================================================

# Docker Compose bind address for service 'data-flywheel-api' port 'http' (8000/tcp).
# Docker Compose bind address for service 'data-flywheel-model-manager' port 'http' (8090/tcp).
DFW_BIND_ADDRESS=127.0.0.1

# Docker Compose bind address for service 'mlflow' port 'http' (5000/tcp).
MLFLOW_BIND_ADDRESS=127.0.0.1

# ==============================================================================
