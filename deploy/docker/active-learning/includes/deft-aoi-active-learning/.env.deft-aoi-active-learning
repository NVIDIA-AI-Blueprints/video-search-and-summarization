# Default values for this bundle's compose.yml.
# ../../compose.yml loads this file through `include: env_file:`. Values in
# ../../.env.secrets (passed with --env-file) or in the shell take precedence.
#
# .env file format: Simple KEY=value pairs (NO ${VAR} syntax allowed)
# - Set values directly: NGC_API_KEY=your_key_here
# - Or set via shell: export NGC_API_KEY=mykey && docker compose up
#
# Variables with defaults are pre-filled.
# Variables requiring paths: Use absolute paths (e.g., /home/username/.cache/nim)
# Note: Do NOT use ~ or ${HOME} - they behave unexpectedly with 'sudo docker compose'
#
# Grouped by published ports, image overrides, volume paths, shared variables, then service-specific variables.

# ==============================================================================
# Host Port Variables (Docker Compose published ports)
# ==============================================================================

# Docker Compose host port for service 'al-archiver' port 'http' (8000/tcp).
AOI_ARCHIVER_PORT=8013

# Docker Compose host port for service 'backend-api' port 'http' (8000/tcp).
AOI_BACKEND_PORT=8008

# Docker Compose host port for service 'aoi-client' port 'http' (8000/tcp).
AOI_CLIENT_PORT=8012

# Docker Compose host port for service 'elasticsearch' port 'http' (9200/tcp).
ELASTICSEARCH_PORT=9201

# Docker Compose host port for service 'kafka' port 'external' (9094/tcp).
KAFKA_EXTERNAL_PORT=9094

# Docker Compose host port for service 'kibana' port 'http' (5601/tcp).
KIBANA_PORT=5602

# Docker Compose host port for service 'logstash' port 'monitoring' (9600/tcp).
LOGSTASH_PORT=9600

# Docker Compose host port for service 'seaweedfs-s3' port 's3-api' (8333/tcp).
SEAWEEDFS_S3_PORT=8333

# ==============================================================================
# Container Image Overrides (Docker Compose only)
# ==============================================================================

# Complete AOI Active Learning backend image reference. Used by service: backend-api.
AOI_BACKEND_IMAGE=nvcr.io/0691049440816435/mdx/deft-aoi-active-learning-backend:v0.0.1

# Complete AOI client image reference. Used by service: aoi-client.
AOI_CLIENT_IMAGE=nvcr.io/0691049440816435/mdx/aoi-client:v0.0.1

# Complete AOI archiver image reference. Used by service: al-archiver.
AOI_ARCHIVER_IMAGE=nvcr.io/0691049440816435/mdx/al-archiver:v0.0.1

# Complete snapshot worker image reference. Used by service: snapshot-slice-consumer.
# Complete snapshot worker image reference. Used by service: snapshot-finalizer.
AOI_SNAPSHOT_WORKER_IMAGE=nvcr.io/0691049440816435/mdx/snapshot-worker:v0.0.1

# Complete eval set worker image reference. Used by service: eval-slice-consumer.
# Complete eval set worker image reference. Used by service: eval-summary-consumer.
AOI_EVAL_SET_WORKER_IMAGE=nvcr.io/0691049440816435/mdx/eval-set-worker:v0.0.1

# Complete KPI worker image reference. Used by service: kpi-slice-consumer.
# Complete KPI worker image reference. Used by service: kpi-finalizer.
AOI_KPI_WORKER_IMAGE=nvcr.io/0691049440816435/mdx/kpi-worker:v0.0.1

# ==============================================================================
# Host Bind Address Variables (Docker Compose published ports)
# ==============================================================================

# Docker Compose bind address for service 'backend-api' port 'http' (8000/tcp).
# Docker Compose bind address for service 'aoi-client' port 'http' (8000/tcp).
# Docker Compose bind address for service 'al-archiver' port 'http' (8000/tcp).
# 127.0.0.1 = local only. Set 0.0.0.0 or a host IP to accept remote clients.
AOI_BIND_ADDRESS=127.0.0.1

# Docker Compose bind address for service 'elasticsearch' port 'http' (9200/tcp).
# Docker Compose bind address for service 'kibana' port 'http' (5601/tcp).
# Docker Compose bind address for service 'logstash' port 'monitoring' (9600/tcp).
# Elasticsearch runs with security disabled, so keep this on loopback unless the network is trusted.
ELK_BIND_ADDRESS=127.0.0.1

# Docker Compose bind address for service 'seaweedfs-s3' port 's3-api' (8333/tcp).
# 127.0.0.1 = local only. Set 0.0.0.0 or a host IP to accept remote clients. S3 credentials are required either way.
SEAWEEDFS_S3_BIND_ADDRESS=127.0.0.1

# ==============================================================================
# Source Build Variables (Docker Compose build paths)
# ==============================================================================

# ==============================================================================
# Shared Variables (used by multiple services)
# ==============================================================================

# Shared by services: seaweedfs-bucket-bootstrap
AWS_DEFAULT_REGION=us-east-1

# Shared by services: eval-slice-consumer, eval-summary-consumer
EVAL_PAGE_SIZE=1000

# Shared by services: backend-api, eval-slice-consumer, eval-summary-consumer
EVAL_PREFIX=evals

# Shared by services: eval-slice-consumer, eval-summary-consumer
EVAL_SLICES_GROUP=eval-slices-consumer

# Shared by services: eval-slice-consumer, eval-summary-consumer
EVAL_SUMMARY_GROUP=eval-summary-consumer

# Shared by services: eval-slice-consumer, eval-summary-consumer
HANDLER_MAX_RETRIES=5

# Shared by services: backend-api, kpi-finalizer, kpi-slice-consumer
KPI_PREFIX=kpi

# Shared by services: eval-slice-consumer, eval-summary-consumer
RETRY_BASE_DELAY_S=1.0

# Shared by services: eval-slice-consumer, eval-summary-consumer
RETRY_MAX_DELAY_S=30.0

# Shared by services: seaweedfs-bucket-bootstrap
S3_READY_MAX_ATTEMPTS=150

# Shared by services: seaweedfs-master1, seaweedfs-master2, seaweedfs-master3
WEED_MASTER_VOLUME_GROWTH_COPY_2=2

# ==============================================================================
# Service: al-archiver
# ==============================================================================

# From service: al-archiver - Backend result-ingest route.
BE_INFERENCE_RESULT_PATH=/api/inference-results

# From service: al-archiver - Archiver Kafka consumer group.
KAFKA_GROUP_ID=al-archiver

# ==============================================================================
# Service: aoi-client
# ==============================================================================

# From service: aoi-client - AOI inference batch path.
AOI2_BATCH_PATH=/v1/predict:batch

# From service: aoi-client - AOI inference readiness path.
AOI2_READY_PATH=/v1/ready

# From service: aoi-client - AOI inference request batch size.
BATCH_SIZE=16

# From service: aoi-client - AOI request intake queue capacity.
INTAKE_QUEUE_SIZE=64

# From service: aoi-client - Maximum concurrent AOI inference operations.
SEMAPHORE_PERMITS=48

# ==============================================================================
# Service: backend-api
# ==============================================================================

# From service: backend-api - AOI client retry count.
AOI_CLIENT_MAX_RETRIES=3

# From service: backend-api - AOI client timeout in seconds.
AOI_CLIENT_TIMEOUT_S=10

# From service: backend-api - Browser-reachable S3 base URL used in presigned results. Compose may leave this blank when the browser can reach the host-published S3 port. Helm deployments must expose S3 externally and set this value to that public URL.
AWS_PUBLIC_ENDPOINT=

# From service: backend-api - Use the uploaded sample as its development golden reference.
# Allowed values: true, false
DEV_USE_SAMPLE_AS_GOLDEN_REF=false

# From service: backend-api - AOI index pattern queried by the API.
ELASTICSEARCH_INDEX_PATTERN=aoi_*

# From service: backend-api - Compatibility AOI index pattern.
ES_INDEX=aoi_*

# From service: backend-api - Enable second-inspection inference orchestration.
# Allowed values: true, false
INFERENCE_ENABLED=true

# From service: backend-api - Elasticsearch point-in-time lifetime.
PIT_KEEP_ALIVE=10m

# ==============================================================================
# Service: elasticsearch
# ==============================================================================

# From service: elasticsearch - Elasticsearch development JVM heap.
ES_JAVA_OPTS="-Xms512m -Xmx512m"

# ==============================================================================
# Service: kafka
# ==============================================================================

# From service: kafka - Stable local KRaft cluster ID.
CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# From service: kafka - Internal service and local host-client advertised addresses.
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092,EXTERNAL://localhost:9094

# From service: kafka - Require explicit topic bootstrap.
KAFKA_AUTO_CREATE_TOPICS_ENABLE=false

# From service: kafka - Listener used by the KRaft controller.
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER

# From service: kafka - Single-node KRaft controller quorum.
KAFKA_CONTROLLER_QUORUM_VOTERS=1@localhost:9093

# From service: kafka - Internal broker listener name.
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT

# From service: kafka - Internal, controller, and Docker host-client listener binds.
KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:9092,CONTROLLER://0.0.0.0:9093,EXTERNAL://0.0.0.0:9094

# From service: kafka - Security protocol map for every AOI Kafka listener.
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,CONTROLLER:PLAINTEXT,EXTERNAL:PLAINTEXT

# From service: kafka - Persistent Kafka log and KRaft metadata directory.
KAFKA_LOG_DIRS=/var/lib/kafka/data

# From service: kafka - Single broker and controller node ID.
KAFKA_NODE_ID=1

# From service: kafka - Single-broker offsets replication factor.
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1

# From service: kafka - KRaft process roles.
KAFKA_PROCESS_ROLES=broker,controller

# From service: kafka - Single-broker transaction log minimum ISR.
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1

# From service: kafka - Single-broker transaction log replication factor.
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1

# ==============================================================================
# Service: kafka-aoi-topic-bootstrap
# ==============================================================================

# From service: kafka-aoi-topic-bootstrap - Default partition count for AOI topics without an explicit count.
DEFAULT_PARTITIONS=1

# From service: kafka-aoi-topic-bootstrap - Default Kafka replication factor for topic specs that omit replication_factor
DEFAULT_REPLICATION_FACTOR=1

# From service: kafka-aoi-topic-bootstrap - Default Kafka retention.ms for topic specs that omit retention_ms
DEFAULT_RETENTION_MS=14400000

# From service: kafka-aoi-topic-bootstrap - Default Kafka segment.ms for topic specs that omit segment_ms
DEFAULT_SEGMENT_MS=3600000

# From service: kafka-aoi-topic-bootstrap - Maximum attempts while waiting for Kafka before creating topics. Set 0 to wait indefinitely like the VSS profiles.
KAFKA_TOPIC_BOOTSTRAP_MAX_ATTEMPTS=0

# From service: kafka-aoi-topic-bootstrap - Seconds between Kafka readiness checks before creating topics
KAFKA_TOPIC_BOOTSTRAP_RETRY_INTERVAL_SECONDS=5

# ==============================================================================
# Service: kibana
# ==============================================================================

# ==============================================================================
# Service: logstash
# ==============================================================================

# From service: logstash - Logstash JVM heap.
LS_JAVA_OPTS="-Xmx1024m -Xms256m"
