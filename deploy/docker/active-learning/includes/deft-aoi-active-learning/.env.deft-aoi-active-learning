# ==============================================================================
# Service: al-archiver
# ==============================================================================

# From service: al-archiver - Inference-results topic consumed by the archiver.
AOI_ARCHIVER_KAFKA_TOPIC=aoi-inference-results

# From service: al-archiver - connection: backend - Active Learning backend base URL.
BE_BASE_URL=http://backend-api:8000

# From service: al-archiver - Backend result-ingest route.
BE_INFERENCE_RESULT_PATH=/api/inference-results

# From service: al-archiver - Archiver Kafka consumer group.
KAFKA_GROUP_ID=al-archiver

# ==============================================================================
# Service: aoi-client
# ==============================================================================

# From service: aoi-client - connection: aoi-inference - Connected AOI inference base URL.
AOI2_BASE_URL=http://aoi-inference:5000

# From service: aoi-client - AOI inference batch path.
AOI2_BATCH_PATH=/v1/predict:batch

# From service: aoi-client - AOI inference readiness path.
AOI2_READY_PATH=/v1/ready

# From service: aoi-client - Kafka inference-results topic.
AOI_CLIENT_KAFKA_TOPIC=aoi-inference-results

# From service: aoi-client - AOI inference request batch size.
BATCH_SIZE=16

# From service: aoi-client - AOI request intake queue capacity.
INTAKE_QUEUE_SIZE=64

# From service: aoi-client - Maximum concurrent AOI inference operations.
SEMAPHORE_PERMITS=48

# ==============================================================================
# Service: backend-api
# ==============================================================================

# From service: backend-api - Kafka topic receiving uploaded AOI metadata.
AOI_BACKEND_KAFKA_TOPIC=aoi-metadata

# From service: backend-api - connection: aoi-client - AOI client HTTP endpoint.
AOI_CLIENT_BASE_URL=http://aoi-client:8000

# From service: backend-api - AOI client retry count.
AOI_CLIENT_MAX_RETRIES=3

# From service: backend-api - AOI client timeout in seconds.
AOI_CLIENT_TIMEOUT_S=10

# From service: backend-api - Browser-reachable S3 base URL used in presigned results. Compose may leave this blank when the browser can reach the host-published S3 port. Helm deployments must expose S3 externally and set this value to that public URL.
AWS_PUBLIC_ENDPOINT=

# From service: backend-api - Use the uploaded sample as its development golden reference.
# Allowed values: true, false
DEV_USE_SAMPLE_AS_GOLDEN_REF=false

# From service: backend-api - AOI index pattern queried by the API.
ELASTICSEARCH_INDEX_PATTERN=aoi_*

# From service: backend-api - Compatibility AOI index pattern.
ES_INDEX=aoi_*

# From service: backend-api - Enable second-inspection inference orchestration.
# Allowed values: true, false
INFERENCE_ENABLED=true

# From service: backend-api - Elasticsearch point-in-time lifetime.
PIT_KEEP_ALIVE=10m

# From service: backend-api - Snapshot work topic.
SNAPSHOT_SLICES_TOPIC=snapshot-slices

# ==============================================================================
# Service: elasticsearch
# ==============================================================================

# From service: elasticsearch - Elasticsearch development JVM heap.
ES_JAVA_OPTS="-Xms512m -Xmx512m"

# ==============================================================================
# Service: kafka
# ==============================================================================

# From service: kafka - Stable local KRaft cluster ID.
CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# From service: kafka - Internal service and local host-client advertised addresses.
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092,EXTERNAL://localhost:9094

# From service: kafka - Require explicit topic bootstrap.
KAFKA_AUTO_CREATE_TOPICS_ENABLE=false

# From service: kafka - Listener used by the KRaft controller.
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER

# From service: kafka - Single-node KRaft controller quorum.
KAFKA_CONTROLLER_QUORUM_VOTERS=1@localhost:9093

# From service: kafka - Internal broker listener name.
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT

# From service: kafka - Internal, controller, and Docker host-client listener binds.
KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:9092,CONTROLLER://0.0.0.0:9093,EXTERNAL://0.0.0.0:9094

# From service: kafka - Security protocol map for every AOI Kafka listener.
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,CONTROLLER:PLAINTEXT,EXTERNAL:PLAINTEXT

# From service: kafka - Persistent Kafka log and KRaft metadata directory.
KAFKA_LOG_DIRS=/var/lib/kafka/data

# From service: kafka - Single broker and controller node ID.
KAFKA_NODE_ID=1

# From service: kafka - Single-broker offsets replication factor.
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1

# From service: kafka - KRaft process roles.
KAFKA_PROCESS_ROLES=broker,controller

# From service: kafka - Single-broker transaction log minimum ISR.
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1

# From service: kafka - Single-broker transaction log replication factor.
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1

# ==============================================================================
# Service: kafka-aoi-topic-bootstrap
# ==============================================================================

# From service: kafka-aoi-topic-bootstrap - Default partition count for AOI topics without an explicit count.
DEFAULT_PARTITIONS=1

# From service: kafka-aoi-topic-bootstrap - Default Kafka replication factor for topic specs that omit replication_factor
DEFAULT_REPLICATION_FACTOR=1

# From service: kafka-aoi-topic-bootstrap - Default Kafka retention.ms for topic specs that omit retention_ms
DEFAULT_RETENTION_MS=14400000

# From service: kafka-aoi-topic-bootstrap - Default Kafka segment.ms for topic specs that omit segment_ms
DEFAULT_SEGMENT_MS=3600000

# From service: kafka-aoi-topic-bootstrap - Maximum attempts while waiting for Kafka before creating topics. Set 0 to wait indefinitely like the VSS profiles.
KAFKA_TOPIC_BOOTSTRAP_MAX_ATTEMPTS=0

# From service: kafka-aoi-topic-bootstrap - Seconds between Kafka readiness checks before creating topics
KAFKA_TOPIC_BOOTSTRAP_RETRY_INTERVAL_SECONDS=5

# ==============================================================================
# Service: kibana
# ==============================================================================

# From service: kibana - connection: elasticsearch - JSON array containing the connected Elasticsearch HTTP endpoint.
ELASTICSEARCH_HOSTS=["http://elasticsearch:9200"]

# ==============================================================================
# Service: logstash
# ==============================================================================

# From service: logstash - Logstash JVM heap.
LS_JAVA_OPTS="-Xmx1024m -Xms256m"
