# Environment variables for docker-compose.yml
# This file contains all environment variables defined in the blueprint.
#
# .env file format: Simple KEY=value pairs (NO ${VAR} syntax allowed)
# - Set values directly: NGC_API_KEY=your_key_here
# - Or set via shell: export NGC_API_KEY=mykey && docker compose up
#
# Variables with defaults are pre-filled.
# Variables requiring paths: Use absolute paths (e.g., /home/username/.cache/nim)
# Note: Do NOT use ~ or ${HOME} - they behave unexpectedly with 'sudo docker compose'
#
# Grouped by published ports, image overrides, volume paths, shared variables, then service-specific variables.

# ==============================================================================
# Host Port Variables (Docker Compose published ports)
# ==============================================================================

# Docker Compose host port for service 'al-archiver' port 'http' (8000/tcp).
AOI_ARCHIVER_PORT=8011

# Docker Compose host port for service 'backend-api' port 'http' (8000/tcp).
AOI_BACKEND_PORT=8008

# Docker Compose host port for service 'aoi-client' port 'http' (8000/tcp).
AOI_CLIENT_PORT=8010

# Docker Compose host port for service 'kafka' port 'external' (9094/tcp).
KAFKA_EXTERNAL_PORT=9094

# Docker Compose host port for service 'kafka' port 'broker' (9092/tcp).
KAFKA_INTERNAL_PORT=9092

# Docker Compose host port for service 'kibana' port 'http' (5601/tcp).
KIBANA_PORT=5601

# Docker Compose host port for service 'logstash' port 'monitoring' (9600/tcp).
LOGSTASH_PORT=9600

# Docker Compose host port for service 'seaweedfs-master1' port 'master-api' (9333/tcp).
SEAWEEDFS_MASTER_PORT=9333

# Docker Compose host port for service 'seaweedfs-s3' port 's3-api' (8333/tcp).
SEAWEEDFS_S3_PORT=8333

