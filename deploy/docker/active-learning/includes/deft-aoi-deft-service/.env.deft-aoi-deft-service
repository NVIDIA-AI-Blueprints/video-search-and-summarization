# Environment variables for docker-compose.yml
# This file contains all environment variables defined in the blueprint.
#
# .env file format: Simple KEY=value pairs (NO ${VAR} syntax allowed)
# - Set values directly: NGC_API_KEY=your_key_here
# - Or set via shell: export NGC_API_KEY=mykey && docker compose up
#
# Variables with defaults are pre-filled.
# Variables requiring paths: Use absolute paths (e.g., /home/username/.cache/nim)
# Note: Do NOT use ~ or ${HOME} - they behave unexpectedly with 'sudo docker compose'
#
# Grouped by published ports, image overrides, volume paths, shared variables, then service-specific variables.

# ==============================================================================
# Host Port Variables (Docker Compose published ports)
# ==============================================================================

# Docker Compose host port for service 'deft-service' port 'http' (8000/tcp).
DEFT_SERVICE_PORT=9150

# ==============================================================================
# Source Build Variables (Docker Compose build paths)
# ==============================================================================

# ==============================================================================
# Volume Path Variables (Docker Compose host paths)
# ==============================================================================

# ==============================================================================
# Service: deft-service
# ==============================================================================

# From service: deft-service - Maximum number of sibling GPU stage containers allowed to execute concurrently.
DEFT_GPU_SLOTS=1

# From service: deft-service - connection: storage-backend - AOI Storage endpoint that issues presigned GET URLs.
DEFT_MATERIALIZE_PRESIGN_URL=http://backend-api:8000/v1/get_presigned_urls

# From service: deft-service - connection: storage-backend - AOI Storage base URL used to enumerate snapshot objects.
DEFT_MATERIALIZE_STORAGE_URL=http://backend-api:8000

# From service: deft-service - Maximum GPU count accepted in fine-tuning requests.
DEFT_MAX_NUM_GPUS=64

# From service: deft-service - connection: storage-backend - AOI Storage endpoint that issues presigned artifact uploads.
DEFT_PUBLISH_PRESIGN_URL=http://backend-api:8000/v1/get_presigned_post_url

# From service: deft-service - SigLIP model identifier or child-container-visible local path.
DEFT_SIGLIP_MODEL=google/siglip-base-patch16-224

# From service: deft-service - Wall-clock timeout in seconds for each TAO stage container.
DEFT_STAGE_TIMEOUT_S=86400

# From service: deft-service - TAO PyTorch image launched for real training stages.
DEFT_TAO_PYT_IMAGE=nvcr.io/nvidia/tao/tao-toolkit:6.26.3-pyt
