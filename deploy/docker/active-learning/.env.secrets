# Docker Compose secret inputs
# Copy with: install -m 600 .env.secrets.example .env.secrets
# Populate required values before deployment. Do not commit .env.secrets.
# Run with: docker compose --env-file .env --env-file .env.secrets -f docker-compose.yml up -d

# Required

# From init container: backend-api-wait-for-seaweedfs-bucket - parent service: backend-api - S3 access key. Compose defaults to a local development credential; Kubernetes requires the referenced Secret. - (SECRET)
# From init container: eval-slice-consumer-wait-for-seaweedfs-bucket - parent service: eval-slice-consumer - S3 access key. Compose defaults to a local development credential; Kubernetes requires the referenced Secret. - (SECRET)
# From init container: eval-summary-consumer-wait-for-seaweedfs-bucket - parent service: eval-summary-consumer - S3 access key. Compose defaults to a local development credential; Kubernetes requires the referenced Secret. - (SECRET)
# From init container: kpi-finalizer-wait-for-seaweedfs-bucket - parent service: kpi-finalizer - S3 access key. Compose defaults to a local development credential; Kubernetes requires the referenced Secret. - (SECRET)
# From init container: kpi-slice-consumer-wait-for-seaweedfs-bucket - parent service: kpi-slice-consumer - S3 access key. Compose defaults to a local development credential; Kubernetes requires the referenced Secret. - (SECRET)
# From init container: snapshot-finalizer-wait-for-seaweedfs-bucket - parent service: snapshot-finalizer - S3 access key. Compose defaults to a local development credential; Kubernetes requires the referenced Secret. - (SECRET)
# From init container: snapshot-slice-consumer-wait-for-seaweedfs-bucket - parent service: snapshot-slice-consumer - S3 access key. Compose defaults to a local development credential; Kubernetes requires the referenced Secret. - (SECRET)
# From service: backend-api - S3 access key. Compose defaults to a local development credential; Kubernetes requires the referenced Secret. - (SECRET)
# From service: eval-slice-consumer - S3 access key. Compose defaults to a local development credential; Kubernetes requires the referenced Secret. - (SECRET)
# From service: eval-summary-consumer - S3 access key. Compose defaults to a local development credential; Kubernetes requires the referenced Secret. - (SECRET)
# From service: kpi-finalizer - S3 access key. Compose defaults to a local development credential; Kubernetes requires the referenced Secret. - (SECRET)
# From service: kpi-slice-consumer - S3 access key. Compose defaults to a local development credential; Kubernetes requires the referenced Secret. - (SECRET)
# From service: seaweedfs-bucket-bootstrap - S3 access key. Compose defaults to a local development credential; Kubernetes requires the referenced Secret. - (SECRET)
# From service: seaweedfs-s3 - S3 access key. Compose defaults to a local development credential; Kubernetes requires the referenced Secret. - (SECRET)
# From service: snapshot-finalizer - S3 access key. Compose defaults to a local development credential; Kubernetes requires the referenced Secret. - (SECRET)
# From service: snapshot-slice-consumer - S3 access key. Compose defaults to a local development credential; Kubernetes requires the referenced Secret. - (SECRET)
AWS_ACCESS_KEY_ID=seaweedfs

# From init container: backend-api-wait-for-seaweedfs-bucket - parent service: backend-api - S3 secret key. Compose defaults to a local development credential; Kubernetes requires the referenced Secret. - (SECRET)
