AWS_SECRET_ACCESS_KEY=seaweedfs

# From service: data-flywheel-api - Credential issued by the DEFT training service. Docker reads DEFT_API_KEY; Kubernetes requires the referenced Secret. - (SECRET)
# From service: data-flywheel-beat - Credential issued by the DEFT training service. Docker reads DEFT_API_KEY; Kubernetes requires the referenced Secret. - (SECRET)
# From service: data-flywheel-parent-worker - Credential issued by the DEFT training service. Docker reads DEFT_API_KEY; Kubernetes requires the referenced Secret. - (SECRET)
# From service: data-flywheel-worker - Credential issued by the DEFT training service. Docker reads DEFT_API_KEY; Kubernetes requires the referenced Secret. - (SECRET)
DEFT_API_KEY=fw-kpi-test

# From service: data-flywheel-api - Credential issued by the AOI Active Learning storage backend. Docker reads STORAGE_BACKEND_API_KEY; Kubernetes requires the referenced Secret. - (SECRET)
# From service: data-flywheel-beat - Credential issued by the AOI Active Learning storage backend. Docker reads STORAGE_BACKEND_API_KEY; Kubernetes requires the referenced Secret. - (SECRET)
# From service: data-flywheel-parent-worker - Credential issued by the AOI Active Learning storage backend. Docker reads STORAGE_BACKEND_API_KEY; Kubernetes requires the referenced Secret. - (SECRET)
# From service: data-flywheel-worker - Credential issued by the AOI Active Learning storage backend. Docker reads STORAGE_BACKEND_API_KEY; Kubernetes requires the referenced Secret. - (SECRET)
STORAGE_BACKEND_API_KEY=dfw-kpi-test

# Optional

# From service: deft-service - Optional Hugging Face token forwarded to TAO stage containers when gated model assets are required. - (SECRET)
# HF_TOKEN=
