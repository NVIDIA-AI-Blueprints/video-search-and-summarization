# Copy outside the repository, chmod 600, and edit. No credentials belong in Git.
VSS_PUBLIC_URL=http://YOUR_SERVER:7777
HOST_IP=YOUR_SERVER
VSS_DATA_DIR=/absolute/path/to/vss-data
FILLING_REFERENCE_VIDEO=/absolute/path/to/orangejuiceneww.mp4
FILLING_BOTTLE_CHECKPOINT=/absolute/path/to/bottle.pth
FILLING_LIQUID_CHECKPOINT=/absolute/path/to/liquid.pth
FILLING_STREAMS_FILE=/absolute/path/to/streams.json
LLM_DEVICE_ID=1
RT_VLM_DEVICE_ID=0
VLM_DEVICE_ID=0
RT_CV_DEVICE_ID=2
RT_EMBED_DEVICE_ID=3
FILLING_RECORDED_GPU_ID=2
FILLING_LIVE_GPU_ID=2
FILLING_TAB_VISIBLE=false
# Provision a new QA OpenClaw through the nightly onboarding workflow.
VSS_AGENT_BACKEND_URL=ws://host.docker.internal:18790
VSS_AGENT_BACKEND_TOKEN=REPLACE_PRIVATELY
NGC_CLI_API_KEY=REPLACE_PRIVATELY
NGC_API_KEY=REPLACE_PRIVATELY
