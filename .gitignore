.claude

# Python
__pycache__/
*.pyc

# OpenClaw plugin pack artifacts (staged by .openclaw/package.json prepack)
.openclaw/*.tgz
.openclaw/.skills.staged

# Runtime artifacts from the deploy flow — these carry live credentials
# (NGC_CLI_API_KEY, NVIDIA_API_KEY, etc.) and resolved compose state,
# so they must never be committed. Generated by dev-profile.sh / the
# vss-deploy-profile skill on every deploy.
**/generated.env
deploy/docker/resolved.yml

*.log
*checkpoint.*
.orchestrator-artifacts/*

# Generated build artifacts from the vss-build-vision-agent skill. Each
# generation writes to _builds/<build-name>/ (the build-name is derived
# from the per-generation compose-profile flag — e.g. bp_developer_in_1
# → in-1 — or chosen by the user in Step 0). Contents include resolved
# .env files with NGC_CLI_API_KEY and other credentials, so the whole
# tree is ignored.
_builds/