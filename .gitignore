.claude/*
!.claude/settings.json

# Python
__pycache__/
*.pyc
/services/agent/.coverage
/services/agent/coverage.xml
/services/agent/coverage-lib.xml
/services/agent/.wheel-smoke/
/services/agent/dist/

# Runtime artifacts from the deploy flow — these carry live credentials
# (NGC_CLI_API_KEY, NVIDIA_API_KEY, etc.) and resolved compose state,
# so they must never be committed. Generated by deployment workflows.
**/generated.env
deploy/docker/resolved.yml
deploy/docker/rag-secret.override.yml

# VSS_DATA_DIR bind mounts: uploaded media, elastic/redis/kafka state and
# agent_eval output written by the running stack. Runtime output, not source.
/data/
/deploy/docker/data-dir/

# Local deployment diagnostics and rendered configurations.
/deploy/docker/compose_config_err.txt
/deploy/docker/compose_config_err2.txt
/deploy/docker/resolved_new.yml
/deploy/docker/developer-profiles/dev-profile-base/nginx-vst-base.conf
/deploy/docker/developer-profiles/dev-profile-base/sdrc/2d/configs/config.yml
/deploy/docker/services/vios/configs/nginx-vst-base.conf
/warehouse_safety_0001_clip.mp4
/warehouse_safety_001.mp4

*.log
*checkpoint.*
.orchestrator-artifacts/*
.mdx_data/*
/local_eval/

# Generated build artifacts from the vss-build-vision-agent skill. A build name
# labels only its _builds/<name>/ directory; it is never a Compose profile.
# override.env and resolved.yml may contain credentials, so ignore the tree.
_builds/
