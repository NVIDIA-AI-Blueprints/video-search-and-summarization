.claude
.idea
**/.DS_Store

# Python
__pycache__/
*.pyc
/services/agent/.coverage
/services/agent/coverage.xml
/services/agent/coverage-lib.xml
/services/agent/.wheel-smoke/
/services/agent/dist/

# Runtime and user-managed deployment files — these carry live credentials
# (NGC_CLI_API_KEY, NVIDIA_API_KEY, etc.) and resolved compose state,
# so they must never be committed.
**/generated.env
**/*-overrides.env
deploy/docker/resolved.yml
deploy/docker/rag-secret.override.yml

# Agent-harness credentials the user drops in for the NemoClaw bring-up
# (COMPATIBLE_API_KEY). Read by the skill, never committed.
nemoclaw.env

# Regenerated by tests/integration/generate_env.sh on every run, with absolute
# paths for the machine it ran on. It was once committed carrying a developer
# path and an internal IP; untracking it removes that failure mode.
services/analytics/behavior-analytics/tests/integration/docker_compose/infra/.env
services/analytics/video-analytics-api/test/integration-test/docker_compose/infra/.env
/services/rtvi/rt-vlm/docker/.env

*.log
*checkpoint.*
.orchestrator-artifacts/*
.mdx_data/*

# Auto-generated Orchestrator MCP TLS material
assets/orchestrator_mcp_*.pem

# Generated build artifacts from the vss-build-vision-ai skill. A build name
# labels only its _builds/<name>/ directory; it is never a Compose profile.
# override.env and resolved.yml may contain credentials, so ignore the tree.
_builds/

# Packaged Helm dependencies produced by `helm dependency update` (subchart
# sources under charts/ are tracked; the .tgz artifacts are not).
deploy/helm/**/charts/*.tgz

# Working-tree snapshots staged into the harness build contexts by
# skills/vss-build-vision-ai/scripts/stage_vss_src.py (dev-loop override of
# the Dockerfiles' pinned VSS_REF fetch).
.openclaw/.vss-src/
.hermes/.vss-src/
