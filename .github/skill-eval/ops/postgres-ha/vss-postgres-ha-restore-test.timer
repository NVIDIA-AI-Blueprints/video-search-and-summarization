[Unit]
Description=Test VSS PostgreSQL HA backup restoration weekly

[Timer]
OnCalendar=Sun *-*-* 04:30:00 UTC
Persistent=true
RandomizedDelaySec=30m
Unit=vss-postgres-ha-restore-test.service

[Install]
WantedBy=timers.target
