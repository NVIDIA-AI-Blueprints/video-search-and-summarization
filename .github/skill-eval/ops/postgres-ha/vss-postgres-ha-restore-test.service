[Unit]
Description=VSS PostgreSQL HA backup restore test

[Service]
Type=oneshot
User=vss-pg-backup
Group=vss-pg-backup
EnvironmentFile=/etc/vss-postgres-ha/backup.env
Environment=GNUPGHOME=/run/vss-postgres-ha-backup-gnupg
Environment=RESTORE_ROOT=/run/vss-postgres-ha-restore-test/work
RuntimeDirectory=vss-postgres-ha-backup-gnupg vss-postgres-ha-restore-test
RuntimeDirectoryMode=0700
ExecStart=/usr/local/libexec/vss-postgres-ha/postgres-ha-restore-test.sh
Nice=10
CPUWeight=10
IOWeight=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/backups/vss-postgres-ha
LockPersonality=true
MemoryDenyWriteExecute=true
