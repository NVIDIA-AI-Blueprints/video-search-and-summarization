[Unit]
Description=Run VSS PostgreSQL HA backup hourly

[Timer]
OnCalendar=hourly
Persistent=true
RandomizedDelaySec=10m
Unit=vss-postgres-ha-backup.service

[Install]
WantedBy=timers.target
