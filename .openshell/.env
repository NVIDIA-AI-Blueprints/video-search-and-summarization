OPENSHELL_TAG=0.1.6
# Hermes publishes weekly tags; this one is 0.21.3. Also the pure harness
# image's tag, so a Hermes bump renames the image rather than overwriting it.
HERMES_REF=v2026.9.14
# The agent's own model, unrelated to any VLM a VSS deployment serves. The
# imported profile authorizes this host; another host needs another profile.
HARNESS_BASE_URL=https://inference-api.nvidia.com/v1
HARNESS_MODEL=aws/anthropic/bedrock-claude-opus-5
# That model's key, under the one name every provider profile declares.
# `provider create` seals it; fill it locally and never commit the value.
HARNESS_API_KEY=

# Optional VSS layer only — unused by the default sandbox.
VSS_REF=develop
VSS_PUBLIC_URL=http://host.openshell.internal:7777  # VSS as the sandbox reaches it
