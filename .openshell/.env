OPENSHELL_TAG=0.1.6
VSS_REF=develop
VSS_PUBLIC_URL=http://host.openshell.internal:7777  # VSS as the sandbox reaches it
# The agent's own model, unrelated to the VLM the deployment serves. The
# imported profile authorizes this host; another host needs another profile.
VSS_HERMES_BASE_URL=https://inference-api.nvidia.com/v1
VSS_HERMES_MODEL=aws/anthropic/bedrock-claude-opus-5
