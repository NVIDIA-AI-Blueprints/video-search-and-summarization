%%{init: {"fontFamily": "Arial, Liberation Sans, Helvetica, sans-serif", "flowchart": {"nodeSpacing": 45, "rankSpacing": 60, "padding": 18}, "themeVariables": {"fontSize": "22px"}}}%%
flowchart TB
    OP(["Operator"])
    IMG[/"Harness image"/]

    GW["<b>Gateway</b><br/><i>compose service</i>"]

    subgraph sb["Sandbox — created by the gateway"]
        direction TB
        WL["<b>Workload</b><br/><i>container</i>"]
        SUP["<b>Supervisor</b><br/><i>container</i>"]
        WL -->|"every connection"| SUP
    end

    subgraph vss["VSS — compose services"]
        direction LR
        UI["vss-ui"]
        HAP["HAProxy<br/>:7777"]
        SVC["Services<br/>and NIMs"]
    end

    EXT(["Inference"])

    OP -->|"compose up"| GW
    OP -->|"compose up"| vss
    OP -->|"sandbox create, exec"| GW
    OP -->|"docker build"| IMG
    IMG -->|"sandbox create<br/>--from"| WL
    GW <-->|"policy, provider<br/>credentials"| SUP
    SUP -->|"allowed"| HAP
    SUP -->|"credential added"| EXT
    UI -.->|"chat, optional"| GW

    classDef osc fill:#e8f1fb,stroke:#4a7fc1,color:#0b2e59
    classDef vssc fill:#eef7e6,stroke:#76b900,color:#1f3d00
    classDef wlc fill:#fff4e5,stroke:#e08a00,color:#4a2c00
    classDef extc fill:#f3f3f3,stroke:#888,color:#333
    class GW,SUP osc
    class HAP,UI,SVC vssc
    class WL wlc
    class OP,IMG,EXT extc
    style sb fill:#fbfbfb,stroke:#999,stroke-dasharray:6 4
