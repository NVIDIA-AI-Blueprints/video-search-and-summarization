# Default configuration for run_eval.sh
# Copy to .env and override as needed. Do not commit .env with secrets.
# CLI options and env vars override these values.

JOB_ID="${JOB_ID:-alert-bridge-eval-job-1}"
BLUEPRINT_CONFIGURATOR_PORT="${BLUEPRINT_CONFIGURATOR_PORT:-5001}"
ALERT_BRIDGE_EVALUATOR_PORT="${ALERT_BRIDGE_EVALUATOR_PORT:-5002}"
ALERT_BRIDGE_EVALUATOR_DATA_SOURCE="${ALERT_BRIDGE_EVALUATOR_DATA_SOURCE:-prometheus}"
ALERT_BRIDGE_EVALUATOR_METRIC_PROFILE="${ALERT_BRIDGE_EVALUATOR_METRIC_PROFILE:-auto}" # auto -> realtime for message_bus synthetic latency, ondemand for ondemand_api.
ALERT_BRIDGE_SYNTHETIC_SUBMISSION_MODE="${ALERT_BRIDGE_SYNTHETIC_SUBMISSION_MODE:-message_bus}" # Synthetic latency: message_bus, incident_api, or ondemand_api.
KAFKA_BOOTSTRAP_SERVERS="${KAFKA_BOOTSTRAP_SERVERS:-localhost:9092}"
KAFKA_INCIDENT_TOPIC="${KAFKA_INCIDENT_TOPIC:-mdx-incidents}"
KAFKA_ALERT_TOPIC="${KAFKA_ALERT_TOPIC:-mdx-alerts}"
KAFKA_VLM_TOPIC="${KAFKA_VLM_TOPIC:-mdx-vlm-incidents}"
ALERT_BRIDGE_NUM_WORKERS="${ALERT_BRIDGE_NUM_WORKERS:-30}"
ALERT_BRIDGE_EVALUATOR_PROMETHEUS_HOST="${ALERT_BRIDGE_EVALUATOR_PROMETHEUS_HOST:-localhost}"
ALERT_BRIDGE_EVALUATOR_PROMETHEUS_PORT="${ALERT_BRIDGE_EVALUATOR_PROMETHEUS_PORT:-9090}"
ALERT_BRIDGE_EVALUATOR_PROMETHEUS_TIMEOUT="${ALERT_BRIDGE_EVALUATOR_PROMETHEUS_TIMEOUT:-30}"
ALERT_BRIDGE_EVALUATOR_PROMETHEUS_SUMMARY_BUFFER_SECONDS="${ALERT_BRIDGE_EVALUATOR_PROMETHEUS_SUMMARY_BUFFER_SECONDS:-}"
MEDIA_BASE_URL="${MEDIA_BASE_URL:-}"
ALERT_BRIDGE_EVALUATOR_MEDIA_BASE_URL="${ALERT_BRIDGE_EVALUATOR_MEDIA_BASE_URL:-${MEDIA_BASE_URL:-}}"
ALERT_BRIDGE_EVALUATOR_VST_BASE_URL="${ALERT_BRIDGE_EVALUATOR_VST_BASE_URL:-}"
VST_SENSOR_READY_TIMEOUT_SECONDS="${VST_SENSOR_READY_TIMEOUT_SECONDS:-900}"
VST_SENSOR_READY_POLL_SECONDS="${VST_SENSOR_READY_POLL_SECONDS:-5}"
VST_REQUIRE_TIMELINES="${VST_REQUIRE_TIMELINES:-true}"
PROMETHEUS_METRICS_ENABLED="${PROMETHEUS_METRICS_ENABLED:-true}"
AUTO_SEED_AB="${AUTO_SEED_AB:-false}"
ALERT_CATEGORY="${ALERT_CATEGORY:-${ALERT_BRIDGE_INCIDENT_CATEGORY:-}}"
ALERT_BRIDGE_INCIDENT_CATEGORY="${ALERT_CATEGORY}"
NGC_CLI_API_KEY="${NGC_CLI_API_KEY:-}" # Export or set your NGC CLI API key when deploy/test image pulls need it.
CI_VSS_OSS_DIR="${CI_VSS_OSS_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
BLUEPRINTS_DIR="${BLUEPRINTS_DIR:-${CI_VSS_OSS_DIR}/video-search-and-summarization}" # VSS repo root containing deploy/helm.

# Dataset defaults use the alerts verification layout. Override these for custom datasets.
EVAL_DATASET_NAME="${EVAL_DATASET_NAME:-blueprint-eval}"
EVAL_DATASET_PATH="${EVAL_DATASET_PATH:-${CI_VSS_OSS_DIR}/eval/${EVAL_DATASET_NAME}}"
EVAL_VIDEOS_PATH="${EVAL_VIDEOS_PATH:-${EVAL_DATASET_PATH}/vss-devx-alert/videos}"
EVAL_GROUND_TRUTH_PATH="${EVAL_GROUND_TRUTH_PATH:-${EVAL_DATASET_PATH}/vss-devx-alert/events.json}"
HELM_DATASET_MOUNT_PATH="${HELM_DATASET_MOUNT_PATH:-/work/eval-dataset}"
EVAL_RESULT_DIR_PATH="${EVAL_RESULT_DIR_PATH:-${CI_VSS_OSS_DIR}/eval/eval_result}"

# Blueprint name (e.g. alerts, smartcities)
BLUEPRINT="${BLUEPRINT:-alerts}"

# Evaluation type: accuracy | latency
DEPLOYMENT_MODE="${DEPLOYMENT_MODE:-compose}"
EVAL_TYPE="${EVAL_TYPE:-accuracy}"
LATENCY_DURATION="${LATENCY_DURATION:-5m}" # ES time notation for latency eval query window (5m, 10m, 1h, 2d); also used for trigger delay
LATENCY_SOURCE_VIDEO="${LATENCY_SOURCE_VIDEO:-}" # Optional filename under EVAL_VIDEOS_PATH to replicate to NUM_SENSORS for latency eval
SYNTHETIC_ALERTS_PER_MINUTE="${SYNTHETIC_ALERTS_PER_MINUTE:-}" # Synthetic latency only; empty defaults to NUM_SENSORS alerts/min.
SYNTHETIC_ALERT_EVENT_DURATION_MS="${SYNTHETIC_ALERT_EVENT_DURATION_MS:-30000}" # Synthetic latency only; per-event duration in ms. CLI/env overrides this 30s default.

# For profile=alerts: verification | real-time
ALERTS_MODE="${ALERTS_MODE:-verification}"

# Dataset download
NVDATASET_TENANTID="${NVDATASET_TENANTID:-0573334707593577}"

# Number of sensors
NUM_SENSORS="${NUM_SENSORS:-1}"

# VIDEO UPLOAD DELAY
VIDEO_UPLOAD_DELAY="${VIDEO_UPLOAD_DELAY:-1}" # 1 second delay between subsequent video uploads to nvstreamer
REMOVE_SYNTHETIC_VIDEOS_ON_DOWN="${REMOVE_SYNTHETIC_VIDEOS_ON_DOWN:-true}"
