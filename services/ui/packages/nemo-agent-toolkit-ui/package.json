{
  "name": "@nemo-agent-toolkit/ui",
  "version": "0.1.1",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./lib/index.js",
      "types": "./lib/index.d.ts"
    },
    "./server": {
      "import": "./lib/server.js",
      "types": "./lib/server.d.ts"
    },
    "./app": {
      "import": "./lib/app.js",
      "types": "./lib/app.d.ts"
    },
    "./styles": "./lib/styles/globals.css",
    "./api/*": "./lib/pages/api/*"
  },
  "files": [
    "lib/**/*"
  ],
  "scripts": {
    "build": "next build && npm run build:lib",
    "build:lib": "rm -rf lib && swc lib-src pages components hooks utils types constants styles -d lib --config-file .swcrc && mv lib/lib-src/* lib/ && rmdir lib/lib-src && (test -f lib/contexts/RuntimeConfigContext.js && sed -i 's|\"../../utils|\"../utils|g' lib/contexts/RuntimeConfigContext.js || true) && cp lib-src/index.d.ts lib/index.d.ts && cp -r public lib/public && mkdir -p lib/styles && cp .next/static/css/*.css lib/styles/globals.css && cp next-i18next.config.js lib/",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --runInBand",
    "clean": "rm -rf .next && rm -rf lib && rm -rf node_modules",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "common": "*",
    "@datadog/browser-rum": "^5.35.1",
    "@dqbd/tiktoken": "^1.0.22",
    "@radix-ui/react-select": "^2.3.7",
    "@tabler/icons-react": "^2.47.0",
    "chart.js": "^4.5.1",
    "eventsource-parser": "^0.1.0",
    "file-saver": "^2.0.5",
    "form-data": "^4.0.6",
    "html-to-image": "^1.11.13",
    "http-proxy": "^1.18.1",
    "i18next": "^22.5.1",
    "idb": "^8.0.3",
    "isomorphic-dompurify": "^2.36.0",
    "jsonwebtoken": "^9.0.3",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.18.1",
    "lucide-react": "^0.577.0",
    "next": "15.5.24",
    "next-auth": "^4.24.15",
    "next-i18next": "^13.3.0",
    "react": "^18.3.1",
    "react-bootstrap-modal": "^4.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.3.1",
    "react-force-graph-2d": "^1.29.1",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^12.3.1",
    "react-markdown": "^10.1.0",
    "react-query": "^3.39.3",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^2.15.4",
    "rehype-mathjax": "^7.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@mozilla/readability": "^0.6.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.1",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@trivago/prettier-plugin-sort-imports": "^1.4.4",
    "@types/http-proxy": "^1.17.17",
    "@types/jsdom": "^21.1.7",
    "@types/node": "18.19.130",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^8.2.2",
    "detect-port": "^2.1.0",
    "dotenv": "^17.4.2",
    "endent": "^2.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.24",
    "gpt-3-encoder": "^1.1.4",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jsdom": "^27.4.0",
    "next-runtime-env": "^1.8.0",
    "node-fetch": "^2.7.0",
    "postcss": "8.5.26",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "^0.4.1",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.4.12",
    "typescript": "4.9.5",
    "whatwg-fetch": "^3.6.20",
    "ws": "8.21.3"
  },
  "overrides": {
    "@next/eslint-plugin-next": {
      "glob": "10.5.0"
    },
    "glob": "10.5.0",
    "jose": "^4.15.9",
    "mdast-util-to-hast": "13.2.1"
  }
}
