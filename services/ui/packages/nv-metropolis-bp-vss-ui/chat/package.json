{
  "name": "@nv-metropolis-bp-vss-ui/chat",
  "version": "3.3-dev",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./lib/index.js",
      "types": "./lib/index.d.ts"
    },
    "./server": {
      "import": "./lib/server.js",
      "require": "./lib/server.js",
      "types": "./lib/server.d.ts"
    },
    "./api": {
      "import": "./lib/api.js",
      "require": "./lib/api.js",
      "types": "./lib/api.d.ts"
    }
  },
  "files": [
    "lib/**/*"
  ],
  "scripts": {
    "build": "rm -rf lib && swc lib-src -d lib --config-file .swcrc && mv lib/lib-src/* lib/ && rmdir lib/lib-src && tsc --project tsconfig.lib.json",
    "dev": "swc lib-src -d lib --config-file .swcrc -w",
    "clean": "rm -rf lib && rm -rf node_modules",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@nvidia/foundations-react-core": "0.600.0",
    "@tabler/icons-react": "^2.9.0",
    "chart.js": "^4.4.1",
    "common": "*",
    "eventsource-parser": "^0.1.0",
    "file-saver": "^2.0.5",
    "idb": "^8.0.3",
    "isomorphic-dompurify": "^2.26.0",
    "next": "15.5.18",
    "next-i18next": "^13.2.2",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@swc/cli": "^0.8.0",
    "@swc/core": "^1.13.19",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^16.3.2",
    "@types/react": "18.0.28",
    "@types/file-saver": "^2.0.7",
    "@types/react-dom": "18.0.11",
    "@types/uuid": "^10.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "ts-jest": "^29.4.9",
    "typescript": "4.9.5",
    "whatwg-fetch": "^3.6.19"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
