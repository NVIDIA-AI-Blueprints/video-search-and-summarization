{
  "compilerOptions": {
    "target": "es2019",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@nv-metropolis-bp-vss-ui/warehouse-analytics": ["../warehouse-analytics/lib-src/index.ts"],
      "@nv-metropolis-bp-vss-ui/warehouse-analytics/server": ["../warehouse-analytics/lib-src/server.ts"]
    }
  },
  "include": ["lib-src/**/*"],
  "exclude": ["node_modules", "lib"]
}

