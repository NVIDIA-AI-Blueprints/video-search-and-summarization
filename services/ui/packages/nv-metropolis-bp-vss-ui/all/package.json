{
  "name": "@nv-metropolis-bp-vss-ui/all",
  "version": "3.3-dev",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./lib/index.js",
      "types": "./lib/index.d.ts"
    },
    "./server": {
      "import": "./lib/server.js",
      "require": "./lib/server.js",
      "types": "./lib/server.d.ts"
    }
  },
  "files": [
    "lib/**/*"
  ],
  "scripts": {
    "build": "rm -rf lib && swc lib-src -d lib --config-file .swcrc && mv lib/lib-src/* lib/ && rmdir lib/lib-src && tsc --project tsconfig.lib.json",
    "dev": "swc lib-src -d lib --config-file .swcrc -w",
    "clean": "rm -rf lib && rm -rf node_modules",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nv-metropolis-bp-vss-ui/alerts": "*",
    "@nv-metropolis-bp-vss-ui/dashboard": "*",
    "@nv-metropolis-bp-vss-ui/map": "*",
    "@nv-metropolis-bp-vss-ui/search": "*",
    "@nv-metropolis-bp-vss-ui/video-management": "*",
    "jsdom": "27.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@swc/cli": "^0.8.1",
    "jest-environment-jsdom": "^30.4.1",
    "@swc/core": "^1.16.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
