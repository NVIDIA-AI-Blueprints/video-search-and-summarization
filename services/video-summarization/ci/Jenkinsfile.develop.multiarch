    }

    post {
        always {
            script {
                echo "Pipeline completed with status: ${currentBuild.result ?: 'SUCCESS'}"
            }
        }
        failure {
            script {
                echo "Pipeline failed! Check logs for details."
            }
        }
        success {
            script {
                echo "Pipeline completed successfully!"
            }
        }
    }
}
