# Environment variables for docker-compose.yml
# This file contains all environment variables defined in the blueprint.
#
# .env file format: Simple KEY=value pairs (NO ${VAR} syntax allowed)
# - Set values directly: NGC_API_KEY=your_key_here
# - Or set via shell: export NGC_API_KEY=mykey && docker compose up
#
# Variables with defaults are pre-filled.
# Variables requiring paths: Use absolute paths (e.g., /home/username/.cache/nim)
# Note: Do NOT use ~ or ${HOME} - they behave unexpectedly with 'sudo docker compose'
#
# Grouped by volume paths, shared variables, then service-specific variables.

# ==============================================================================
# Service: elasticsearch
# ==============================================================================

# From service: elasticsearch - Elasticsearch node discovery mode
discovery.type=single-node

# From service: elasticsearch - Enable or disable X-Pack security
xpack.security.enabled=false

# ==============================================================================
# Service: lvs
# ==============================================================================

# From service: lvs - Default VLM system prompt for alert review
ALERT_REVIEW_DEFAULT_VLM_SYSTEM_PROMPT=

# From service: lvs - Base directory for alert review media
ALERT_REVIEW_MEDIA_BASE_DIR=

# From service: lvs - Skip safety guardrails during alert review
ALERT_REVIEW_SKIP_GUARDRAILS=true

# From service: lvs - ArangoDB username
ARANGO_DB_USERNAME=root

# From service: lvs - ArangoDB password
ARANGO_DB_PASSWORD=passroot

# From service: lvs - API key for Azure OpenAI - (SECRET)
AZURE_OPENAI_API_KEY=

# From service: lvs - Endpoint URL for Azure OpenAI
AZURE_OPENAI_ENDPOINT=

# From service: lvs - Backend HTTP service port
LVS_BACKEND_PORT=38111

# From service: lvs - ca-rag-config path
CA_RAG_CONFIG=/opt/nvidia/via/config/default_config.yaml

# From service: lvs - Disable context-aware RAG features
DISABLE_CA_RAG=false

# From service: lvs - Disable computer-vision pipeline
DISABLE_CV_PIPELINE=true

# From service: lvs - Disable serving frontend UI
DISABLE_FRONTEND=false

# From service: lvs - Disable safety guardrails
DISABLE_GUARDRAILS=true

# From service: lvs - Enable audio processing features
ENABLE_AUDIO=false

# From service: lvs - Enable dense captioning
ENABLE_DENSE_CAPTION=

# From service: lvs - Enable readiness check for Riva server
ENABLE_RIVA_SERVER_READINESS_CHECK=

# From service: lvs - Enable internal health evaluation
ENABLE_VIA_HEALTH_EVAL=false

# From service: lvs - connection: elasticsearch - Connection template resolves to actual Elasticsearch host name
ES_HOST=elasticsearch

# From service: lvs - connection: elasticsearch - Connection template resolves to actual Elasticsearch REST port
ES_PORT=9200

# From service: lvs - connection: elasticsearch-transport - Connection template resolves to actual Elasticsearch transport port
ES_TRANSPORT_PORT=9300

# From service: lvs - Force reset of context-aware RAG state
FORCE_CA_RAG_RESET=

# From service: lvs - Force software AV1 decoding
FORCE_SW_AV1_DECODER=

# From service: lvs - Frontend HTTP service port
FRONTEND_PORT=38123

# From service: lvs - Inference interval for GDINO
GDINO_INFERENCE_INTERVAL=

# From service: lvs - Path to GroundingDINO model
GDINO_MODEL_PATH=

# From service: lvs - Graph DB password
GRAPH_DB_PASSWORD=passneo4j

# From service: lvs - Graph DB username
GRAPH_DB_USERNAME=neo4j

# From service: lvs - Install proprietary codecs
INSTALL_PROPRIETARY_CODECS=false

# From service: lvs - connection: elasticsearch - Database backend type for Elasticsearch
LVS_DATABASE_BACKEND=elasticsearch_db

# From service: lvs - Enable LVS Embedding NIM - set to True if embedding is in use
LVS_EMB_ENABLE=false

# From service: lvs - Enable MCP server features
LVS_ENABLE_MCP=true

# From service: lvs - Enable LLM connection
LVS_LLM_ENABLE=true

# From service: lvs - Connection template resolves to actual LLM host name
# Point this at a reachable OpenAI-compatible LLM endpoint.
LVS_LLM_HOST=<your-llm-host>

# From service: lvs - Connection template resolves to actual LLM port
LVS_LLM_PORT=31081

# From service: lvs - LLM model name passed to /v1/chat/completions.
# Must match a model id served by LVS_LLM_HOST:LVS_LLM_PORT (verified via
# `curl http://<your-llm-host>:<your-llm-port>/v1/models`). Same value as the compose default
# `${LVS_LLM_MODEL_NAME:-openai/gpt-oss-20b}` — set explicitly here so future
# host repoints make the host/model coupling obvious in one place.
LVS_LLM_MODEL_NAME=nvidia/nvidia-nemotron-nano-9b-v2

# From service: lvs - Backend MCP service port
LVS_MCP_PORT=38112

# From service: lvs - Maximum guardrail instances
MAX_RAILS_INSTANCES=

# From service: lvs - MinIO secret key
MINIO_PASSWORD=minio123

# From service: lvs - MinIO access key
MINIO_USERNAME=minio

# From service: lvs - Workload chunks per GPU for CV
NUM_CV_CHUNKS_PER_GPU=

# From service: lvs - Number of GPUs to use
NUM_GPUS=

# From service: lvs - Number of VLM worker processes
NUM_VLM_PROCS=

# From service: lvs - API key for NVIDIA services - (SECRET)
NVIDIA_API_KEY=

# From service: lvs - Maximum tiles for VILA video
NVILA_VIDEO_MAX_TILES=

# From service: lvs - Client ID for NVIDIA LLM Gateway - (SECRET)
NV_LLMG_CLIENT_ID=

# From service: lvs - Client secret for NVIDIA LLM Gateway - (SECRET)
NV_LLMG_CLIENT_SECRET=

# From service: lvs - API key for OpenAI-compatible services, eg remote VLM case - (SECRET)
OPENAI_API_KEY=

# From service: lvs - OpenAI API version
OPENAI_API_VERSION=

# From service: lvs - Riva ASR gRPC port
RIVA_ASR_GRPC_PORT=50051

# From service: lvs - Riva ASR HTTP port
RIVA_ASR_HTTP_PORT=

# From service: lvs - Default Riva ASR model name
RIVA_ASR_MODEL_NAME=

# From service: lvs - API key for Riva ASR server - (SECRET)
RIVA_ASR_SERVER_API_KEY=

# From service: lvs - Function identifier for Riva ASR
RIVA_ASR_SERVER_FUNC_ID=

# From service: lvs - Riva ASR server is NIM
RIVA_ASR_SERVER_IS_NIM=true

# From service: lvs - Riva ASR server URI
RIVA_ASR_SERVER_URI=parakeet-ctc-asr

# From service: lvs - Use SSL for Riva ASR
RIVA_ASR_SERVER_USE_SSL=false

# From service: lvs - Save processed chunk frames
SAVE_CHUNK_FRAMES=false

# From service: lvs - Save chunk frames to MinIO
SAVE_CHUNK_FRAMES_MINIO=false

# From service: lvs - Path to TensorRT engine
TRT_ENGINE_PATH=

# From service: lvs - TRT-LLM KV cache memory usage fraction
TRT_LLM_MEM_USAGE_FRACTION=

# From service: lvs - TensorRT-LLM mode
TRT_LLM_MODE=

# From service: lvs - Enable OTel for context RAG
VIA_CTX_RAG_ENABLE_OTEL=false

# From service: lvs - Exporter for context RAG telemetry
VIA_CTX_RAG_EXPORTER=console

# From service: lvs - OTel endpoint for context RAG
VIA_CTX_RAG_OTEL_ENDPOINT=http://otel-collector:4318

# From service: lvs - Enable OpenTelemetry
VIA_ENABLE_OTEL=false

# From service: lvs - OTel collector endpoint
VIA_OTEL_ENDPOINT=http://otel-collector:4318

# From service: lvs - OTel exporter type
VIA_OTEL_EXPORTER=console

# From service: lvs - API key for VLM provider - (SECRET)
VIA_VLM_API_KEY=

# From service: lvs - Combine host and port to form base URL for LVS VLM
VIA_VLM_ENDPOINT=http://<your-vlm-host>:<your-vlm-port>/v1

# From service: lvs - NGC resource for VILA engine
VILA_ENGINE_NGC_RESOURCE=

# From service: lvs - Force rebuild of VILA engine
VILA_FORCE_ENGINE_BUILD=false

# From service: lvs - Path to VILA LoRA weights
VILA_LORA_PATH=

# From service: lvs - GPU memory utilization for VLLM
VLLM_GPU_MEMORY_UTILIZATION=0.65

# From service: lvs - Batch size for VLM processing
VLM_BATCH_SIZE=

# From service: lvs - Default frames per chunk for VLM
VLM_DEFAULT_NUM_FRAMES_PER_CHUNK=

# From service: lvs - VLM input height
VLM_INPUT_HEIGHT=

# From service: lvs - VLM input width
VLM_INPUT_WIDTH=

# From service: lvs - System prompt for VLM
VLM_SYSTEM_PROMPT=

# From service: lvs - Cache video embeddings
VSS_CACHE_VIDEO_EMBEDS=false

# From service: lvs - Extra runtime arguments
VSS_EXTRA_ARGS=

# From service: lvs - Log level for LVS components
VSS_LOG_LEVEL=DEBUG

# From service: lvs - GPUs per VLM process
VSS_NUM_GPUS_PER_VLM_PROC=

# From service: lvs - RTSP latency setting
VSS_RTSP_LATENCY=

# From service: lvs - RTSP timeout setting
VSS_RTSP_TIMEOUT=

# ==============================================================================
# RTVI Integration
#
# RTVI VLM is now the only supported VLM backend (the legacy `USE_RTVI_VLM`
# and `RTVI_VLM_URL_PASSTHROUGH` env knobs were removed and are now hard-
# wired to true on the LVS side). CI starts the in-stack rtvi-vlm service
# with `--profile rtvi`, so LVS uses the compose default
# `${RTVI_VLM_URL:-http://rtvi-vlm:8000}`. To point at an external RTVI VLM
# instead, explicitly set RTVI_VLM_URL below.
# ==============================================================================

# RTVI VLM image
RTVI_VLM_IMAGE=nvcr.io/nvidia/vss-core/vss-rt-vlm:3.2.1

# Host port for RTVI VLM (internal port stays 8000; changed to avoid conflict with existing rtvi_vlm)
RTVI_VLM_PORT=8420

# GPU device for RTVI VLM (separate from LVS GPU)
RTVI_VLM_GPU=0

KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=kafka:9092           # internal Docker DNS
KAFKA_TOPIC=mdx-vlm-captions
KAFKA_STRUCTURED_SUMMARY_TOPIC=mdx-structured-events-summary

# Host-side port mappings for the in-stack Kafka broker. Override either
# value to avoid collisions when running multiple Kafka stacks on the same
# host (e.g. another LVS or rtvi-microservices stack already bound to 9092
# or 9094). The container-internal ports stay 9092 / 9094, so in-Docker
# clients keep using `kafka:9092` regardless.
#
# IMPORTANT: KAFKA_EXTERNAL_PORT is also consumed by the broker's
# KAFKA_ADVERTISED_LISTENERS so the EXTERNAL listener tells host-side
# clients the right port to reconnect to. Don't change just one or the
# other.
KAFKA_PORT=9192
KAFKA_EXTERNAL_PORT=9194
# Hostname host-side / cross-host clients should be told to reconnect to.
# `localhost` works for same-host clients; set to a routable hostname / IP
# (e.g. host.docker.internal, or the host's LAN IP) for cross-host setups.
KAFKA_ADVERTISED_HOST=localhost
# Enable authenticated asset download

ASSET_DOWNLOAD_SSL_SKIP_VERIFY_DOMAINS=
ASSET_DOWNLOAD_MAX_REDIRECTS=5
ASSET_DOWNLOAD_AUTH_TOKENS='<asset-host>=Bearer <TOKEN>'

# From service: lvs - Enforce empty model path to avoid downloading VLM models during deployment
MODEL_PATH=

# From service: lvs - API key for NVIDIA GPU Cloud access - (SECRET)
NGC_API_KEY=

# From service: rtvi - VLM model selection. External served: openai-compat
VLM_MODEL_TO_USE=openai-compat
VIA_VLM_OPENAI_MODEL_DEPLOYMENT_NAME=nvidia/cosmos3-nano-reasoner
