# Required for nvcr.io image pulls and NIM model access.
NGC_API_KEY=

# Required by the default CA-RAG summarization config.
NVIDIA_API_KEY=

# Usually required for gated HuggingFace model downloads.
HF_TOKEN=

# Optional provider keys for model swaps.
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=

# LVS ports and features.
BACKEND_PORT=38111
LVS_MCP_PORT=38112
LVS_ENABLE_MCP=true
VSS_LOG_LEVEL=DEBUG
ENABLE_AUDIO=false
ENABLE_DENSE_CAPTION=false
LVS_KAFKA_ENABLED=true
RTVI_KAFKA_ENABLED=true
KAFKA_TOPIC=mdx-vlm-captions
KAFKA_STRUCTURED_SUMMARY_TOPIC=mdx-structured-events-summary
LVS_DISABLE_DB_RESET_ON_REQUEST_DONE=true
VIA_DEV_API=true

# Logstash Kafka -> Elasticsearch pipeline.
LOGSTASH_HEAP=512m
LOGSTASH_API_PORT=9600
KAFKA_CONSUMER_GROUP=logstash-vlm-es-writer
LOGSTASH_CODEC_PROTOBUF_VERSION=1.3.0
LVS_EMB_DIMENSIONS=1024
LVS_EMB_SEED=42

# Default database backend.
LVS_DATABASE_BACKEND=elasticsearch_db

# RT-VLM defaults.
RTVI_VLM_MODEL_TO_USE=cosmos-reason2
RTVI_VLM_MODEL_PATH=git:https://huggingface.co/nvidia/Cosmos-Reason2-8B
VLLM_GPU_MEMORY_UTILIZATION=0.324
VLM_DEFAULT_NUM_FRAMES_PER_SECOND_OR_FIXED_FRAMES_CHUNK=30

# GPT-OSS-20B NIM defaults.
NIM_SERVER_PORT=9233
NIM_TAGS_SELECTOR=tp=1,precision=mxfp4
NIM_MODEL_PROFILE=66fb3113efd2aae1b0a3bfa2a375de5fe1cc1b557abac4eb271730482a26ae8e
NIM_GPU_MEM_FRACTION=0.526
NIM_KVCACHE_PERCENT=0.526

# Optional host bind mounts. Leave unset to use the compose's dummy/volume behavior.
# ASSET_STORAGE_DIR=/data/lvs/assets
# EXAMPLE_STREAMS_DIR=/data/lvs/example-streams
# VIA_LOG_DIR=/data/lvs/logs
# RTVI_ASSET_DIR=/data/lvs/rtvi-assets
# RTVI_LOG_DIR=/data/lvs/rtvi-logs

# Recommended host-backed NIM cache. This avoids re-downloading GPT-OSS-20B
# artifacts after `docker compose down -v` and can be reused by other NIM
# compose deployments on this host.
LOCAL_NIM_CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/nim
NGC_MODEL_CACHE=rtvi-ngc-model-cache

# Kafka: leave empty to let configmaps/kafka-entrypoint.sh generate and persist one.
KAFKA_CLUSTER_ID=

# Milvus profile (db-milvus).
# LVS_DATABASE_BACKEND=vector_db
# MILVUS_DB_HOST=milvus-standalone
# MILVUS_DB_GRPC_PORT=19530

# Neo4j profile (db-neo4j). Override weak defaults before enabling.
# LVS_DATABASE_BACKEND=graph_db
# GRAPH_DB_HOST=graph-db
# GRAPH_DB_BOLT_PORT=7687
# GRAPH_DB_USERNAME=neo4j
# GRAPH_DB_PASSWORD=<strong-password>
# NEO4J_AUTH=neo4j/<strong-password>
# LVS_EMB_ENABLE=true
# LVS_EMB_BASE_URL=http://<embedding-nim>:8000/v1
# LVS_EMB_MODEL_NAME=<embedding-model-id>

# ArangoDB profile (db-arango). Override weak defaults before enabling.
# LVS_DATABASE_BACKEND=graph_db_arango
# ARANGO_DB_HOST=arango-db
# ARANGO_DB_PORT=8529
# ARANGO_DB_USERNAME=root
# ARANGO_DB_PASSWORD=<strong-password>
# ARANGO_ROOT_PASSWORD=<strong-password>
# LVS_EMB_ENABLE=true
# LVS_EMB_BASE_URL=http://<embedding-nim>:8000/v1
# LVS_EMB_MODEL_NAME=<embedding-model-id>

# Optional observability.
VIA_ENABLE_OTEL=false
VIA_OTEL_ENDPOINT=http://otel-collector:4318
VIA_OTEL_EXPORTER=console
VIA_CTX_RAG_ENABLE_OTEL=false
VIA_CTX_RAG_EXPORTER=console
VIA_CTX_RAG_OTEL_ENDPOINT=http://otel-collector:4318

# Optional audio / ASR.
RIVA_ASR_SERVER_URI=parakeet-ctc-asr
RIVA_ASR_SERVER_IS_NIM=true
RIVA_ASR_SERVER_USE_SSL=false
RIVA_ASR_GRPC_PORT=50051
RIVA_ASR_SERVER_API_KEY=
