# AOI #2 inference service
AOI2_BASE_URL=http://localhost:5000
AOI2_BATCH_PATH=/v1/predict:batch
AOI2_READY_PATH=/v1/ready

# Kafka (Message Bus)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=aoi-inference-results

# Batching / parallelism
BATCH_SIZE=16
SEMAPHORE_PERMITS=48
INTAKE_QUEUE_SIZE=64

# Crop encoding format sent to AOI #2 (JPEG or PNG)
CROP_FORMAT=JPEG

# Limits & timeouts
MAX_REQUEST_BYTES=52428800
INFERENCE_TIMEOUT_S=60.0
BOARD_DEADLINE_S=300.0

# Retry
MAX_RETRIES=3
RETRY_BASE_DELAY_S=1.0
RETRY_MAX_DELAY_S=30.0
RETRY_JITTER=true

# Kafka outage buffer
KAFKA_BUFFER_MAX=1000
KAFKA_REPLAY_INTERVAL_S=5.0

DEPLOYMENT_TYPE=Shadow

LOG_LEVEL=INFO
