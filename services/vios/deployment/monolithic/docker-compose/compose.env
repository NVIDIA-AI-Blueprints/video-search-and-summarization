HOST_IP=<Host IP> ### change me

# You can config the VST configs from below (Must be absolute path)
VST_CONFIG_PATH=/home/ubuntu/vms_shim/deployment/monolithic/docker-compose/configs ### change me

# You can config the VST volume from below (Must be absolute path)
VST_VOLUME=/home/ubuntu/vms_shim/deployment/monolithic/docker-compose/vst_volume ### change me

###################### VST service #####################################
VST_IMAGE=nvcr.io/rxczgrvsg8nx/vst-dev/vst:2.1.0-26.05.2

# vst_rtsp, onvif, milestone_onvif
VST_ADAPTOR=vst_rtsp

VST_HTTP_PORT=30888
VST_INGRESS_ENDPOINT=${HOST_IP}:${VST_HTTP_PORT}/vst
##########################################################################

###################### VST Paths and Data Configuration ##################
VST_DATA_PATH=${VST_VOLUME}/vst_data
VST_VIDEO_STORAGE_PATH=${VST_VOLUME}/vst_video
VST_LOGS=${VST_DATA_PATH}/logs
VST_TEMP_FILES_PATH=${VST_VOLUME}/vst_temp_files
CLIP_STORAGE_PATH=${VST_VOLUME}/clip_storage
##########################################################################

###################### MCP server configs ###########################
VST_MCP_IMAGE=nvcr.io/rxczgrvsg8nx/vst-dev/vst-mcp:2.1.0-26.05.2

MCP_GATEWAY_CPP_API_BASE_URL=http://${HOST_IP}:30888/vst
MCP_GATEWAY_CPP_API_TIMEOUT=30

MCP_GATEWAY_SERVER_NAME=vst-mcp-server
MCP_GATEWAY_SERVER_VERSION=1.0.0
MCP_GATEWAY_SERVER_HOST=${HOST_IP}
MCP_GATEWAY_SERVER_PORT=8001

MCP_GATEWAY_LOG_LEVEL=INFO
MCP_GATEWAY_ENABLE_JSONRPC_LOGGING=true
##########################################################################

###################### Additional Packages Configuration #################
# Additional packages are needed for certain use cases (e.g., audio, software encoding-decoding, video downloading).
# To install these packages, set VST_INSTALL_ADDITIONAL_PACKAGES=true.
VST_INSTALL_ADDITIONAL_PACKAGES=true
##########################################################################
