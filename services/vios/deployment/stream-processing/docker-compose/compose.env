HOST_IP=<Host IP> ### change me

# You can config the VST configs from below (Must be absolute path)
VST_CONFIG_PATH=/home/ubuntu/vms_shim/deployment/stream-processing/docker-compose/configs ### change me

# You can config the VST volume from below (Must be absolute path)
VST_VOLUME=/home/ubuntu/vms_shim/deployment/stream-processing/docker-compose/vst_volume ### change me

######################################################################
#                      DEPLOYMENT MODE TOGGLE                        #
######################################################################
# VST supports two deployment topologies. Pick ONE block below by uncommenting it
#
# DIRECT MODE : Without sdr-controller.Single-pod only — Scaling not supported.
# SDRC MODE (default): with sdr-controller. Required for any multi-pod (scaling). Single-pod also works here.

# ---------- DIRECT MODE (uncomment below for direct mode) ----------
#VST_USE_SDRC=false
#NGINX_MODE=vst
#STREAM_PROCESSOR_MODULE_ENDPOINT=http://${HOST_IP}:30001


# ---------- SDRC MODE (comment below to use direct mode) ----------
VST_USE_SDRC=true
COMPOSE_PROFILES=sdrc
# vst-sdrc for vst-type adaptors; use "mms" instead for milestone_onvif or
# milestone_soap (see the Milestone adaptor block below).
NGINX_MODE=vst-sdrc
STREAM_PROCESSOR_MODULE_ENDPOINT=http://${HOST_IP}:10000

######################################################################


###################### Stream-Processor service #####################################
VST_STREAM_PROCESSOR_IMAGE=nvcr.io/nvstaging/vss-core/vss-vios-streamprocessing:1.4.0-26.08.1

STREAM_PROCESSOR_HTTP_PORT_1=30001
# [Pod 2 disabled] Uncomment to enable second stream-processing pod
#STREAM_PROCESSOR_HTTP_PORT_2=30002

RTSP_SERVER_PORT_1=30554 ### change me if you want to stream more than 100 streams per pod
# [Pod 2 disabled] Uncomment to enable RTSP server for second pod
#RTSP_SERVER_PORT_2=30564 ### change me if you want to stream more than 100 streams per pod
##########################################################################

###################### SENSOR service #####################################
VST_SENSOR_IMAGE=nvcr.io/nvstaging/vss-core/vss-vios-sensor:1.4.0-26.08.1
# vst_rtsp, onvif, milestone_onvif, milestone_soap, streamer, remote, native, test_vms
# For an mms-type adaptor also see the "Milestone adaptor" block below.
VST_ADAPTOR=vst_rtsp

SENSOR_HTTP_PORT=30000
SENSOR_MODULE_ENDPOINT=http://${HOST_IP}:${SENSOR_HTTP_PORT}
##########################################################################

###################### Milestone adaptor #################################
# Only consumed when VST_ADAPTOR is an mms-type adaptor (milestone_onvif,
# milestone_soap). Ignored for every other adaptor.
#
# To point this deployment at a Milestone VMS:
#   1. VST_ADAPTOR=milestone_onvif   -- in the SENSOR service block above.
#   2. NGINX_MODE=mms                -- in the DEPLOYMENT MODE TOGGLE block above.
#      Use plain "mms" in BOTH direct and SDRC mode: only nginx-vst.conf,
#      nginx-vst-sdrc.conf and nginx-mms.conf exist, there is no mms-sdrc variant.
#   3. In configs/adaptor_config.json set "enabled":true on the entry whose "name"
#      matches VST_ADAPTOR, and "enabled":false on every other entry.
#   4. Fill in the four fields below (or leave them blank and put the values in
#      adaptor_config.json instead -- either source works, see the note below).
#   5. In configs/vst_config.json set "always_recording": false. Milestone keeps the
#      recordings on the VMS, so leaving it true makes the stream-processor record
#      the same streams a second time locally. Leave it true for every non-mms
#      adaptor, where local recording is the intended behaviour.
#
# Precedence: a NON-EMPTY value here overrides the matching field in
# adaptor_config.json; leave all four blank to let the JSON be authoritative.
# Set them in one place only, otherwise the JSON looks authoritative while these win.
# Consumed by sensor-ms (the stream-processor does not read adaptor credentials).
#
# NOTE: ADAPTOR_PASSWORD is a plaintext secret. Do not commit a filled-in value --
# run: git update-index --skip-worktree <path-to-this-file>
#
# Every value here is a plain string: do NOT wrap it in quotes and do NOT put a
# trailing "#" comment on these four lines. Compose strips surrounding quotes, so
# "580" and 580 are identical, but on a BLANK key it does not strip a trailing
# comment -- `ADAPTOR_IP=   ### example` sets the IP to the literal text
# "### example", which then overrides adaptor_config.json. Expected values:
#
#   ADAPTOR_IP        VMS host, IPv4 or hostname. No scheme, no port.  e.g. 10.0.0.5
#   ADAPTOR_USER      VMS account name.                                e.g. vms-user
#   ADAPTOR_PASSWORD  That account's password, plaintext.
#   ADAPTOR_PORT      Adaptor API port. 580 for milestone_onvif (ONVIF
#                     Bridge default), 80 for milestone_soap.
ADAPTOR_IP=
ADAPTOR_USER=
ADAPTOR_PASSWORD=
ADAPTOR_PORT=
##########################################################################

###################### Base Infrastructure Images ########################
POSTGRES_IMAGE=postgres:17.10-alpine
NGINX_IMAGE=nvcr.io/nvstaging/vss-core/vss-vios-ingress:1.4.0-26.08.1
REDIS_IMAGE=redis:8.10.0-alpine

# Public-facing ingress URL. Same in both modes.
VST_INGRESS_ENDPOINT=${HOST_IP}:30888/vst
##########################################################################

###################### SDRC (sdr-mw-l with embedded Envoy) ################
# Only consumed when COMPOSE_PROFILES=sdrc above. Ignored in DIRECT MODE
# because the entire sdrc subgraph is skipped.
#
# sdr-mw-l listens on:
#   :5003  control REST API (WDM_CONTROLLER_PORT)
#   :8011  direct listener for sensor-ms (WDM_SDRC_DIRECT_LISTENER_PORT)
#   :9902  envoy admin (ENVOY_ADMIN_PORT)
#   :10000 envoy data-plane (WDM_MS_LISTENER_PORT, from config.yml)
SDR_MW_L_IMAGE=nvcr.io/nvstaging/vss-core/sdr-mw-l:3.4.0-2026.08.3-1

# Number of streams the workload should advertise to SDRC. Also drives
# WDM_WL_THRESHOLD (per-pod stream cap) when the config.yml template is rendered.
NUM_STREAMS=100

# Per-pod stream cap reflected back into env for downstream tooling.
MAX_STREAMS_PER_POD=${NUM_STREAMS}
##########################################################################

###################### Monitoring Images #####################

SENSOR_PROMETHEUS_PORT=8080
STREAM_PROCESSOR_PROMETHEUS_PORT_1=8087
# [Pod 2 disabled] Uncomment to enable Prometheus metrics for second pod
#STREAM_PROCESSOR_PROMETHEUS_PORT_2=8088
##########################################################################

###################### VST Paths and Data Configuration ##################
VST_DATA_PATH=${VST_VOLUME}/vst_data
VST_VIDEO_STORAGE_PATH=${VST_VOLUME}/vst_video

# VST storage size settings in MB
VST_VIDEO_STORAGE_SIZE_MB=100000

VST_LOGS=${VST_DATA_PATH}/logs
VST_TEMP_FILES_PATH=${VST_VOLUME}/vst_temp_files
CLIP_STORAGE_PATH=${VST_VOLUME}/clip_storage
##########################################################################

###################### Database Configuration ############################
CENTRALIZE_DB_NAME=nvcentralizedb
CENTRALIZE_DB_USERNAME=vst
CENTRALIZE_DB_PASSWORD=vios123
CENTRALIZE_DB_PORT=5432
CENTRALIZE_DB_HOSTADDR=${HOST_IP}
##########################################################################

######################### redis/kafka notication ########################
#VST_ENABLE_NOTIFICATION=true

## Redis Configuration
REDIS_HOSTADDR=${HOST_IP}
REDIS_PORT=6379
REDIS_MSG_KEY=vst_events

## Kafka Configuration
KAFKA_BOOTSTRAP_URL=${HOST_IP}:9092
KAFKA_MSG_KEY=sensor.id
##########################################################################

###################### Additional Packages Configuration #################
# Additional packages are needed for certain use cases (e.g., audio, software encoding-decoding, video downloading).
# To install these packages, set VST_INSTALL_ADDITIONAL_PACKAGES=true.
VST_INSTALL_ADDITIONAL_PACKAGES=true
##########################################################################
