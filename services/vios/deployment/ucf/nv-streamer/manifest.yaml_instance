type: msapplication
specVersion: 2.5.0
name:  ucf.svc.nvstreamer
chartName: nvstreamer-instance
description: media streaming service
version: 0.0.20
displayName: "Media streaming server"
category:
  functional: "Media Service"
  industry: "IVA"
tags: []
keywords: []
eula: ""
nSpectId: NSPECT-1H82-JYCQ


ingress-endpoints:
  - name: http-in
    description: Nvstreamer http api
    scheme: http
    data-flow: in-out

#egress-endpoints:
