HOST_IP=<Host IP> ### change me

# You can config the VST configs from below (Must be absolute path)
VST_CONFIG_PATH=/home/ubuntu/vms_shim/deployment/scaling/docker-compose/configs ### change me

# You can config the VST volume from below (Must be absolute path)
VST_VOLUME=/home/ubuntu/vms_shim/deployment/scaling/docker-compose/vst_volume ### change me

###################### Base Infrastructure Images ########################
POSTGRES_IMAGE=postgres:17.9-alpine
NGINX_IMAGE=nvcr.io/rxczgrvsg8nx/vst-dev/vst-ingress:2.1.0-26.05.2
REDIS_IMAGE=redis:8.6.2-alpine

# NGINX Configuration Mode
# NGINX_MODE=vst  → uses nginx-vst.conf (timelines NOT routed to sensor, stays with storage service)
# NGINX_MODE=mms  → uses nginx-mms.conf (timelines routed to sensor service)
NGINX_MODE=vst
VST_INGRESS_ENDPOINT=${HOST_IP}:30888/vst
##########################################################################

###################### SDR and Supporting Images #########################
SDR_IMAGE=nvcr.io/nv-metropolis-dev/metropolis-analytic/sdr:2.6.2-prd.8
ENVOY_PROXY_IMAGE=nvcr.io/nv-metropolis-dev/metropolis-analytic/envoy-proxy:0.15.0-prd
##########################################################################

###################### Storage and Monitoring Images #####################
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z
PROMETHEUS_IMAGE=prom/prometheus:v3.11.3
GRAFANA_IMAGE=grafana/grafana:13.0
##########################################################################

###################### VST Paths and Data Configuration ##################
VST_DATA_PATH=${VST_VOLUME}/vst_data
VST_VIDEO_STORAGE_PATH=${VST_VOLUME}/vst_video
VST_LOGS=${VST_DATA_PATH}/logs
VST_TEMP_FILES_PATH=${VST_VOLUME}/vst_temp_files ### change me
##########################################################################

###################### Database Configuration ############################
CENTRALIZE_DB_NAME=nvcentralizedb
CENTRALIZE_DB_USERNAME=vst
CENTRALIZE_DB_PASSWORD=nvidia123
CENTRALIZE_DB_PORT=5432
CENTRALIZE_DB_HOSTADDR=${HOST_IP}
##########################################################################

###################### SENSOR service #####################################
VST_SENSOR_IMAGE=nvcr.io/rxczgrvsg8nx/vst-dev/vst-sensor:2.1.0-26.05.2

# vst_rtsp, onvif, milestone_onvif
VST_ADAPTOR=vst_rtsp

SENSOR_HTTP_PORT=30000
SENSOR_MODULE_ENDPOINT=http://${HOST_IP}:${SENSOR_HTTP_PORT}
##########################################################################

###################### RTSP-SERVER service ################################
VST_RTSPSERVER_IMAGE=nvcr.io/rxczgrvsg8nx/vst-dev/vst-rtspserver:2.1.0-26.05.2

RTSP_SERVER_HTTP_PORT_1=30001
RTSP_SERVER_HTTP_PORT_2=30002
RTSP_SERVER_HTTP_PORT_3=30003
RTSP_SERVER_HTTP_PORT_4=30004
RTSP_SERVER_HTTP_PORT_5=30005

RTSP_SERVER_PORT_1=30554 ### change me if you want to stream more than 100 streams per pod
RTSP_SERVER_PORT_2=30564 ### change me if you want to stream more than 100 streams per pod
RTSP_SERVER_PORT_3=30574 ### change me if you want to stream more than 100 streams per pod
RTSP_SERVER_PORT_4=30584 ### change me if you want to stream more than 100 streams per pod
RTSP_SERVER_PORT_5=30594 ### change me if you want to stream more than 100 streams per pod

RTSP_SERVER_MODULE_ENDPOINT=http://localhost:10000
##########################################################################

###################### RECORDER service ###################################
VST_RECORDER_IMAGE=nvcr.io/rxczgrvsg8nx/vst-dev/vst-recorder:2.1.0-26.05.2

RECORDER_HTTP_PORT_1=30006
RECORDER_HTTP_PORT_2=30007
RECORDER_HTTP_PORT_3=30008
RECORDER_HTTP_PORT_4=30009
RECORDER_HTTP_PORT_5=30010
RECORDER_MODULE_ENDPOINT=http://localhost:10001
##########################################################################

###################### STORAGE service ####################################
VST_STORAGE_IMAGE=nvcr.io/rxczgrvsg8nx/vst-dev/vst-storage:2.1.0-26.05.2

STORAGE_HTTP_PORT=30011
STORAGE_MODULE_ENDPOINT=http://${HOST_IP}:${STORAGE_HTTP_PORT}

CLIP_STORAGE_PATH=${VST_VOLUME}/clip_storage
##########################################################################

###################### REPLAYSTREAM service ##############################
VST_REPLAYSTREAM_IMAGE=nvcr.io/rxczgrvsg8nx/vst-dev/vst-replaystream:2.1.0-26.05.2

REPLAYSTREAM_HTTP_PORT_1=30012
REPLAYSTREAM_HTTP_PORT_2=30013

REPLAYSTREAM_MODULE_ENDPOINT=http://localhost:10002
##########################################################################

###################### LIVESTREAM Module #################################
VST_LIVESTREAM_IMAGE=nvcr.io/rxczgrvsg8nx/vst-dev/vst-livestream:2.1.0-26.05.2

LIVESTREAM_HTTP_PORT_1=30017
LIVESTREAM_HTTP_PORT_2=30018

LIVESTREAM_MODULE_ENDPOINT=http://localhost:10003
##########################################################################

###################### MCP service ########################################
VST_MCP_IMAGE=nvcr.io/rxczgrvsg8nx/vst-dev/vst-mcp:2.1.0-26.05.2
##########################################################################

###################### Redis Configuration ###############################
REDIS_HOSTADDR=${HOST_IP}
REDIS_PORT=6379
REDIS_MSG_KEY=vst_events
##########################################################################

###################### Kafka Configuration ###############################
KAFKA_BOOTSTRAP_URL=${HOST_IP}:9092
KAFKA_MSG_KEY=sensor.id
##########################################################################

###################### Module Base IDs ###################################
RTSPSERVER_BASE_ID=1
RECORDER_BASE_ID=2
REPLAYSTREAM_BASE_ID=3
LIVESTREAM_BASE_ID=4
##########################################################################

###################### MinIO Configuration ###############################
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BIND_IP=${HOST_IP}
MINIO_DATA_PATH=${VST_VOLUME}/minio/data
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=nvidia123!
MINIO_API_DELETE_CLEANUP_INTERVAL=20s
MINIO_API_STALE_UPLOADS_CLEANUP_INTERVAL=300s
MINIO_API_STALE_UPLOADS_EXPIRY=168h
##########################################################################

###################### Additional Packages Configuration #################
# Additional packages are needed for certain use cases (e.g., audio, software encoding-decoding, video downloading).
# To install these packages, set VST_INSTALL_ADDITIONAL_PACKAGES=true.
VST_INSTALL_ADDITIONAL_PACKAGES=true
##########################################################################

###################### Prometheus Metrics Ports ##########################
# Prometheus metrics ports for microservices
SENSOR_PROMETHEUS_PORT=8080
STORAGE_PROMETHEUS_PORT=8081
RECORDER_PROMETHEUS_PORT_1=8082
RECORDER_PROMETHEUS_PORT_2=8083
RECORDER_PROMETHEUS_PORT_3=8084
RECORDER_PROMETHEUS_PORT_4=8085
RECORDER_PROMETHEUS_PORT_5=8086
RTSP_SERVER_PROMETHEUS_PORT_1=8087
RTSP_SERVER_PROMETHEUS_PORT_2=8088
RTSP_SERVER_PROMETHEUS_PORT_3=8089
RTSP_SERVER_PROMETHEUS_PORT_4=8090
RTSP_SERVER_PROMETHEUS_PORT_5=8091
LIVESTREAM_PROMETHEUS_PORT_1=8092
LIVESTREAM_PROMETHEUS_PORT_2=8093
REPLAYSTREAM_PROMETHEUS_PORT_1=8094
REPLAYSTREAM_PROMETHEUS_PORT_2=8095
##########################################################################

###################### MCP server configs ###########################
MCP_GATEWAY_CPP_API_BASE_URL=http://${HOST_IP}:30888/vst
MCP_GATEWAY_CPP_API_TIMEOUT=30

MCP_GATEWAY_SERVER_NAME=vst-mcp-server
MCP_GATEWAY_SERVER_VERSION=1.0.0
MCP_GATEWAY_SERVER_HOST=${HOST_IP}
MCP_GATEWAY_SERVER_PORT=8001

MCP_GATEWAY_LOG_LEVEL=INFO
MCP_GATEWAY_ENABLE_JSONRPC_LOGGING=true
##########################################################################
