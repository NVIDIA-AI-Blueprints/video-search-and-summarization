HOST_IP=<Host IP> ### change me

# You can config the VST configs from below (Must be absolute path)
VST_CONFIG_PATH=/home/ubuntu/docker-compose-vss/configs ### change me

# You can config the VST volume from below (Must be absolute path)
VST_VOLUME=/home/ubuntu/docker-compose-vss/vst_volume ### change me

###################### Base Infrastructure Images ########################
NGINX_IMAGE=nvcr.io/rxczgrvsg8nx/vst-dev/vst-ingress:2.1.0-26.05.2
##########################################################################

###################### VST Paths and Data Configuration ##################
VST_DATA_PATH=${VST_VOLUME}/vst_data
VST_VIDEO_STORAGE_PATH=${VST_VOLUME}/vst_video
VST_LOGS=${VST_DATA_PATH}/logs
##########################################################################

###################### Database Configuration ############################
##########################################################################


###################### STORAGE service ####################################
VST_STORAGE_IMAGE=nvcr.io/rxczgrvsg8nx/vst-dev/vst-storage:2.1.0-26.05.2

STORAGE_HTTP_PORT=30011
STORAGE_MODULE_ENDPOINT=http://${HOST_IP}:${STORAGE_HTTP_PORT}

CLIP_STORAGE_PATH=${VST_VOLUME}/clips ### change me for VSS
##########################################################################

###################### REPLAYSTREAM service ##############################
VST_REPLAYSTREAM_IMAGE=nvcr.io/rxczgrvsg8nx/vst-dev/vst-replaystream:2.1.0-26.05.2

REPLAYSTREAM_HTTP_PORT_1=30012

REPLAYSTREAM_MODULE_ENDPOINT=http://localhost:${REPLAYSTREAM_HTTP_PORT_1}
##########################################################################

###################### Redis Configuration ###############################

##########################################################################

###################### Kafka Configuration ###############################
KAFKA_BOOTSTRAP_URL=${HOST_IP}:9092
KAFKA_MSG_KEY=sensor.id
##########################################################################

###################### Additional Packages Configuration #################
# Additional packages are needed for certain use cases (e.g., audio, software encoding-decoding, video downloading).
# To install these packages, set VST_INSTALL_ADDITIONAL_PACKAGES=true.
VST_INSTALL_ADDITIONAL_PACKAGES=true
##########################################################################