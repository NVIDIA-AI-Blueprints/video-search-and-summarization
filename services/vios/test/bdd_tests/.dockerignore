# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
venv/
env/
.venv/
ENV/

# A developer's locally generated lock file must never leak into the build --
# dependencies are resolved inside the image (see Dockerfile).
poetry.lock

# Test artifacts
reports/
test-results/
*.mp4
*.avi
*.jpg
*.jpeg
*.png
*.log
/tmp/vst_*/
clip_*.mp4
test_upload_*.mp4

# Keep the baked sample clips: the *.mp4 rule above is root-level only, but be
# explicit so the BDD image always contains test_videos/ regardless of future
# changes to the rules above.
!test_videos/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Git
.git/
.gitignore

# Docker
.dockerignore

# Documentation (exclude most, keep README)
*.md
!README.md

# Include feature files (needed for pytest-bdd)
!features/
!**/*.feature

# CI/CD
.github/
.gitlab-ci.yml

# Unwanted plugins
pytest_html_report.html
output.json
archive/
