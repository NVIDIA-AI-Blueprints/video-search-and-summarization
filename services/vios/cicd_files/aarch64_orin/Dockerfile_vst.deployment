# Orin runtime base: same generic CUDA 13.0 / Ubuntu 24.04 image as the sbsa/thor
# build (cicd_files/aarch64/Dockerfile.base). Provides libcudart.so.13 for the
# DS 9.1 / CUDA 13.2 prebuilts + OSD libs (soname .13, CUDA 13.x compatible) and a
# noble ABI matching the R39 cross-compile. Tegra multimedia libs (nvbufsurface,
# nvv4l2, libcuda, NVENC/NVDEC) are provided on-device by nvidia-container-runtime
# (CSV mounts) at runtime.
FROM nvcr.io/nvidia/cuda:13.2.0-runtime-ubuntu24.04

# Needed so nvidia-container-runtime exposes the video (encode/decode) driver libs.
ENV NVIDIA_DRIVER_CAPABILITIES=$NVIDIA_DRIVER_CAPABILITIES,video

RUN apt-get update && apt-get upgrade -y

RUN DEBIAN_FRONTEND=noninteractive  apt-get install -y --no-install-recommends \
	libcurl4 \
	libxml2 \
	libssl-dev \
	libjsoncpp-dev \
	sqlite3 \
	uuid \
	gstreamer1.0-plugins-base \
	gstreamer1.0-plugins-good \
	gstreamer1.0-plugins-ugly \
	gstreamer1.0-plugins-bad \
	libgstreamer1.0-0 \
	gstreamer1.0-libav \
	libgstreamer-plugins-base1.0 \
	libboost-filesystem-dev \
	libboost-regex-dev \
	libboost-thread-dev \
	iptables \
	librdkafka-dev \
	v4l-utils \
	libpq-dev \
	libpqxx-dev \
	libhiredis1.1.0 \
	libopencv-dev \
	libpaho-mqtt-dev \
	libpaho-mqttpp-dev \
	kmod

ARG PKG_LOCATION

# Install the package at /home/vst/vst_release — the VSS-standard path the DC compose
# entrypoint expects (`/home/vst/vst_release/launch_vst`, tools/user_additional_install.sh).
ADD ${PKG_LOCATION}/vst_release.tbz2 /home/vst

# Ensure all users can read and execute files in the release tree
RUN chmod -R 755 /home/vst/vst_release

# NOTE: the old jammy base needed the stale prebuilt libgstapp-1.0.so.0.1603 swapped
# in at soname .0.2001.0. The noble/CUDA-13.2 base ships GStreamer 1.24
# (libgstapp-1.0.so.0.2402.0), which is exactly what this build links against and what
# DeepStream 9.1 expects — so no swap is needed; use the base's GStreamer.

WORKDIR /home/vst/vst_release
ENV LD_PRELOAD /usr/lib/aarch64-linux-gnu/libgomp.so.1:/lib/aarch64-linux-gnu/libGLdispatch.so.0
ENV LD_LIBRARY_PATH /home/vst/vst_release/prebuilts/aarch64/gst-plugins/:/home/vst/vst_release/prebuilts/aarch64/
ENV GST_PLUGIN_PATH /home/vst/vst_release/prebuilts/aarch64/gst-plugins/

ENTRYPOINT  ["/home/vst/vst_release/launch_vst"]
