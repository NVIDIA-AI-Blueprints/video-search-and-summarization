FROM nvcr.io/nvidia/cuda:13.2.0-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && \
	DEBIAN_FRONTEND=noninteractive  apt-get install -y --no-install-recommends \
	g++ \
	lbzip2 \
	libcurl4-openssl-dev \
	libcurl3-gnutls \
	libgtest-dev  \
	libjsoncpp-dev \
	libssl-dev  \
	libxml2-dev libxml2 \
	sqlite3 libsqlite3-dev \
	uuid uuid-dev \
	iputils-ping \
	gstreamer1.0-plugins-base \
	gstreamer1.0-plugins-good \
	gstreamer1.0-plugins-ugly \
	gstreamer1.0-plugins-bad \
	libgstreamer1.0-0 \
	libgstreamer-plugins-base1.0-dev \
	libboost-all-dev \
	make \
	build-essential autoconf libtool \
	git \
	pkg-config \
	wget \
	librdkafka-dev \
	libopencv-dev \
	python3 \
	python3-pip \
	ca-certificates \
	gnupg \
	lsb-release \
	ntp \
	ntpstat \
	libhiredis1.1.0 \
	libldap2-dev \
	libpq-dev \
	libpqxx-dev \
	libpaho-mqttpp-dev \
	libpaho-mqtt-dev \
	&& apt-get clean

# Node.js for the vios-ui build (build.sh -> build_vios_ui).
# Ubuntu 24.04 only ships nodejs 18.19.1, which is EOL and below the
# "^20.19.0 || >=22.12.0" required by vite 8, so the apt `npm` package cannot
# be used here. Install Node from NodeSource with an explicit keyring rather
# than piping their setup script into a shell.
ARG NODE_MAJOR=22
RUN install -d -m 0755 /usr/share/keyrings && \
	wget -qO- https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
		| gpg --dearmor -o /usr/share/keyrings/nodesource.gpg && \
	echo "deb [signed-by=/usr/share/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" \
		> /etc/apt/sources.list.d/nodesource.list && \
	apt-get update && \
	apt-get install -y --no-install-recommends nodejs && \
	apt-get clean && \
	node -v && npm -v

RUN pip3 install --break-system-packages requests

# install cmake 3.19.6 required by grpc
ENV MY_INSTALL_DIR=/usr/local
RUN wget -q -O cmake-linux.sh https://github.com/Kitware/CMake/releases/download/v3.19.6/cmake-3.19.6-Linux-x86_64.sh
RUN sh cmake-linux.sh -- --skip-license --prefix=$MY_INSTALL_DIR

# clone and install grpc
RUN git clone --recurse-submodules -b v1.50.0 --depth 1 --shallow-submodules https://github.com/grpc/grpc /var/local/git/grpc
RUN cd /var/local/git/grpc && \
    mkdir -p cmake/build && \
	cd cmake/build && \
	cmake -DgRPC_INSTALL=ON -DgRPC_BUILD_TESTS=OFF -DCMAKE_CXX_STANDARD=20 -DCMAKE_CXX_STANDARD_REQUIRED=ON -DCMAKE_INSTALL_PREFIX=$MY_INSTALL_DIR ../.. && \
    make -j12 && \
    make install

RUN echo /usr/local/lib > /etc/ld.so.conf.d/usr-local-lib.conf && \
    echo /usr/local/lib/x86_64-linux-gnu >> /etc/ld.so.conf.d/usr-local-lib.conf && \
    ldconfig