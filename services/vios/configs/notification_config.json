{
	"message_broker":
	{
		"enable_notification": true,
		"enable_notification_consumer": false,
		"use_message_broker" : "redis",
		"use_message_broker_consumer" : "kafka",
		"message_broker_topic": "vst_events",
		"message_broker_topic_consumer": "",
		"message_broker_payload_key": "sensor.id",
		"message_broker_metadata_topic": "test",
		"redis_server_env_var": "localhost:6379",
		"kafka_server_address": "",
		"mqtt_broker_address": "tcp://172.17.0.1:1883"
	},
	"webhooks":
	{
		"enabled": false,
		"items":
		[
			{
				"enabled": false,
				"id": "dummy-camera-add",
				"camera_status_change": "camera_add",
				"request": [
					{
						"url": "http://127.0.0.1:18088/bdd/webhooks/camera/add",
						"method": "POST",
						"headers": {"Content-Type": "application/json", "x-stream-id": "{{event.camera_id}}"},
						"query_params": {"change": "{{event.change}}"},
						"camera_type": ["rtsp", "file"],
						"timeout_ms": 5000,
						"retry": {"max_attempts": 3, "backoff_ms": [1000, 5000, 15000], "retry_on_status": [408, 429, 500, 502, 503, 504]},
						"user_defined_metadata": {"model": "some_model_name", "chunk": 123}
					}
				],
				"auth": {"type": "hmac-sha256", "secret": "{{secrets.signing_key}}", "header_name": "X-VIOS-Signature"}
			},
			{
				"enabled": false,
				"id": "dummy-camera-streaming",
				"camera_status_change": "camera_streaming",
				"request": [
					{
						"url": "http://127.0.0.1:18088/bdd/webhooks/camera/streaming",
						"method": "PUT",
						"headers": {"Content-Type": "application/json", "x-stream-id": "{{event.camera_id}}"},
						"query_params": {"change": "{{event.change}}"},
						"camera_type": ["rtsp", "file"],
						"timeout_ms": 5000,
						"retry": {"max_attempts": 3, "backoff_ms": [1000, 5000, 15000], "retry_on_status": [408, 429, 500, 502, 503, 504]}
					}
				],
				"auth": {"type": "hmac-sha256", "secret": "{{secrets.signing_key}}", "header_name": "X-VIOS-Signature"}
			},
			{
				"enabled": false,
				"id": "dummy-camera-remove",
				"camera_status_change": "camera_remove",
				"request": [
					{
						"url": "http://127.0.0.1:18088/bdd/webhooks/camera/remove",
						"method": "DELETE",
						"headers": {"Content-Type": "application/json", "x-stream-id": "{{event.camera_id}}"},
						"query_params": {"change": "{{event.change}}"},
						"camera_type": ["rtsp", "file"],
						"timeout_ms": 5000,
						"retry": {"max_attempts": 3, "backoff_ms": [1000, 5000, 15000], "retry_on_status": [408, 429, 500, 502, 503, 504]}
					}
				]
			}
		]
	}
}
