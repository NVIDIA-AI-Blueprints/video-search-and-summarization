# Compiled objects and dependency files
*.o
*.d

# Build output (release tarballs; may be root-owned from container builds)
out/

# Per-arch build stamp written by build.sh (drives arch-less `clean`)
prebuilts/*/.vios-built

# CSV files
*.csv

# UI test artifacts
.playwright-mcp/
*.png

# Sonar database
sonar-databases/

# Sanity / deployment runtime artifacts (generated by running the stack; never commit)
out/
test/bdd_tests/reports/
deployment/stream-processing/docker-compose/vst_volume/
deployment/stream-processing/docker-compose/vst_data/
deployment/stream-processing/docker-compose/nvstreamer/videos/
deployment/stream-processing/docker-compose/nvstreamer/vst_data/
deployment/stream-processing/docker-compose/sdrc/log/
deployment/stream-processing/docker-compose/sdrc/configs/config.yml
deployment/stream-processing/docker-compose/sdrc/configs/docker_cluster_config-streamprocessing.json
# config snapshots the sanity takes/restores
*.sanity-bak
*.overlaytest.bak

# generated sanity run output (reports/JSON/PDF/logs/evidence)
sanity/results/
