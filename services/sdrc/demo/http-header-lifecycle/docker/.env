#
# Auto-loaded by `docker compose` from this directory. Plain
# `docker compose up -d` starts SDRC, RTVI-CV, and the VIOS/VST stack
# (postgres, sensor, streamprocessing, vst-ingress) plus nvstreamer.
#
# Required override (warehouse app data root with models/mtmc + videos):
#   export VSS_DATA_DIR=/path/to/vss-warehouse-app-data
# Or set VSS_DATA_DIR below.

VSS_APPS_DIR=../../../../../deploy/docker
COMPOSE_PROFILES=centralizedb,vst-ingress,sensor-ms,streamprocessing-ms
HOST_IP=127.0.0.1
HARDWARE_PROFILE=dGPU
SAMPLE_VIDEO_DATASET=demo
# VSS_DATA_DIR=/path/to/vss-warehouse-app-data
