%% HTTP header based stream lifecycle and routing workflow for SDRC/WDM.
%% Render with Mermaid-compatible tools such as markdown preview, Mermaid Live, or mmdc.

flowchart TD
    classDef client fill:#E8F0FE,stroke:#2F5FBD,stroke-width:2px,color:#172033
    classDef proxy fill:#EAF7EF,stroke:#2F855A,stroke-width:2px,color:#172033
    classDef wdm fill:#FFF3D6,stroke:#B7791F,stroke-width:2px,color:#172033
    classDef state fill:#E6FFFA,stroke:#2C7A7B,stroke-width:2px,color:#172033
    classDef worker fill:#FCE7F3,stroke:#B83280,stroke-width:2px,color:#172033
    classDef decision fill:#FFF7ED,stroke:#C05621,stroke-width:2px,color:#172033
    classDef error fill:#FEE2E2,stroke:#C53030,stroke-width:2px,color:#172033

    subgraph L["1. Lifecycle HTTP request path"]
        direction LR
        C1["Client lifecycle call<br/>POST /sdrc/{wl_obj}/...<br/>Headers: stream-id + lifecycle action<br/>Body: opaque payload"]:::client
        P1["SDRC / Envoy public ingress<br/>Resolve workload object<br/>Do not inspect payload"]:::proxy
        P2{"Lifecycle request?"}:::decision
        P3["Normal proxy path<br/>For non-lifecycle calls"]:::proxy
        W1["WDM /stream_event<br/>Build provision intent<br/>Preserve raw body and content-type"]:::wdm
        W2{"Action header or URL regex"}:::decision

        C1 -->|"HTTP"| P1
        P1 --> P2
        P2 -->|"No"| P3
        P2 -->|"Yes"| W1
        W1 --> W2
    end

    subgraph A["2A. Add or update stream"]
        direction LR
        A1["Validate add/update headers<br/>stream-id required<br/>action required<br/>extra metadata headers optional/configured"]:::wdm
        A2["Select or reuse healthy worker<br/>Use existing WDM placement logic"]:::wdm
        A3["Forward to workload add/update URL<br/>Original payload remains unchanged"]:::worker
        A4["Persist lifecycle state<br/>Redis: stream-id -> worker<br/>Redis: stream-id -> cached config/payload<br/>Kafka: optional audit/replay event"]:::state
        A5["Return workload response<br/>Success creates usable route mapping"]:::wdm

        A1 --> A2 --> A3 --> A4 --> A5
    end

    subgraph D["2B. Delete stream"]
        direction LR
        D1["Validate delete headers<br/>stream-id required<br/>action required<br/>payload not required by SDRC"]:::wdm
        D2["Lookup current owner<br/>Redis stream-id -> worker"]:::state
        D3["Forward to workload delete URL<br/>Target owning worker"]:::worker
        D4["Remove or tombstone lifecycle state<br/>Delete route mapping/cache<br/>Kafka: optional audit/replay event"]:::state
        D5["Return workload response<br/>Future route lookup should miss"]:::wdm

        D1 --> D2 --> D3 --> D4 --> D5
    end

    subgraph R["3. Subsequent header-based routing path"]
        direction LR
        R1["Client data/control call<br/>HTTP, gRPC, or WebSocket<br/>Includes configured stream-id header"]:::client
        R2["Envoy header router<br/>Extract workload object + stream-id<br/>No payload inspection"]:::proxy
        R3["Fast route lookup<br/>Redis HGET workload-map stream-id"]:::state
        R4{"Mapping found?"}:::decision
        R5["Set upstream cluster<br/>Forward to owning worker"]:::proxy
        R6["Worker handles request<br/>Request body stays opaque"]:::worker
        R7["Controlled failure<br/>Return 404/503<br/>Emit log/metric with stream-id and workload object"]:::error

        R1 --> R2 --> R3 --> R4
        R4 -->|"Yes"| R5 --> R6
        R4 -->|"No"| R7
    end

    subgraph H["4. Recovery and reconciliation path"]
        direction LR
        H1["Worker or pod health event<br/>Owner may be unavailable"]:::worker
        H2["WDM reconciler<br/>Find affected stream IDs"]:::wdm
        H3["Read cached stream config/payload<br/>Redis authoritative cache<br/>Kafka optional replay source"]:::state
        H4["Select replacement worker<br/>Replay add/update payload<br/>Rewrite stream-id mapping"]:::wdm
        H5["Subsequent calls route to replacement owner"]:::proxy

        H1 --> H2 --> H3 --> H4 --> H5
    end

    W2 -->|"add / update"| A1
    W2 -->|"delete"| D1
    A5 -. "route mapping now available" .-> R1
    D5 -. "route mapping removed" .-> R1
    R6 -. "worker health monitored" .-> H1
    H5 -. "updated mapping used by router" .-> R2
