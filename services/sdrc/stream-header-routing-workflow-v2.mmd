%% HTTP header based stream lifecycle and routing workflow for SDRC/WDM.
%% Version 2 incorporates manager feedback:
%% - lifecycle is detected from URI signatures configured per workload in config.yml
%% - request payload is captured and stored in Redis like message-bus lifecycle payloads
%% - update lifecycle is removed; reprovision uses existing WDM reprovision logic
%% - pod crash path reflects current delete-entry + fresh provision/reprovision behavior

flowchart TD
    classDef client fill:#E8F0FE,stroke:#2F5FBD,stroke-width:2px,color:#172033
    classDef proxy fill:#EAF7EF,stroke:#2F855A,stroke-width:2px,color:#172033
    classDef wdm fill:#FFF3D6,stroke:#B7791F,stroke-width:2px,color:#172033
    classDef state fill:#E6FFFA,stroke:#2C7A7B,stroke-width:2px,color:#172033
    classDef worker fill:#FCE7F3,stroke:#B83280,stroke-width:2px,color:#172033
    classDef decision fill:#FFF7ED,stroke:#C05621,stroke-width:2px,color:#172033
    classDef error fill:#FEE2E2,stroke:#C53030,stroke-width:2px,color:#172033

    C0["Client sends HTTP request<br/>to SDRC / Envoy"]:::client
    C1["Request includes configured stream-id header<br/>Example: x-stream-id or id"]:::client
    P0["SDRC / Envoy receives request<br/>Extract workload object and request URI"]:::proxy
    CFG["Load workload config.yml settings<br/>stream-id header<br/>add URI signature<br/>delete URI signature<br/>reprovision URI signature"]:::state
    L0{"Does request URI match<br/>a lifecycle signature?"}:::decision

    C0 --> C1 --> P0
    P0 --> CFG --> L0

    L0 -->|"No: normal data/control request"| R0
    L0 -->|"Yes: lifecycle request"| I0

    subgraph LIFE["Lifecycle request handling"]
        direction TD
        I0["Intercept lifecycle request<br/>Do not route as normal data-plane traffic"]:::proxy
        I1["Capture original HTTP request<br/>method, URI, headers, content-type, raw payload/body"]:::wdm
        I2["Build WDM lifecycle envelope<br/>workload object<br/>stream id from header<br/>matched action from URI signature<br/>captured payload"]:::wdm
        I3["Persist captured request record in Redis<br/>same purpose as message-bus workload spec/cache<br/>add/reprovision refresh active payload<br/>delete later removes active stream cache"]:::state
        A0{"Matched lifecycle action"}:::decision

        I0 --> I1 --> I2 --> I3 --> A0

        A0 -->|"Add URI"| A1
        A0 -->|"Delete URI"| D1
        A0 -->|"Reprovision URI"| RP1
    end

    subgraph ADD["Add stream lifecycle"]
        direction TD
        A1["Validate add request<br/>stream-id header required<br/>required metadata/config headers as defined by workload"]:::wdm
        A2["Invoke existing stream provisioning logic<br/>provisionStreamRedis equivalent path"]:::wdm
        A3["Select existing worker or scale workload<br/>respect threshold and replica readiness"]:::wdm
        A4["Forward captured payload/config<br/>to workload add URI"]:::worker
        A5["On success update Redis route mapping<br/>HSET wl_obj_name stream-id podName<br/>HSET wl_obj_name-pod podName podDns"]:::state
        A6["Persist/refresh workload spec cache<br/>captured payload available for later reprovision"]:::state

        A1 --> A2 --> A3 --> A4 --> A5 --> A6
    end

    subgraph DEL["Delete stream lifecycle"]
        direction TD
        D1["Validate delete request<br/>stream-id header required"]:::wdm
        D2["Lookup current owner in Redis<br/>HGET wl_obj_name stream-id"]:::state
        D3["Invoke existing stream de-provisioning logic<br/>deprovisionStreamRedis equivalent path"]:::wdm
        D4["Forward delete to owning workload pod<br/>using configured workload delete URI"]:::worker
        D5["On success remove Redis state<br/>HDEL wl_obj_name stream-id<br/>delete workload spec/cache entry"]:::state

        D1 --> D2 --> D3 --> D4 --> D5
    end

    subgraph REPROV["Reprovision lifecycle"]
        direction TD
        RP1["Validate reprovision request<br/>stream-id header required<br/>stream must exist in current cache"]:::wdm
        RP2["Use current reprovision logic<br/>no new update lifecycle"]:::wdm
        RP3["Deprovision current stream<br/>remove old route/cache entry"]:::wdm
        RP4["Fetch latest stream info / reuse cached payload<br/>current WDM behavior remains source of truth"]:::state
        RP5["Run fresh provision call<br/>new worker selection and route mapping update"]:::wdm

        RP1 --> RP2 --> RP3 --> RP4 --> RP5
    end

    subgraph ROUTE["Normal data-plane routing"]
        direction TD
        R0["Envoy Lua reads configured stream-id header<br/>and sets X-WL-OBJECT-NAME"]:::proxy
        R1["Redis route lookup<br/>HGET wl_obj_name stream-id"]:::state
        R2{"Mapping found?"}:::decision
        R3["Set upstream-cluster header<br/>podName / podName-grpc / podName-websocket"]:::proxy
        R4["Route request to corresponding worker pod"]:::worker
        R5["Configured fallback or 503<br/>when stream mapping is missing"]:::error

        R0 --> R1 --> R2
        R2 -->|"Yes"| R3 --> R4
        R2 -->|"No"| R5
    end

    subgraph CRASH["Current pod crash / recovery behavior"]
        direction TD
        H1["Pod crash or workload pod down detected"]:::worker
        H2["WDM marks pod/worker down<br/>publishes down/reprovision event when enabled"]:::wdm
        H3["Delete affected Redis/workload-spec entry<br/>current behavior clears stale ownership"]:::state
        H4["Run new provision/reprovision call<br/>stream is placed on an available worker"]:::wdm
        H5["Redis route mapping is recreated<br/>subsequent stream-id routing uses new owner"]:::state

        H1 --> H2 --> H3 --> H4 --> H5
    end

    A6 -. "stream is now routable" .-> R0
    D5 -. "stream mapping removed" .-> R0
    RP5 -. "stream route refreshed" .-> R0
    R4 -. "worker health monitored" .-> H1
    H5 -. "new mapping used by data-plane" .-> R0
