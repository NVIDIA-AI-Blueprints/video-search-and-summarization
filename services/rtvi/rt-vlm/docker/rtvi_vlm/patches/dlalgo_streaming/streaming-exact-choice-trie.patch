+@dataclass
+class TokenTrieChoiceGrammar(StructuredOutputGrammar):
+    """Exact tokenizer-level enforcement for finite choice constraints."""
+
+    sequences: tuple[tuple[int, ...], ...]
+    prefix: list[int] = field(default_factory=list, repr=False)
+    num_processed_tokens: int = field(default=0, repr=False)
+
+    def _accepts_prefix(self, prefix: list[int]) -> bool:
+        candidate = tuple(prefix)
+        return any(sequence[: len(candidate)] == candidate for sequence in self.sequences)
+
+    def accept_tokens(self, request_id: str, tokens: list[int]) -> bool:
+        for token in tokens:
+            candidate = [*self.prefix, token]
+            if not self._accepts_prefix(candidate):
+                logger.error(
+                    "Failed to advance exact choice grammar for request %s "
+                    "at token %s.",
+                    request_id,
+                    token,
+                )
+                return False
+            self.prefix.append(token)
+            self.num_processed_tokens += 1
+        return True
+
+    def validate_tokens(self, tokens: list[int]) -> list[int]:
+        candidate = list(self.prefix)
+        accepted: list[int] = []
+        for token in tokens:
+            candidate.append(token)
+            if not self._accepts_prefix(candidate):
+                break
+            accepted.append(token)
+        return accepted
+
+    def rollback(self, num_tokens: int) -> None:
+        if num_tokens < 0 or num_tokens > len(self.prefix):
+            raise ValueError(f"Cannot roll back {num_tokens} exact-choice tokens")
+        if num_tokens:
+            del self.prefix[-num_tokens:]
+            self.num_processed_tokens -= num_tokens
+
+    def fill_bitmask(self, bitmask: torch.Tensor, batch_index: int) -> None:
+        row = bitmask[batch_index]
+        row.zero_()
+        prefix = tuple(self.prefix)
+        allowed = {
+            sequence[len(prefix)]
+            for sequence in self.sequences
+            if len(sequence) > len(prefix) and sequence[: len(prefix)] == prefix
+        }
+        for token_id in allowed:
+            word, bit = divmod(token_id, 32)
+            token_mask = 1 << bit
+            if token_mask >= 1 << 31:
+                token_mask -= 1 << 32
+            row[word] = int(row[word].item()) | token_mask
+
+    def is_terminated(self) -> bool:
+        return tuple(self.prefix) in self.sequences
+
+    def reset(self):
+        self.prefix.clear()
+        self.num_processed_tokens = 0
+
+
