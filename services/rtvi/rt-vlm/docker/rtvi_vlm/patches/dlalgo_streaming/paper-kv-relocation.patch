+
+    def __init__(self) -> None:
+        self._chunks: list[tuple[torch.Tensor, torch.Tensor]] = []
+        self._slot_lists: list[list[int] | None] = []
+
+    def write_tensor_rows(
+        self, slot_mapping: torch.Tensor, rows: torch.Tensor
+    ) -> None:
+        row_count = min(int(slot_mapping.shape[0]), int(rows.shape[0]))
+        if row_count <= 0:
+            return
+        self._chunks.append(
+            (
+                slot_mapping.detach()[:row_count].clone(),
+                rows.detach()[:row_count].clone(),
+            )
+        )
+        self._slot_lists.append(None)
+
+    def _slot_list(self, chunk_index: int) -> list[int]:
+        cached = self._slot_lists[chunk_index]
+        if cached is None:
+            cached = (
+                self._chunks[chunk_index][0]
+                .detach()
+                .to(device="cpu", dtype=torch.long)
+                .tolist()
+            )
+            self._slot_lists[chunk_index] = cached
+        return cached
+
+    def _latest_index(self) -> dict[int, tuple[int, int]]:
+        result: dict[int, tuple[int, int]] = {}
+        for chunk_index in range(len(self._chunks) - 1, -1, -1):
+            for row_index, slot in enumerate(self._slot_list(chunk_index)):
+                slot = int(slot)
+                if slot >= 0 and slot not in result:
+                    result[slot] = (chunk_index, row_index)
+        return result
+
+    def read_slot_indices(self, slots: torch.Tensor) -> torch.Tensor:
+        wanted = slots.detach().to(device="cpu", dtype=torch.long).tolist()
+        latest = self._latest_index()
+        grouped: dict[int, list[tuple[int, int]]] = {}
+        for output_index, slot in enumerate(wanted):
+            entry = latest.get(int(slot))
+            if entry is None:
+                raise RuntimeError(
+                    "Streaming VLM raw-key shadow is missing physical slot "
+                    f"{slot}"
+                )
+            grouped.setdefault(entry[0], []).append((entry[1], output_index))
+
+        output = None
+        for chunk_index, pairs in grouped.items():
+            rows = self._chunks[chunk_index][1]
+            if output is None:
+                output = rows.new_empty((len(wanted), *tuple(rows.shape[1:])))
+            source = torch.tensor(
+                [row for row, _ in pairs], dtype=torch.long, device=rows.device
+            )
+            destination = torch.tensor(
+                [row for _, row in pairs], dtype=torch.long, device=rows.device
+            )
+            output.index_copy_(0, destination, rows.index_select(0, source))
+        if output is None:
+            raise RuntimeError("Streaming VLM raw-key shadow read was empty")
+        return output
+
+    def compact(self, retain_slots: set[int] | None = None) -> None:
+        latest = self._latest_index()
+        if retain_slots is not None:
+            latest = {
+                slot: entry for slot, entry in latest.items() if slot in retain_slots
+            }
+        if not latest:
+            self._chunks.clear()
+            self._slot_lists.clear()
+            return
+        ordered = sorted(latest.items())
+        slots = self._chunks[0][0].new_tensor([slot for slot, _ in ordered])
+        grouped: dict[int, list[tuple[int, int]]] = {}
+        for output_index, (_slot, (chunk_index, row_index)) in enumerate(ordered):
+            grouped.setdefault(chunk_index, []).append((row_index, output_index))
+        output = None
+        for chunk_index, pairs in grouped.items():
+            rows = self._chunks[chunk_index][1]
+            if output is None:
+                output = rows.new_empty((len(ordered), *tuple(rows.shape[1:])))
+            source = torch.tensor(
+                [row for row, _ in pairs], dtype=torch.long, device=rows.device
+            )
+            destination = torch.tensor(
+                [row for _, row in pairs], dtype=torch.long, device=rows.device
+            )
+            output.index_copy_(0, destination, rows.index_select(0, source))
+        assert output is not None
+        self._chunks = [(slots, output)]
+        self._slot_lists = [[slot for slot, _ in ordered]]
+
+
+def unified_streaming_vlm_raw_key_cache_update(
+    raw_key: torch.Tensor,
+    layer_name: str,
+) -> torch.Tensor:
+    """Capture pre-mRoPE keys only for the paper-faithful streaming path."""
+    if os.environ.get("VLLM_STREAMING_VLM_RAW_KEY_SHADOW", "").lower() not in {
+        "1",
+        "true",
+        "yes",
+        "on",
+    }:
+        return raw_key.new_zeros(())
+    attn_metadata, attn_layer, _kv_cache, slot_mapping = get_attention_context(
+        layer_name
+    )
+    if slot_mapping is None:
+        return raw_key.new_zeros(())
+    row_count = min(int(slot_mapping.shape[0]), int(raw_key.shape[0]))
+    num_actual_tokens = getattr(attn_metadata, "num_actual_tokens", None)
+    if num_actual_tokens is not None:
+        row_count = min(row_count, max(0, int(num_actual_tokens)))
+    shadow = getattr(attn_layer, "_streaming_vlm_raw_key_shadow", None)
+    if shadow is None:
+        shadow = StreamingVLMRawKeyShadow()
+        attn_layer._streaming_vlm_raw_key_shadow = shadow
+    shadow.write_tensor_rows(slot_mapping[:row_count], raw_key[:row_count])
+    return raw_key.new_zeros(())
+
+
+def unified_streaming_vlm_raw_key_cache_update_fake(
+    raw_key: torch.Tensor,
+    layer_name: str,
+) -> torch.Tensor:
+    return raw_key.new_zeros(())
+
+
+direct_register_custom_op(
+    op_name="unified_streaming_vlm_raw_key_cache_update",
+    op_func=unified_streaming_vlm_raw_key_cache_update,
+    fake_impl=unified_streaming_vlm_raw_key_cache_update_fake,
+    mutates_args=[],
+    tags=(torch._C.Tag.cudagraph_unsafe,),
+)
+
