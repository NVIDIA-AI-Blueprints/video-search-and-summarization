+def test_wrapped_visual_context_ignores_folded_assistant_role_end():
+    """A relocated assistant can leave a second role end before next user."""
+    token_ids = [10, 11, 99, 20, 21, 22, 30, 31, 40, 41, 42, 30, 31]
+    request = SimpleNamespace(
+        _all_token_ids=token_ids,
+        mm_features=[
+            MultiModalFeatureSpec(
+                data=MultiModalKwargsItem.dummy(),
+                modality="video",
+                identifier="frame-0",
+                mm_position=PlaceholderRange(offset=4, length=2),
+            )
+        ],
+    )
+
+    indices = _wrapped_visual_context_indices(
+        request,
+        0,
+        len(token_ids),
+        user_role_start_token_ids=(10, 11),
+        vision_start_token_id=20,
+        role_end_token_ids=(30, 31),
+    )
+
+    assert indices == [0, 1, 3, 4, 5, 6, 7]
+
+
