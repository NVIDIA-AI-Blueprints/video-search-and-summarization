+def _decode_reply(renderer: "BaseRenderer", token_ids: list[int], streamed: str) -> str:
+    decoded = renderer.get_tokenizer().decode(
+        token_ids, skip_special_tokens=True
+    ).strip()
+    streamed = streamed.strip()
+    if decoded != streamed:
+        logger.warning(
+            "Streaming detokenizer mismatch; using authoritative token decode: "
+            "streamed=%r decoded=%r",
+            streamed,
+            decoded,
+        )
+    return decoded
