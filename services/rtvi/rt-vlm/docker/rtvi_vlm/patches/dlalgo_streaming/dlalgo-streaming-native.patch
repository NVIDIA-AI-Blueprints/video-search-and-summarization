--- /dev/null
+++ b/vllm/entrypoints/openai/streaming/chunking.py
@@ -0,0 +1,157 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Per-frame prompt construction for the streaming server (model-independent).
+
+A frame is rendered through the model's own chat template (via the engine's
+renderer), so the per-model vision tokens come from the template — no hardcoded
+markers. Each frame is one chat turn carrying an image: frame 1 opens the
+conversation (system + question + image); later frames are image-only (the task
+lives in the pinned system prompt). Per-chunk prompts are incremental — the
+engine appends each to the running request.
+"""
+
+from io import BytesIO
+from typing import TYPE_CHECKING, cast
+from uuid import uuid4
+
+import numpy as np
+from PIL import Image
+
+from vllm.engine.protocol import StreamingInput
+from vllm.renderers.params import ChatParams
+from vllm.sampling_params import SamplingParams
+
+if TYPE_CHECKING:
+    from vllm.entrypoints.chat_utils import ChatCompletionMessageParam
+    from vllm.renderers import BaseRenderer
+
+
+# Cap decoded frame size well below PIL's ~179 MP decompression-bomb error:
+# a crafted ~80 MP JPEG otherwise decodes to ~240 MB of RGB per frame.
+_MAX_FRAME_PIXELS = 4 * 1024 * 1024  # 4 MP; a 720p frame is ~0.9 MP
+
+
+def decode_frame(data: bytes) -> Image.Image:
+    """Decode encoded image bytes (PNG/JPEG/...) to a PIL RGB image."""
+    img = Image.open(BytesIO(data))  # lazy: parses the header only
+    w, h = img.size
+    if w * h > _MAX_FRAME_PIXELS:
+        raise ValueError(
+            f"frame is {w}x{h} ({w * h} pixels); the per-frame limit is "
+            f"{_MAX_FRAME_PIXELS} pixels"
+        )
+    return img.convert("RGB")
+
+
+def build_messages(
+    video_uuids: list[str],
+    system_prompt: str,
+    question: str,
+    is_first: bool,
+    previous_text: str,
+    start_time_s: float,
+    end_time_s: float,
+) -> list[dict]:
+    """OpenAI-style messages for one temporal-video batch's incremental turn.
+
+    UUID-only video placeholders let the renderer insert the model-specific
+    video tokens. ``build_frames_chunk`` replaces their empty payloads with
+    decoded in-memory tensors before vLLM preprocessing.
+    """
+    video_parts = [
+        {"type": "video_url", "video_url": None, "uuid": video_uuid}
+        for video_uuid in video_uuids
+    ]
+    step_context = {
+        "type": "text",
+        "text": f"Time={start_time_s:.1f}-{end_time_s:.1f}s",
+    }
+    if not is_first:
+        return [{"role": "user", "content": [step_context, *video_parts]}]
+    user_content: list[dict] = [step_context, *video_parts]
+    if question:
+        user_content.append({"type": "text", "text": question})
+    return [
+        {"role": "system", "content": system_prompt},
+        {"role": "previous text", "content": previous_text},
+        {"role": "user", "content": user_content},
+    ]
+
+
+def build_temporal_video_items(
+    frames: list[Image.Image],
+    fps: float,
+) -> list[tuple[np.ndarray, dict]]:
+    """Pack decoded frames into native two-frame temporal video items."""
+    if not frames:
+        raise ValueError("streaming frame batch cannot be empty")
+    if fps <= 0:
+        raise ValueError("streaming video fps must be positive")
+
+    items = []
+    for start in range(0, len(frames), 2):
+        pair = frames[start : start + 2]
+        video = np.stack(
+            [np.asarray(frame.convert("RGB"), dtype=np.uint8) for frame in pair]
+        )
+        duration = (len(pair) - 1) / fps
+        metadata = {
+            "total_num_frames": len(pair),
+            "frames_indices": list(range(len(pair))),
+            "fps": fps,
+            "duration": duration,
+        }
+        items.append((video, metadata))
+    return items
+
+
+async def build_frames_chunk(
+    renderer: "BaseRenderer",
+    frames: list[Image.Image],
+    is_first: bool,
+    question: str,
+    system_prompt: str,
+    sp: SamplingParams,
+    fps: float,
+    previous_text: str,
+    start_time_s: float,
+    end_time_s: float,
+    generate: bool = True,
+) -> StreamingInput:
+    """Render one decoded frame batch into native temporal video inputs.
+
+    The renderer contributes the model's video placeholder tokens; decoded
+    frames replace UUID-only placeholders in-memory without codec or HTTP work.
+    """
+    video_items = build_temporal_video_items(frames, fps)
+    video_uuids = [str(uuid4()) for _ in video_items]
+    messages = cast(
+        "list[ChatCompletionMessageParam]",
+        build_messages(
+            video_uuids,
+            system_prompt,
+            question,
+            is_first,
+            previous_text,
+            start_time_s,
+            end_time_s,
+        ),
+    )
+    params = ChatParams(
+        chat_template_content_format="auto",
+        chat_template_kwargs={"add_generation_prompt": True},
+    )
+    _, engine_prompts = await renderer.render_chat_async(
+        [messages],
+        params,
+        prompt_extras={
+            "multi_modal_data": {"video": video_items},
+            "multi_modal_uuids": {"video": video_uuids},
+        },
+    )
+    chunk_sp = sp
+    if not generate:
+        chunk_sp = sp.clone()
+        chunk_sp.extra_args = dict(sp.extra_args or {})
+        chunk_sp.extra_args["streaming_prefill_only"] = True
+    return StreamingInput(prompt=engine_prompts[0], sampling_params=chunk_sp)
