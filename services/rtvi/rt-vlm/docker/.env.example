# Copy this file to .env before running docker compose up.

# Moving developer image from GitHub Container Registry. Use the NVCR line for
# a pinned 3.3.0 release deployment instead.
RTVI_IMAGE=ghcr.io/nvidia-ai-blueprints/vss/vss-rt-vlm:develop-latest
# RTVI_IMAGE=nvcr.io/nvstaging/vss-core/vss-rt-vlm:3.3.0-26.08.2
BACKEND_PORT=8000

# Default local model
VLM_MODEL_TO_USE=cosmos-reason3
MODEL_PATH=ngc:nim/nvidia/cosmos3-nano-reasoner:bf16-final
NGC_API_KEY=<replace-with-your-ngc-api-key>
NVIDIA_VISIBLE_DEVICES=0

# Local Compose message bus
MESSAGE_BUS=kafka
MESSAGE_BUS_TOPIC=mdx-vlm-captions
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_INCIDENT_TOPIC=mdx-vlm-incidents
ERROR_BUS=kafka
ERROR_MESSAGE_TOPIC=vision-llm-errors

# Optional sizing: choose values for the selected model and GPU.
# VLLM_GPU_MEMORY_UTILIZATION=0.7
# VLM_MAX_MODEL_LEN=32768
