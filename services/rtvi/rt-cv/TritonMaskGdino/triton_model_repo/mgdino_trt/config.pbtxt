name: "mgdino_trt"
platform: "tensorrt_plan"
max_batch_size: 32
input [
{
    name: "inputs"
    data_type: TYPE_FP32
    dims: [3, 544, 960 ]

},
{
    name: "input_ids"
    data_type: TYPE_INT64
    dims: [256]

},
{
    name: "attention_mask"
    data_type: TYPE_BOOL
    dims: [256]
},
{
    name: "position_ids"
    data_type: TYPE_INT64
    dims: [256]
},
{
    name: "token_type_ids"
    data_type: TYPE_INT64
    dims: [256]
},
{
    name: "text_token_mask"
    data_type: TYPE_BOOL
    dims: [256,256]
}
]
output[
{
    name: "pred_logits"
    data_type: TYPE_FP32
    dims: [ 900,256]
},
{
    name: "pred_boxes"
    data_type: TYPE_FP32
    dims: [ 900,4]
},
{
    name: "pred_masks"
    data_type: TYPE_FP32
    dims: [ 900, 1, 136, 240]
}
]
instance_group [
    {
      count: 1
      kind: KIND_GPU
      gpus: [ 0 ]
    }
]


parameters: { key: "FORCE_CPU_ONLY_INPUT_TENSORS" value: {string_value:"no"}}

