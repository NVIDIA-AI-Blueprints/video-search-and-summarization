name: "ensemble_python_mgdino"
platform: "ensemble"
max_batch_size: 32
input [
  {
    name: "inputs"
    data_type: TYPE_FP32
    dims: [3,544,960]
  },
  {
    name: "PROMPT"
    data_type: TYPE_UINT8
    dims: [2048]
  }
]
output [
{
    name: "labels"
    data_type: TYPE_INT32
    dims: [-1,300]
},
{
    name: "boxes"
    data_type: TYPE_FP32
    dims: [-1,300, 4]
}
,
{
    name: "scores"
    data_type: TYPE_FP32
    dims: [-1,300]
},
{
    name: "masks"
    data_type: TYPE_FP32
    dims: [ -1,300, 1, 136, 240]
}
]
ensemble_scheduling {
  step [
    {
      model_name: "mgdino_preprocess"
      model_version: -1
      input_map [
      {
        key: "PROMPT"
        value: "PROMPT"
      }
      ]
      output_map [
      {
        key: "input_ids"
        value: "input_ids"
      },
      {
        key: "attention_mask"
        value: "attention_mask"
      },
      {
        key: "position_ids"
        value: "position_ids"
      },
      {
        key: "token_type_ids"
        value: "token_type_ids"
      },
      {
        key: "text_token_mask"
        value: "text_token_mask"
      },
      {
        key: "pos_map"
        value: "pos_map"
      },
      {
        key: "target_sizes"
        value: "target_sizes"
      }
      ]
    },
    {
      model_name: "mgdino_trt"
      model_version: -1
      input_map [
      {
	key: "inputs"
	value: "inputs"
      },
      {
        key: "input_ids"
        value: "input_ids"
      },
      {
        key: "attention_mask"
        value: "attention_mask"
      },
      {
        key: "position_ids"
        value: "position_ids"
      },
      {
        key: "token_type_ids"
        value: "token_type_ids"
      },
      {
        key: "text_token_mask"
        value: "text_token_mask"
      }
    ]
    output_map [
      {
        key: "pred_logits"
        value: "pred_logits"
      },
      {
        key: "pred_boxes"
        value: "pred_boxes"
      },
      {
        key: "pred_masks"
        value: "pred_masks"
      }
    ]
    }
    ,
    {
     model_name: "mgdino_postprocess"
      model_version: -1
      input_map [
      {
        key: "pred_logits"
        value: "pred_logits"
      },
      {
        key: "pred_boxes"
        value: "pred_boxes"
      }
      ,
      {
        key: "pos_map"
        value: "pos_map"
      },
      {
        key: "target_sizes"
        value: "target_sizes"
      },
      {
        key: "pred_masks"
        value: "pred_masks"
      }
      ]
      output_map [
      {
        key: "labels"
        value: "labels"
      },
      {
        key: "boxes"
        value: "boxes"
      }
      ,
      {
        key: "scores"
        value: "scores"
      },
      {
        key: "masks"
        value: "masks"
      }
      ]
    }
  ]
}
