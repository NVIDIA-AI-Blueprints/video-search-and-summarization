# ─────────────────────────────────────────────────────────────────────────────
# RT-CV-3D (MV3DT) standalone deployment — configuration.
# Read by docker compose and by the scripts/ helpers.
# ─────────────────────────────────────────────────────────────────────────────

# Models directory: the extracted vss-warehouse-app-data package's models/ dir,
# containing mtmc/ (RT-DETR onnx + engines) and mv3dt/BodyPose3DNet/.
# See README "1. Place models and assets" for the NGC download.
MODELS_DIR=/path/to/vss-warehouse-app-data/models

# Number of streaming cameras.
NUM_CAMS=4

# Input source: stream (register RTSP streams via scripts/add-streams.sh) or
# file (perception reads local .mp4 files directly, no registration). For file
# mode set VIDEO_DIR to a host dir holding one <sensor_id>.mp4 per camera
# (names must match the calibration sensor ids); clips play once, then the app
# exits. See README "Input from local video files".
INPUT_MODE=stream
VIDEO_DIR=/path/to/videos

# Save the perception app's annotated camera view to video (headless-friendly;
# no display needed). 1 = write video-output/grid-view.mkv — the whole camera
# grid tiled into one file, with 3D boxes and class/ID labels burned in.
# Requires INPUT_MODE=file (the video finalizes only at end-of-stream, which live
# streams never reach). See README "Save perception video" (incl. the NVENC-less
# GPU note).
SAVE_VIDEO=0

# GPU device index for the perception container.
GPU_DEVICE=0

# Perception REST API port (dynamic stream add/remove).
DS_HTTP_PORT=9000

# MQTT broker for the MV3DT cross-camera /trck/* topics.
# Using the bundled broker: keep localhost and add COMPOSE_PROFILES+=mosquitto.
# Using your own broker: point these at it and omit the profile.
MQTT_HOST=localhost
MQTT_PORT=1883

# Kafka broker for the metadata topics (perception → mdx-raw → bev-fusion → mdx-bev).
# Using the bundled broker: keep localhost:9092 and add COMPOSE_PROFILES+=kafka.
# Using your own broker: point KAFKA_BOOTSTRAP at it and omit the profile.
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_PORT=9092
KAFKA_CONTROLLER_PORT=9093
RAW_TOPIC=mdx-raw
FUSED_TOPIC=mdx-bev

# Optional bundled services: set COMPOSE_PROFILES to enable them, e.g.
#   COMPOSE_PROFILES=mosquitto,kafka docker compose up -d
# (Leave unset here so users with their own brokers get none by default.)
#COMPOSE_PROFILES=mosquitto,kafka

# ─── Container images — bump the tag here when a version updates ─────────────

# Perception (RT-DETR + MV3DT)
PERCEPTION_IMAGE="nvcr.io/nvstaging/vss-core/vss-rt-cv"
# For multi-arch: 3.3.0
PERCEPTION_TAG="3.3.0-26.07.2"
# For DGX-SPARK (SBSA): 3.3.0-sbsa. Uncomment below and comment above
# PERCEPTION_TAG="3.3.0-sbsa-26.07.2"

# BEV measurement fusion (source: ../rt-cv-bev-fusion)
BEV_FUSION_IMAGE="nvcr.io/nvstaging/vss-core/vss-rt-cv-mv3dt-bev-fusion"
BEV_FUSION_TAG="3.3.0-26.08.1"

# Optional brokers
MOSQUITTO_IMAGE=eclipse-mosquitto:2
KAFKA_IMAGE=confluentinc/cp-kafka:8.2.0
