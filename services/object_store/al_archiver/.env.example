# Kafka (Message Bus)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=aoi-inference-results
KAFKA_GROUP_ID=al-archiver

# Backend (Object Store-ELK BE)
BE_BASE_URL=http://backend-api:8000
BE_INFERENCE_RESULT_PATH=/api/inference-results

# Forwarding
FORWARD_TIMEOUT_S=30.0
MAX_RETRIES=5
RETRY_BASE_DELAY_S=1.0
RETRY_MAX_DELAY_S=30.0
RETRY_JITTER=true

LOG_LEVEL=INFO
