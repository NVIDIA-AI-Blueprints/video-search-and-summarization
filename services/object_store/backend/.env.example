AWS_ENDPOINT=http://localhost:8333
# Host external clients use to download presigned URLs; default = AWS_ENDPOINT.
# In real deploys set to the reachable IP/domain (e.g. http://10.57.234.46:8333
# or a TLS reverse proxy) — do NOT hardcode an IP in code.
AWS_PUBLIC_ENDPOINT=http://localhost:8333
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
# Use the bucket that matches the use case: aoi-samples for AOI, or its-samples for ITS.
AWS_BUCKET=aoi-samples
# AWS_BUCKET=its-samples

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=aoi-metadata

# Workflow 2 — outbound trigger to AOI Client
INFERENCE_ENABLED=false
AOI_CLIENT_BASE_URL=http://localhost:8010
AOI_CLIENT_TIMEOUT_S=10
AOI_CLIENT_MAX_RETRIES=3
DEV_USE_SAMPLE_AS_GOLDEN_REF=false

# Workflow 2 — inbound inference results + ES upsert (AsyncElasticsearch)
ES_URL=http://localhost:9200
ES_INDEX=aoi_*
SC_ES_INDEX=sc_*
ELASTICSEARCH_INDEX_PATTERN=aoi_*

# Presigned object-store download URLs (POST /v1/get_presigned_urls)
PRESIGN_EXPIRES_S=3600
MAX_PRESIGN_URLS_PER_REQUEST=50

# Track 11 — Obj Store / Eval set (POST /v1/results, GET /v1/eval/<eval_id>)
EVAL_SLICES_TOPIC=eval-slices
EVAL_RESULTS_TOPIC=eval-results
EVAL_PARTITIONS=3
EVAL_PAGE_SIZE=1000
EVAL_PREFIX=evals
EVAL_SLICES_GROUP=eval-slices-consumer
EVAL_SUMMARY_GROUP=eval-summary-consumer

# Smart City / ITS frame compression and retention (see README)
SC_FRAME_COMPRESSION=off
SC_FRAME_JPEG_QUALITY=85
SC_GC_ENABLED=false
SC_GC_DRY_RUN=false
SC_GC_INTERVAL_S=3600
SC_GC_RETENTION_DAYS=14
SC_GC_REQUIRE_SNAPSHOT=true
SC_GC_HOLD_S=172800
SC_GC_PRUNE_SNAPSHOTS=true
SC_GC_BATCH_SIZE=500
SC_GC_ORPHAN_SWEEP=false
SC_GC_ORPHAN_GRACE_S=86400
SEAWEEDFS_MASTER_URL=http://localhost:9333
SC_FRAME_TAGGING=true
SC_LIFECYCLE_ENABLED=false
