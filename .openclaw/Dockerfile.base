#
# OpenClaw base image — NemoClaw's managed OpenClaw runtime with nothing VSS
# added, for evaluating an agent that a user extends: no VSS plugin, no skills,
# no vss or NGC CLI, an empty workspace AGENTS.md, and only the exec, process,
# read, write, edit and apply_patch built-in tools.
# tags: [nemoclaw, openclaw, base]
#
# Tools are switched off by name, never allowlisted (base-config.py), so skills
# and plugins a user installs later reach the agent:
#   - skills: copy a skill directory into /sandbox/.openclaw/skills/<name>/ (or
#     the workspace's skills/); OpenClaw lists it in the prompt.
#   - plugins: `openclaw plugins install …`; plugin tools are not denied.
#
# The sandbox contract matches ./Dockerfile (Harbor trial paths and config
# overlay, onboard's model args, no per-shell ulimit hooks, the nvm shim, sleep
# infinity, USER sandbox, WORKDIR /sandbox). Keep BASE_IMAGE in lockstep with
# ./Dockerfile's.
#
#   docker build -f .openclaw/Dockerfile.base -t <registry>/vss-harness-openclaw:<tag>-base .openclaw

ARG BASE_IMAGE=ghcr.io/nvidia/nemoclaw/openclaw-sandbox@sha256:959d1255717b54f724248eb282dbb049d3cd785d5aa4eddb0da2a03839ad6fca
ARG BUILDER_IMAGE=node:24.18.1-trixie-slim@sha256:ac39e4b5fcb2b1b34b20364fd58b2e898f3bb80731ee6f62a7536f9df3d6aadc

# The session values `onboard --from` rewrites; why they are declared here and
# read in a separate stage is explained in ./Dockerfile.
ARG NEMOCLAW_PRIMARY_MODEL_REF=
ARG NEMOCLAW_MODEL=
ARG NEMOCLAW_CONTEXT_WINDOW=
ARG NEMOCLAW_MAX_TOKENS=
ARG CHAT_UI_URL=

# ── onboard's session values, out of the base image's ENV shadow ──────────────
FROM ${BUILDER_IMAGE} AS onboard-args
ARG NEMOCLAW_PRIMARY_MODEL_REF
ARG NEMOCLAW_MODEL
ARG NEMOCLAW_CONTEXT_WINDOW
ARG NEMOCLAW_MAX_TOKENS
ARG CHAT_UI_URL
RUN mkdir -p /onboard \
    && printf '%s' "$NEMOCLAW_PRIMARY_MODEL_REF" > /onboard/NEMOCLAW_PRIMARY_MODEL_REF \
    && printf '%s' "$NEMOCLAW_MODEL" > /onboard/NEMOCLAW_MODEL \
    && printf '%s' "$NEMOCLAW_CONTEXT_WINDOW" > /onboard/NEMOCLAW_CONTEXT_WINDOW \
    && printf '%s' "$NEMOCLAW_MAX_TOKENS" > /onboard/NEMOCLAW_MAX_TOKENS \
    && printf '%s' "$CHAT_UI_URL" > /onboard/CHAT_UI_URL

# ── Managed runtime, stripped to the base ──────────────────────────────────────
FROM ${BASE_IMAGE}
USER root
COPY --from=onboard-args /onboard/ /etc/vss-onboard-args/
COPY apply-onboard-config.py /usr/local/bin/vss-apply-onboard-config
COPY base-config.py /usr/local/lib/vss-harness/base-config.py
# In one layer:
#  - Harbor trial paths, real world-writable directories (see ./Dockerfile).
#  - No skills: OpenClaw's bundled skills and the ones its bundled plugins ship.
#  - onboard's model args, then the tool policy and Harbor overlay
#    (base-config.py), then the config hash nemoclaw-start verifies.
#  - Instruction docs: one empty workspace AGENTS.md. A non-empty workspace also
#    stops nemoclaw-start seeding its templates; NEMOCLAW_MINIMAL_BOOTSTRAP
#    below is the second guard.
#  - NemoClaw's per-shell `ulimit -u 512` hooks removed (see ./Dockerfile).
RUN set -eux; \
    for d in task output logs tests solution; do mkdir -p "/$d" && chmod 777 "/$d"; done; \
    openclaw_root=/usr/local/lib/nemoclaw/openclaw-runtime/node_modules/openclaw; \
    find "$openclaw_root/skills" -mindepth 1 -delete; \
    find "$openclaw_root/dist/extensions" -mindepth 2 -maxdepth 2 -type d -name skills -exec rm -rf {} +; \
    test -z "$(find "$openclaw_root/skills" "$openclaw_root/dist/extensions" -name SKILL.md)"; \
    chmod 755 /usr/local/bin/vss-apply-onboard-config; \
    NEMOCLAW_PRIMARY_MODEL_REF="$(cat /etc/vss-onboard-args/NEMOCLAW_PRIMARY_MODEL_REF)" \
    NEMOCLAW_MODEL="$(cat /etc/vss-onboard-args/NEMOCLAW_MODEL)" \
    NEMOCLAW_CONTEXT_WINDOW="$(cat /etc/vss-onboard-args/NEMOCLAW_CONTEXT_WINDOW)" \
    NEMOCLAW_MAX_TOKENS="$(cat /etc/vss-onboard-args/NEMOCLAW_MAX_TOKENS)" \
    CHAT_UI_URL="$(cat /etc/vss-onboard-args/CHAT_UI_URL)" \
      python3 /usr/local/bin/vss-apply-onboard-config; \
    python3 /usr/local/lib/vss-harness/base-config.py; \
    chmod 644 /etc/openclaw-harness/config-overlay.json; \
    su -s /bin/sh sandbox -c 'cd /sandbox && HOME=/sandbox openclaw config validate'; \
    chown sandbox:sandbox /sandbox/.openclaw/openclaw.json; \
    chmod 660 /sandbox/.openclaw/openclaw.json; \
    sha256sum /sandbox/.openclaw/openclaw.json > /sandbox/.openclaw/.config-hash; \
    chown sandbox:sandbox /sandbox/.openclaw/.config-hash; \
    chmod 660 /sandbox/.openclaw/.config-hash; \
    workspace=/sandbox/.openclaw/workspace; \
    mkdir -p "$workspace"; \
    : > "$workspace/AGENTS.md"; \
    chown -R sandbox:sandbox "$workspace"; \
    test "$(ls -A "$workspace")" = AGENTS.md; \
    rm -f /etc/profile.d/nemoclaw-rlimits.sh; \
    sed -i '/sandbox-rlimits/d; /NemoClaw sandbox resource limits/d' /etc/bash.bashrc; \
    ! grep -rq "sandbox-rlimits" /etc/profile.d /etc/bash.bashrc

# nemoclaw-start seeds OpenClaw's template docs into an empty workspace unless
# this is 1. OpenShell mounts /proc read-only; 0 disables OpenClaw's optional
# child OOM-score write (see ./Dockerfile).
ENV NEMOCLAW_MINIMAL_BOOTSTRAP=1 \
    OPENCLAW_CHILD_OOM_SCORE_ADJ=0

# Harbor's openclaw adapter bootstraps node with nvm (see ./Dockerfile).
COPY --chown=sandbox:sandbox nvm-shim.sh /sandbox/.nvm/nvm.sh

USER sandbox
WORKDIR /sandbox
CMD ["sleep", "infinity"]

LABEL harness.base="nemoclaw-openclaw-sandbox" \
      harness.contract="harbor-trial-v1" \
      harness.agent="openclaw" \
      harness.variant="base" \
      harness.vss-cli="false" \
      harness.vss-plugin="false" \
      harness.workspace-root="/sandbox"
