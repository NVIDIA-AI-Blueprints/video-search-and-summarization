{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NVIDIA-AI-Blueprints/video-search-and-summarization/skills/vss-introspect-video/final-result.schema.json",
  "title": "VSS Introspection Final Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "answer",
    "evidence",
    "evidence_details",
    "unresolved_gaps",
    "revision",
    "artifact_dir"
  ],
  "properties": {
    "status": {"enum": ["answered", "unresolved"]},
    "answer": {"type": ["string", "null"]},
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^obs-[a-f0-9]{24}$"
      },
      "uniqueItems": true
    },
    "evidence_details": {
      "type": "array",
      "items": {"$ref": "evidence-ledger.schema.json#/$defs/observation"}
    },
    "unresolved_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "gap", "reason"],
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^claim-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "gap": {"type": "string", "minLength": 1},
          "reason": {
            "enum": [
              "insufficient_coverage",
              "not_visible",
              "tool_failure",
              "budget_exhausted"
            ]
          }
        }
      }
    },
    "revision": {"type": "integer", "minimum": 0},
    "artifact_dir": {"type": "string", "minLength": 1}
  },
  "oneOf": [
    {
      "properties": {
        "status": {"const": "answered"},
        "answer": {"type": "string", "minLength": 1},
        "unresolved_gaps": {"maxItems": 0}
      }
    },
    {
      "properties": {
        "status": {"const": "unresolved"},
        "answer": {"type": "null"},
        "evidence": {"maxItems": 0},
        "evidence_details": {"maxItems": 0}
      }
    }
  ]
}
