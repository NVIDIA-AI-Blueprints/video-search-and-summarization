{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NVIDIA-AI-Blueprints/video-search-and-summarization/skills/vss-introspect-video/inspection-task.schema.json",
  "title": "VSS Introspection Inspection Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "base_revision",
    "claim",
    "gap",
    "existing_observations",
    "asset_id",
    "media_scope",
    "max_vlm_calls"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^inspect-claim-[a-z0-9]+(?:-[a-z0-9]+)*-r[1-9][0-9]*$"
    },
    "base_revision": {"type": "integer", "minimum": 0},
    "claim": {"$ref": "evidence-ledger.schema.json#/$defs/planClaim"},
    "gap": {"type": ["string", "null"]},
    "existing_observations": {
      "type": "array",
      "items": {"$ref": "evidence-ledger.schema.json#/$defs/observation"}
    },
    "asset_id": {"type": ["string", "null"]},
    "media_scope": {
      "oneOf": [
        {"$ref": "#/$defs/sensorScope"},
        {"$ref": "#/$defs/mediaUrlScope"},
        {"$ref": "#/$defs/fileScope"}
      ]
    },
    "max_vlm_calls": {"type": "integer", "minimum": 1}
  },
  "$defs": {
    "sensorScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sensor_id", "start", "end"],
      "properties": {
        "type": {"const": "sensor"},
        "sensor_id": {"type": "string", "minLength": 1},
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"}
      }
    },
    "mediaUrlScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "media_url"],
      "properties": {
        "type": {"const": "media_url"},
        "media_url": {"type": "string", "format": "uri", "minLength": 1}
      }
    },
    "fileScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path"],
      "properties": {
        "type": {"const": "file"},
        "path": {"type": "string", "minLength": 1}
      }
    }
  }
}
