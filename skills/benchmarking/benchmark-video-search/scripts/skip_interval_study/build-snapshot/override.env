# Delta build on the search Foundation: no harness (Q3 = no), driven by the
# host-side vss CLI. Removes the in-stack agent with its LLM NIM and phoenix.
FOUNDATION=search
BUILD_DIR=/localhome/local-romalakar/abhishek1/video-search-and-summarization/_builds/search-20261014

COMPOSE_PROFILES=kibana-init-container-search,vss-search-analytics-2d-fusion,vss-video-analytics-api,nvstreamer-2d-fusion,perception-2d-fusion,elasticsearch,elasticsearch-init-container,kafka,kafka-topic-init-container,redis,kibana,logstash,broker-health-check,vss-haproxy-ingress,rtvi-embed,vss-ui,centralizedb,vst-ingress,sensor-ms,streamprocessing-ms,rtvi-vlm

# Host paths
VSS_APPS_DIR=/localhome/local-romalakar/abhishek1/video-search-and-summarization/deploy/docker
VSS_DATA_DIR=/localhome/local-romalakar/abhishek1/vss-apps-data-20261014
VST_CONFIG_PATH=/localhome/local-romalakar/abhishek1/video-search-and-summarization/deploy/docker/services/vios/configs
# RT-VLM tagging disabled on stream add (rtvi-vlm-tagging-camera-streaming).
VST_NOTIFICATION_CONFIG_PATH=/localhome/local-romalakar/abhishek1/video-search-and-summarization/_builds/search-20261014/patches/notification_config.json

# Addressing (plain LAN host)
HOST_IP=10.86.12.161
EXTERNAL_IP=10.86.12.161
VSS_PUBLIC_HOST=10.86.12.161
VST_EXTERNAL_URL=http://10.86.12.161:7777
VST_BASE_URL=http://10.86.12.161:7777
VSS_AGENT_REPORTS_BASE_URL=http://10.86.12.161:7777/static/
VSS_AGENT_EXTERNAL_URL=http://10.86.12.161:7777
MEDIA_SERVICE_ENDPOINT=10.86.12.161
REACT_APP_API_ENDPOINT_BASE_URL=10.86.12.161:8081

# GPU placement: GPUs 0-4 and 7 are held by other workloads on this host.
RT_CV_DEVICE_ID=5
RT_VLM_DEVICE_ID=5
VLM_DEVICE_ID=5
RT_EMBED_DEVICE_ID=6
FIXED_SHARED_DEVICE_IDS='5'

# No agent: retire the Web UI surfaces that address it.
NEXT_PUBLIC_ENABLE_CHAT_SIDEBAR=false
NEXT_PUBLIC_ENABLE_CHAT_TAB=false
NEXT_PUBLIC_ENABLE_SEARCH_TAB=false
NEXT_PUBLIC_SIDEBAR_CHAT_CHAT_UPLOAD_FILE_ENABLE=false
